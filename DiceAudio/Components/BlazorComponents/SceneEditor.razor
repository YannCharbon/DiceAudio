@using Plugin.Maui.Audio
@inject DiceAudioService DAService
@inject IAudioManager AudioManager
@implements IDisposable

<style>
    .se-section {
        background: #1a1a30;
        border: 1px solid #2a2a4a;
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 14px;
    }
    .se-layer-card, .se-step-card {
        background: #12121f;
        border: 1px solid #2a2a4a;
        border-radius: 8px;
        padding: 10px 12px;
        margin: 8px 0;
    }
    .se-layer-live { border-color: rgba(35,166,213,0.9); }
    .se-cmd-row {
        display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
        background: #191928; border-radius: 6px; padding: 6px 8px; margin: 4px 0;
    }
    .se-role-badge {
        font-size: 11px; border-radius: 4px; padding: 1px 7px; color: black; font-weight: bold;
    }

    /* Connector drawn between two step cards, carrying the advance trigger. */
    .se-step-link {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: -2px 0 -2px 26px;
        padding: 6px 0 6px 20px;
        border-left: 2px dashed #363660;
    }
    .se-step-link-auto { border-left-color: #23a6d5; }
    .se-step-link-label {
        display: flex; align-items: center; gap: 6px;
        font-size: 12px; color: #7a7a9a; white-space: nowrap;
    }
    .se-step-link-auto .se-step-link-label { color: #23a6d5; }
</style>

@if (_visible && Scene != null)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.82); z-index:4800; overflow-y:auto;"
     @onclick="CloseAsync">
    <div style="background:#232338; margin:2% auto; max-width:1050px; border-radius:12px;
                padding:22px 26px; position:relative;"
         @onclick:stopPropagation="true">

        <div class="da-irow da-irow-wrap" style="gap:14px; margin-bottom:14px;">
            <DaIcon Name="movie" Size="20" Class="da-i-accent" />
            <label class="da-field" style="max-width:280px;">
                <span class="da-flabel">Scene name</span>
                <input class="da-inp" type="text" spellcheck="false" @bind="Scene.Name" />
            </label>
            <label class="da-field" style="max-width:180px;">
                <span class="da-flabel">Category</span>
                <input class="da-inp" type="text" spellcheck="false" placeholder="e.g. Town, Combat"
                       @bind="Scene.Category" />
            </label>
            <label class="da-field" style="max-width:200px;">
                <span class="da-flabel">Mode</span>
                <select class="da-inp" value="@Scene.Mode" @onchange="SetSceneMode">
                    <option value="@DASceneMode.Linear">Linear (steps)</option>
                    <option value="@DASceneMode.Contextual">Contextual (states)</option>
                </select>
            </label>

            @* ── Live preview transport ── *@
            <div style="display:flex; align-items:center; gap:6px; margin-left:auto;">
                @if (_preview?.IsPlaying == true)
                {
                    <div class="da-cmd-btn" @onclick="() => _preview!.AdvanceAsync()"
                         title="@(Scene.Mode == DASceneMode.Contextual ? "Next context" : "Advance to next step")">
                        <DaIcon Name="skip-next" Size="20" Class="da-skip" />
                    </div>
                    <div class="da-cmd-btn" @onclick="StopPreviewAsync" title="Stop preview">
                        <DaIcon Name="stop" Size="20" Class="da-stop" />
                    </div>
                    @* The light blue of the live caption is the info token. *@
                    <span style="font-size:12px; color:var(--a2);">
                        @(_preview.CurrentCueName ?? "")
                        @(Scene.Mode == DASceneMode.Linear
                            ? (_preview.NextStep != null ? $" → next: {_preview.NextStep.Name}" : " (last step)")
                            : "")
                    </span>
                }
                else
                {
                    <div class="da-cmd-btn" @onclick="StartPreviewAsync" title="Preview the scene">
                        <DaIcon Name="play" Size="22" Class="da-play" />
                    </div>
                    <span class="da-meta">Preview</span>
                }
            </div>
        </div>

        @* ═══ Layers ═══ *@
        <div class="se-section">
            <div class="da-irow" style="gap:10px; margin-bottom:4px;">
                <h5 style="margin:0;">Layers</h5>
                <span class="da-meta">
                    The sound sources of the scene — ambiences, music, sound effects
                </span>
            </div>

            @foreach (var layer in Scene.Layers)
            {
                var l = layer;
                var audioItem = DAService.AudioItems.FirstOrDefault(a => a.Id == l.Audio.AudioItemId);
                bool live = _preview?.IsLayerAudible(l.Id) == true;

                <div class="se-layer-card @(live ? "se-layer-live" : "")">
                    <div class="da-irow da-irow-wrap" style="gap:10px;">
                        <span class="se-role-badge" style="background:@RoleColor(l.Role);">@RoleLabel(l.Role)</span>

                        <label class="da-field" style="max-width:180px;">
                            <span class="da-flabel">Layer name</span>
                            <input class="da-inp" type="text" spellcheck="false" @bind="l.Name" />
                        </label>

                        <label class="da-field" style="max-width:150px;">
                            <span class="da-flabel">Role</span>
                            <select class="da-inp" value="@l.Role"
                                    @onchange="@(e => OnLayerRoleSelected(l, e))">
                                <option value="@DALayerRole.Ambience">Ambience</option>
                                <option value="@DALayerRole.Music">Music</option>
                                <option value="@DALayerRole.SoundEffect">Sound effect</option>
                            </select>
                        </label>

                        @* A layer with no file yet keeps the warning tint the
                           Color.Warning button carried. *@
                        <button type="button" class="da-btn da-btn-out"
                                style="@($"flex:1; min-width:220px; text-transform:none; justify-content:flex-start;{(audioItem == null ? " color:var(--warn); border-color:var(--warn);" : "")}")"
                                @onclick="() => OpenAudioPicker(l)">
                            <DaIcon Name="@(audioItem != null ? KindIconName(audioItem.Kind) : "library-music")" Size="16" />
                            @(audioItem?.Name ?? "Pick audio file…")
                        </button>

                        <button type="button" class="da-btn da-btn-out"
                                style="min-height:32px; padding:0 12px; font-size:12.5px;"
                                disabled="@(audioItem == null)"
                                @onclick="() => OpenLayerSettings(l, audioItem)">
                            <DaIcon Name="tune" Size="15" />
                            Settings@(l.Audio.IsClipped ? " ✂" : "")
                        </button>

                        <button type="button" class="da-ib da-danger" title="Delete layer"
                                aria-label="Delete layer" @onclick="() => DeleteLayer(l)">
                            <DaIcon Name="delete" Size="16" />
                        </button>
                    </div>

                    @if (l.Role == DALayerRole.SoundEffect)
                    {
                        <div class="da-irow da-irow-wrap" style="gap:10px; margin-top:8px;">
                            <span class="da-meta">Random scheduling:</span>
                            <div class="da-field">
                                <span class="da-flabel">Min wait (s)</span>
                                <div class="da-step">
                                    <button type="button" @onclick="@(() => l.RandomMinSeconds = Math.Max(0, l.RandomMinSeconds - 1))">&minus;</button>
                                    <input type="number" class="da-num" min="0" step="1" value="@l.RandomMinSeconds"
                                           @onchange="@(e => l.RandomMinSeconds = Math.Max(0, ParseDouble(e.Value, l.RandomMinSeconds)))" />
                                    <button type="button" @onclick="@(() => l.RandomMinSeconds = Math.Max(0, l.RandomMinSeconds + 1))">+</button>
                                </div>
                            </div>
                            <div class="da-field">
                                <span class="da-flabel">Max wait (s)</span>
                                <div class="da-step">
                                    <button type="button" @onclick="@(() => l.RandomMaxSeconds = Math.Max(0, l.RandomMaxSeconds - 1))">&minus;</button>
                                    <input type="number" class="da-num" min="0" step="1" value="@l.RandomMaxSeconds"
                                           @onchange="@(e => l.RandomMaxSeconds = Math.Max(0, ParseDouble(e.Value, l.RandomMaxSeconds)))" />
                                    <button type="button" @onclick="@(() => l.RandomMaxSeconds = Math.Max(0, l.RandomMaxSeconds + 1))">+</button>
                                </div>
                            </div>
                            <label class="da-chk">
                                <input type="checkbox" @bind="l.FireImmediatelyOnStart" />
                                Fire immediately
                            </label>
                            <label class="da-chk">
                                <input type="checkbox" @bind="l.RandomRepeat" />
                                Repeat
                            </label>
                        </div>
                    }
                </div>
            }

            <button type="button" class="da-btn da-btn-out" style="margin-top:6px;" @onclick="AddLayer">
                <DaIcon Name="add" Size="16" />
                Add layer
            </button>
        </div>

        @* ═══ Steps (linear mode) ═══ *@
        @if (Scene.Mode == DASceneMode.Linear)
        {
        <div class="se-section">
            <div class="da-irow" style="gap:10px; margin-bottom:4px;">
                <h5 style="margin:0;">Steps</h5>
                <span class="da-meta">
                    Step 1 runs when the scene starts; each next step is triggered by pressing "advance",
                    or automatically after a fixed duration or when a layer this step started
                    without looping reaches its end
                </span>
            </div>

            @for (int si = 0; si < Scene.Steps.Count; si++)
            {
                var step = Scene.Steps[si];
                var stepIndex = si;
                bool isCurrent = _preview?.IsPlaying == true && _preview.CurrentStepIndex == stepIndex;

                <div class="se-step-card" style="@(isCurrent ? "border-color:rgba(35,166,213,0.9);" : "")">
                    <div class="da-irow da-irow-wrap" style="gap:10px;">
                        @* The step the preview is on keeps the info blue it had. *@
                        <span class="da-tag" style="@(isCurrent ? "color:var(--a2); border-color:var(--a2);" : null)">
                            Step @(stepIndex + 1)
                        </span>
                        <label class="da-field" style="max-width:260px;">
                            <span class="da-flabel">Step name</span>
                            <input class="da-inp" type="text" spellcheck="false" @bind="step.Name" />
                        </label>
                        <div style="margin-left:auto; display:flex; gap:2px;">
                            <button type="button" class="da-ib" title="Move up" aria-label="Move up"
                                    disabled="@(stepIndex == 0)" @onclick="() => MoveStep(step, -1)">
                                <DaIcon Name="circle-up" Size="16" />
                            </button>
                            <button type="button" class="da-ib" title="Move down" aria-label="Move down"
                                    disabled="@(stepIndex == Scene.Steps.Count - 1)" @onclick="() => MoveStep(step, +1)">
                                <DaIcon Name="circle-down" Size="16" />
                            </button>
                            <button type="button" class="da-ib da-danger" title="Delete step"
                                    aria-label="Delete step" @onclick="() => Scene.Steps.Remove(step)">
                                <DaIcon Name="delete" Size="16" />
                            </button>
                        </div>
                    </div>

                    @foreach (var command in step.Commands)
                    {
                        var c = command;
                        <div class="se-cmd-row">
                            <label class="da-field" style="max-width:170px;">
                                <span class="da-flabel">Action</span>
                                <select class="da-inp" value="@c.Type"
                                        @onchange="@(e => OnCommandTypeSelected(step, c, e))">
                                    <option value="@DACommandType.FadeInLayer">Fade in</option>
                                    <option value="@DACommandType.StartLayer">Start (instant)</option>
                                    <option value="@DACommandType.FadeOutLayer">Fade out</option>
                                    <option value="@DACommandType.StopLayer">Stop (instant)</option>
                                    <option value="@DACommandType.SetVolume">Set volume</option>
                                    <option value="@DACommandType.StartRandom">Start random SFX</option>
                                    <option value="@DACommandType.StopRandom">Stop random SFX</option>
                                </select>
                            </label>

                            @* Stops can target everything at once, so one command can
                               clear the scene instead of one per layer. *@
                            <label class="da-field" style="max-width:190px;">
                                <span class="da-flabel">Layer</span>
                                <select class="da-inp" value="@LayerSelectionKey(c)"
                                        @onchange="@(e => SetCommandLayerSelection(step, c, e.Value?.ToString() ?? string.Empty))">
                                    @if (c.Type is DACommandType.StopLayer or DACommandType.FadeOutLayer)
                                    {
                                        <option value="@AllLayersKey">All layers</option>
                                    }
                                    @foreach (var layer in Scene.Layers)
                                    {
                                        <option value="@layer.Id">@layer.Name</option>
                                    }
                                </select>
                            </label>

                            @* Only a layer that is being started can be told whether to loop.
                               Unlooped, it reaches an end the step can advance on. *@
                            @if (c.Type is DACommandType.FadeInLayer or DACommandType.StartLayer)
                            {
                                <label class="da-chk"
                                       title="Unchecked: the layer plays once and can trigger the next step when it ends">
                                    <input type="checkbox" checked="@EffectiveLoop(c)"
                                           @onchange="@(e => SetCommandLoop(step, c, e.Value is bool on && on))" />
                                    Loop
                                </label>
                            }

                            <div class="da-field">
                                <span class="da-flabel">Delay (s)</span>
                                <div class="da-step">
                                    <button type="button" @onclick="@(() => c.DelaySeconds = Math.Max(0, c.DelaySeconds - 1))">&minus;</button>
                                    <input type="number" class="da-num" min="0" step="1" value="@c.DelaySeconds"
                                           @onchange="@(e => c.DelaySeconds = Math.Max(0, ParseDouble(e.Value, c.DelaySeconds)))" />
                                    <button type="button" @onclick="@(() => c.DelaySeconds = Math.Max(0, c.DelaySeconds + 1))">+</button>
                                </div>
                            </div>

                            @if (c.Type is DACommandType.FadeInLayer or DACommandType.FadeOutLayer or DACommandType.SetVolume)
                            {
                                <div class="da-field">
                                    <span class="da-flabel">Fade (s)</span>
                                    <div class="da-step">
                                        <button type="button" @onclick="@(() => c.DurationSeconds = Math.Max(0, c.DurationSeconds - 1))">&minus;</button>
                                        <input type="number" class="da-num" min="0" step="1" value="@c.DurationSeconds"
                                               @onchange="@(e => c.DurationSeconds = Math.Max(0, ParseDouble(e.Value, c.DurationSeconds)))" />
                                        <button type="button" @onclick="@(() => c.DurationSeconds = Math.Max(0, c.DurationSeconds + 1))">+</button>
                                    </div>
                                </div>
                            }
                            @if (c.Type is DACommandType.SetVolume or DACommandType.FadeInLayer or DACommandType.StartLayer)
                            {
                                <div style="display:flex; flex-direction:column; min-width:140px; max-width:170px;">
                                    <span class="da-meta" style="line-height:1;">
                                        @(c.Type == DACommandType.SetVolume ? "Target volume" : "Volume") : @c.TargetVolume.ToString("P0")
                                    </span>
                                    @* --pp paints the filled part of the track, which
                                       MudSlider drew for itself. *@
                                    <input type="range" class="da-range" aria-label="Volume"
                                           style="@($"margin:0; --pp:{Percent(c.TargetVolume)};")"
                                           min="0" max="1" step="0.01" value="@Inv(c.TargetVolume)"
                                           @oninput="@(e => c.TargetVolume = Math.Clamp(ParseDouble(e.Value, c.TargetVolume), 0, 1))" />
                                </div>
                            }

                            <button type="button" class="da-ib" title="Remove command"
                                    aria-label="Remove command" @onclick="() => RemoveCommand(step, c)">
                                <DaIcon Name="close" Size="16" />
                            </button>
                        </div>
                    }

                    <button type="button" class="da-btn da-btn-text"
                            style="min-height:32px; padding:0 12px; font-size:12.5px;"
                            @onclick="() => AddCommand(step)">
                        <DaIcon Name="add" Size="15" />
                        Add action
                    </button>
                </div>

                @* ── What moves the scene from this step to the next one ── *@
                @if (stepIndex < Scene.Steps.Count - 1)
                {
                    var candidates = AutoAdvanceCandidates(step).ToList();
                    bool isAuto = step.AdvanceMode != DAStepAdvance.Manual;
                    <div class="se-step-link @(isAuto ? "se-step-link-auto" : "")">
                        <div class="se-step-link-label">
                            <DaIcon Size="16" Name="@(step.AdvanceMode switch
                                                      {
                                                          DAStepAdvance.Manual => "touch-app",
                                                          DAStepAdvance.AfterDuration => "timer",
                                                          _ => "play-circle",
                                                      })" />
                            Advance to step @(stepIndex + 2)
                        </div>

                        @* The native select is drawn by the OS, so the popover
                           se-step-link-popover had to lift over the modal is gone. *@
                        <select class="da-inp" style="min-width:280px; max-width:360px;"
                                value="@AdvanceTriggerKey(step)"
                                @onchange="@(e => SetAdvanceTrigger(step, e.Value?.ToString() ?? string.Empty))">
                            <option value="@AdvanceManualKey">Manual trigger</option>
                            <option value="@AdvanceDurationKey">After a fixed duration</option>
                            @foreach (var candidate in candidates)
                            {
                                <option value="@candidate.Id">
                                    When “@candidate.Name” reaches its end
                                </option>
                            }
                            @* Waiting on every layer only says something new beyond one
                               layer when the step starts more than one — but keep the
                               option visible if the step is already set to it. *@
                            @if (candidates.Count > 1 || step.AdvanceMode == DAStepAdvance.OnAllLayersEnd)
                            {
                                <option value="@AdvanceAllKey">
                                    When all @candidates.Count layers reach their end (the longest one)
                                </option>
                            }
                        </select>

                        @if (step.AdvanceMode == DAStepAdvance.AfterDuration)
                        {
                            <div class="da-field">
                                <span class="da-flabel">Seconds</span>
                                <div class="da-step">
                                    <button type="button" @onclick="@(() => step.AdvanceAfterSeconds = Math.Max(0, step.AdvanceAfterSeconds - 1))">&minus;</button>
                                    <input type="number" class="da-num" min="0" step="1" value="@step.AdvanceAfterSeconds"
                                           @onchange="@(e => step.AdvanceAfterSeconds = Math.Max(0, ParseDouble(e.Value, step.AdvanceAfterSeconds)))" />
                                    <button type="button" @onclick="@(() => step.AdvanceAfterSeconds = Math.Max(0, step.AdvanceAfterSeconds + 1))">+</button>
                                </div>
                            </div>
                            <span style="font-size:12px; color:var(--t4);">
                                counted from this step's start
                            </span>
                        }
                        else if (candidates.Count == 0)
                        {
                            <span style="font-size:12px; color:var(--t4);">
                                uncheck “Loop” on a layer this step starts to offer it here
                            </span>
                        }
                    </div>
                }
            }

            <button type="button" class="da-btn da-btn-out" style="margin-top:6px;" @onclick="AddStep">
                <DaIcon Name="add" Size="16" />
                Add step
            </button>
        </div>
        }

        @* ═══ Contexts (contextual mode) ═══ *@
        @if (Scene.Mode == DASceneMode.Contextual)
        {
        <div class="se-section">
            <div class="da-irow" style="gap:10px; margin-bottom:4px;">
                <h5 style="margin:0;">Contexts</h5>
                <span class="da-meta">
                    The selectable states of the scene (e.g. fireplace / crowded / brawl) —
                    switching crossfades every layer to its level in the target context
                </span>
            </div>

            @for (int ci = 0; ci < Scene.Contexts.Count; ci++)
            {
                var context = Scene.Contexts[ci];
                var contextIndex = ci;
                bool isCurrent = _preview?.IsPlaying == true && _preview.CurrentContext?.Id == context.Id;

                <div class="se-step-card" style="@(isCurrent ? "border-color:rgba(35,166,213,0.9);" : "")">
                    <div class="da-irow da-irow-wrap" style="gap:10px;">
                        <div class="da-cmd-btn" style="width:34px; height:34px;"
                             title="Enter this context (starts the preview if needed)"
                             @onclick="() => EnterPreviewContext(context)">
                            <DaIcon Name="@(isCurrent ? "graphic-eq" : "play")" Size="17"
                                    Class="@(isCurrent ? "da-skip" : "da-play")" />
                        </div>
                        <label class="da-field" style="max-width:230px;">
                            <span class="da-flabel">Context name</span>
                            <input class="da-inp" type="text" spellcheck="false" @bind="context.Name" />
                        </label>
                        <div class="da-field">
                            <span class="da-flabel">Transition (s)</span>
                            <div class="da-step">
                                <button type="button" @onclick="@(() => context.TransitionSeconds = Math.Max(0, context.TransitionSeconds - 1))">&minus;</button>
                                <input type="number" class="da-num" min="0" step="1" value="@context.TransitionSeconds"
                                       @onchange="@(e => context.TransitionSeconds = Math.Max(0, ParseDouble(e.Value, context.TransitionSeconds)))" />
                                <button type="button" @onclick="@(() => context.TransitionSeconds = Math.Max(0, context.TransitionSeconds + 1))">+</button>
                            </div>
                        </div>
                        <div style="margin-left:auto; display:flex; gap:2px;">
                            <button type="button" class="da-ib" title="Move up" aria-label="Move up"
                                    disabled="@(contextIndex == 0)" @onclick="() => MoveContext(context, -1)">
                                <DaIcon Name="circle-up" Size="16" />
                            </button>
                            <button type="button" class="da-ib" title="Move down" aria-label="Move down"
                                    disabled="@(contextIndex == Scene.Contexts.Count - 1)" @onclick="() => MoveContext(context, +1)">
                                <DaIcon Name="circle-down" Size="16" />
                            </button>
                            <button type="button" class="da-ib da-danger" title="Delete context"
                                    aria-label="Delete context" @onclick="() => Scene.Contexts.Remove(context)">
                                <DaIcon Name="delete" Size="16" />
                            </button>
                        </div>
                    </div>

                    @foreach (var layer in Scene.Layers)
                    {
                        var l = layer;
                        var state = GetOrCreateState(context, l);
                        <div class="se-cmd-row">
                            <span class="se-role-badge" style="background:@RoleColor(l.Role);">@RoleLabel(l.Role)</span>
                            <span style="min-width:130px; font-size:13px;">@l.Name</span>
                            <label class="da-chk">
                                <input type="checkbox" checked="@state.Active"
                                       @onchange="@(e => state.Active = e.Value is bool on && on)" />
                                @(l.Role == DALayerRole.SoundEffect ? "Random SFX on" : "Playing")
                            </label>
                            @if (state.Active)
                            {
                                <div style="display:flex; flex-direction:column; min-width:150px; max-width:190px;">
                                    <span class="da-meta" style="line-height:1;">
                                        Volume: @state.Volume.ToString("P0")
                                    </span>
                                    <input type="range" class="da-range" aria-label="Volume"
                                           style="@($"margin:0; --pp:{Percent(state.Volume)};")"
                                           min="0" max="1" step="0.01" value="@Inv(state.Volume)"
                                           @oninput="@(e => SetContextLayerVolume(context, l, state, ParseDouble(e.Value, state.Volume)))" />
                                </div>
                            }
                        </div>
                    }
                    @if (Scene.Layers.Count == 0)
                    {
                        <span class="da-meta">Add layers first — contexts define each layer's level.</span>
                    }
                </div>
            }

            <button type="button" class="da-btn da-btn-out" style="margin-top:6px;" @onclick="AddContext">
                <DaIcon Name="add" Size="16" />
                Add context
            </button>
        </div>
        }

        @* ── Footer ── *@
        <div style="display:flex; align-items:center; gap:8px; margin-top:8px; flex-wrap:wrap;">
            <label class="da-field" style="max-width:180px;">
                <span class="da-flabel">Preset category</span>
                <input class="da-inp" type="text" spellcheck="false" placeholder="e.g. Town, Combat"
                       @bind="_presetCategory" />
            </label>
            <button type="button" class="da-btn da-btn-out" @onclick="SaveAsPreset">
                <DaIcon Name="bookmark-add" Size="16" />
                Save as preset
            </button>
            @if (_presetSaved)
            {
                @* The confirmation green has no token; the secondary teal is the
                   nearest one the app owns. *@
                <span style="font-size:12px; color:var(--a3);">Saved to catalogue ✓</span>
            }
            <div style="flex:1;"></div>
            <button type="button" class="da-btn da-btn-fill" @onclick="CloseAsync">
                <DaIcon Name="check" Size="16" />
                OK
            </button>
        </div>
    </div>
</div>
}

<AudioClipEditor @ref="_clipEditor" ShowSceneSettings="true" OnClosed="StateHasChanged" />
<AudioPicker @ref="_audioPicker" Title="Pick layer audio" SingleSelect="true"
             OnPicked="OnLayerAudioPicked" OnClosed="StateHasChanged" />

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    public DAScene? Scene { get; private set; }

    private bool _visible;
    private AudioClipEditor? _clipEditor;
    private DAScenePlayer? _preview;

    private string _presetCategory = "";
    private bool _presetSaved;

    public void Show(DAScene scene)
    {
        Scene = scene;
        _visible = true;
        _presetSaved = false;
        StateHasChanged();
    }

    async Task SaveAsPreset()
    {
        if (Scene == null) return;
        DAService.Presets.Add(DAPreset.FromScene(Scene, _presetCategory.Trim()));
        await DAService.SavePresetsAsync();
        _presetSaved = true;
        StateHasChanged();
    }

    async Task CloseAsync()
    {
        await StopPreviewAsync();
        _preview?.Dispose();
        _preview = null;
        _visible = false;
        StateHasChanged();
        await OnClose.InvokeAsync();
    }

    // ── Layers ──────────────────────────────────────────────────────────────

    void AddLayer()
    {
        Scene?.Layers.Add(new DASceneLayer
        {
            Name = $"Layer {Scene.Layers.Count + 1}",
            Audio = new DAAudioUsage { Loop = true },   // ambience default
        });
    }

    void SetLayerRole(DASceneLayer layer, DALayerRole role)
    {
        layer.Role = role;
        // Sensible loop default per role (user can override in Settings).
        layer.Audio.Loop = role != DALayerRole.SoundEffect;
    }

    void DeleteLayer(DASceneLayer layer)
    {
        if (Scene == null) return;
        Scene.Layers.Remove(layer);
        foreach (var step in Scene.Steps)
            step.Commands.RemoveAll(c => c.LayerId == layer.Id);
        foreach (var context in Scene.Contexts)
            context.LayerStates.RemoveAll(s => s.LayerId == layer.Id);
    }

    void OpenLayerSettings(DASceneLayer layer, DAAudioItem? item)
    {
        if (item != null)
            _clipEditor?.Show(layer.Audio, item);
    }

    private AudioPicker? _audioPicker;
    private DASceneLayer? _pickingLayer;

    void OpenAudioPicker(DASceneLayer layer)
    {
        _pickingLayer = layer;
        // Pre-filter to the kind matching the layer role; the user can widen it in the picker.
        var kinds = layer.Role switch
        {
            DALayerRole.Ambience => new[] { AudioKind.Ambiance },
            DALayerRole.Music => new[] { AudioKind.Music },
            _ => new[] { AudioKind.SoundEffect },
        };
        _audioPicker?.Show(kinds);
    }

    void OnLayerAudioPicked(DAAudioItem item)
    {
        if (_pickingLayer == null) return;
        _pickingLayer.Audio.AudioItemId = item.Id;
        // A freshly assigned file has no meaningful clip bounds from a previous file.
        _pickingLayer.Audio.ClipStartSeconds = null;
        _pickingLayer.Audio.ClipEndSeconds = null;
        if (_pickingLayer.Name.StartsWith("Layer ")) _pickingLayer.Name = item.Name;
        _pickingLayer = null;
        StateHasChanged();
    }

    static string RoleLabel(DALayerRole role) => role switch
    {
        DALayerRole.Ambience => "AMB",
        DALayerRole.Music => "MUS",
        _ => "SFX",
    };

    /// The badge fill per role, as tokens: these were #23a6d5, #e73c7e and
    /// #f0a03c, which are exactly the info, primary and warning tokens.
    static string RoleColor(DALayerRole role) => role switch
    {
        DALayerRole.Ambience => "var(--a2)",
        DALayerRole.Music => "var(--a1)",
        _ => "var(--warn)",
    };

    /// The DaIcon name for an audio kind. Local to this editor rather than on
    /// AudioKindExtensions, whose Icon() still hands out a Material glyph name
    /// that other callers rely on.
    static string KindIconName(AudioKind kind) => kind switch
    {
        AudioKind.Music => "music-note",
        AudioKind.Ambiance => "forest",
        _ => "volume-up",
    };

    /// Reads a number or range box back, keeping the current value when the box
    /// is empty or mid-edit. Invariant culture: both always report a '.' decimal,
    /// whatever the system separator is.
    static double ParseDouble(object? value, double fallback) =>
        double.TryParse(value?.ToString(),
                        System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture,
                        out double parsed)
            ? parsed
            : fallback;

    /// A 0..1 level as a CSS percentage, which is how --pp fills a range track.
    /// A double as the HTML a range input will actually accept. Razor renders
    /// a double in the CURRENT culture, so on a French locale value="0,37" is
    /// rejected and the thumb snaps elsewhere - while --pp, written invariantly,
    /// stays put. That disagreement is what made the thumb jitter and the fill
    /// stop matching it.
    static string Inv(double value) =>
        value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    static string Percent(double value) =>
        (Math.Clamp(value, 0, 1) * 100)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    void SetSceneMode(ChangeEventArgs e)
    {
        if (Scene != null && Enum.TryParse<DASceneMode>(e.Value?.ToString(), out var mode))
            Scene.Mode = mode;
    }

    void OnLayerRoleSelected(DASceneLayer layer, ChangeEventArgs e)
    {
        if (Enum.TryParse<DALayerRole>(e.Value?.ToString(), out var role))
            SetLayerRole(layer, role);
    }

    void OnCommandTypeSelected(DASceneStep step, DASceneCommand command, ChangeEventArgs e)
    {
        if (Enum.TryParse<DACommandType>(e.Value?.ToString(), out var type))
            SetCommandType(step, command, type);
    }

    // ── Steps ───────────────────────────────────────────────────────────────

    void AddStep()
    {
        Scene?.Steps.Add(new DASceneStep
        {
            Name = Scene.Steps.Count == 0 ? "Scene start" : $"Step {Scene.Steps.Count + 1}",
        });
    }

    void MoveStep(DASceneStep step, int direction)
    {
        if (Scene == null) return;
        int idx = Scene.Steps.IndexOf(step);
        int target = idx + direction;
        if (idx < 0 || target < 0 || target >= Scene.Steps.Count) return;
        Scene.Steps.RemoveAt(idx);
        Scene.Steps.Insert(target, step);
    }

    void AddCommand(DASceneStep step)
    {
        var firstLayer = Scene?.Layers.FirstOrDefault();
        step.Commands.Add(new DASceneCommand
        {
            LayerId = firstLayer?.Id ?? Guid.Empty,
            // Sensible starting point: the layer's own configured volume.
            TargetVolume = firstLayer?.Audio.Volume ?? 1.0,
        });
    }

    void RemoveCommand(DASceneStep step, DASceneCommand command)
    {
        step.Commands.Remove(command);
        ReconcileAdvanceTrigger(step);
    }

    void SetCommandType(DASceneStep step, DASceneCommand command, DACommandType type)
    {
        bool wasStop = IsStopCommand(command.Type);
        command.Type = type;

        // Stopping everything is the common case, so it is the default a stop
        // arrives with; anything else can only target one layer.
        if (IsStopCommand(type))
        {
            if (!wasStop) command.AllLayers = true;
        }
        else
        {
            command.AllLayers = false;
        }

        ReconcileAdvanceTrigger(step);
    }

    static bool IsStopCommand(DACommandType type) =>
        type is DACommandType.StopLayer or DACommandType.FadeOutLayer;

    // The layer dropdown carries either a layer id or the "everything" choice.
    const string AllLayersKey = "all-layers";

    string LayerSelectionKey(DASceneCommand command) =>
        command.AllLayers && IsStopCommand(command.Type)
            ? AllLayersKey
            : command.LayerId.ToString();

    void SetCommandLayerSelection(DASceneStep step, DASceneCommand command, string key)
    {
        if (key == AllLayersKey)
        {
            command.AllLayers = true;
        }
        else if (Guid.TryParse(key, out var layerId))
        {
            command.AllLayers = false;
            command.LayerId = layerId;
        }
        ReconcileAdvanceTrigger(step);
    }

    void SetCommandLoop(DASceneStep step, DASceneCommand command, bool loop)
    {
        command.Loop = loop;
        ReconcileAdvanceTrigger(step);
    }

    /// <summary>
    /// Whether the layer this command starts will loop: the command's own choice,
    /// falling back to how the layer's audio is configured.
    /// </summary>
    bool EffectiveLoop(DASceneCommand command)
    {
        if (command.Loop is bool loop) return loop;
        var layer = Scene?.Layers.FirstOrDefault(l => l.Id == command.LayerId);
        return layer?.Audio.Loop ?? true;
    }

    /// <summary>
    /// Layers this step starts without looping — the only ones that ever reach an
    /// end, and therefore the only ones the next step can be triggered by.
    /// </summary>
    IEnumerable<DASceneLayer> AutoAdvanceCandidates(DASceneStep step)
    {
        if (Scene == null) yield break;

        var seen = new HashSet<Guid>();
        foreach (var command in step.Commands)
        {
            if (command.Type is not (DACommandType.StartLayer or DACommandType.FadeInLayer)) continue;
            if (EffectiveLoop(command)) continue;
            if (!seen.Add(command.LayerId)) continue;

            var layer = Scene.Layers.FirstOrDefault(l => l.Id == command.LayerId);
            if (layer != null) yield return layer;
        }
    }

    // The trigger dropdown carries three kinds of choice, so its values are keys:
    // "manual", "all", or a layer id.
    const string AdvanceManualKey = "manual";
    const string AdvanceDurationKey = "duration";
    const string AdvanceAllKey = "all";

    string AdvanceTriggerKey(DASceneStep step) => step.AdvanceMode switch
    {
        DAStepAdvance.AfterDuration => AdvanceDurationKey,
        DAStepAdvance.OnAllLayersEnd when AutoAdvanceCandidates(step).Any() => AdvanceAllKey,
        DAStepAdvance.OnLayerEnd when ResolvedAdvanceLayer(step) is Guid id => id.ToString(),
        _ => AdvanceManualKey,
    };

    void SetAdvanceTrigger(DASceneStep step, string key)
    {
        if (key == AdvanceDurationKey)
        {
            step.AdvanceMode = DAStepAdvance.AfterDuration;
            step.AdvanceOnLayerEndId = null;
        }
        else if (key == AdvanceAllKey)
        {
            step.AdvanceMode = DAStepAdvance.OnAllLayersEnd;
            step.AdvanceOnLayerEndId = null;
        }
        else if (Guid.TryParse(key, out var layerId))
        {
            step.AdvanceMode = DAStepAdvance.OnLayerEnd;
            step.AdvanceOnLayerEndId = layerId;
        }
        else
        {
            step.AdvanceMode = DAStepAdvance.Manual;
            step.AdvanceOnLayerEndId = null;
        }
    }

    /// <summary>The step's chosen layer, or null when it no longer names a valid one.</summary>
    Guid? ResolvedAdvanceLayer(DASceneStep step) =>
        step.AdvanceOnLayerEndId is Guid id && AutoAdvanceCandidates(step).Any(l => l.Id == id)
            ? id
            : null;

    /// <summary>
    /// Drops a trigger that editing has made impossible — the layer now loops, its
    /// command changed type or target, or it was removed — so the step falls back to
    /// manual instead of silently never advancing.
    /// </summary>
    void ReconcileAdvanceTrigger(DASceneStep step)
    {
        switch (step.AdvanceMode)
        {
            case DAStepAdvance.OnLayerEnd when ResolvedAdvanceLayer(step) == null:
            case DAStepAdvance.OnAllLayersEnd when !AutoAdvanceCandidates(step).Any():
                step.AdvanceMode = DAStepAdvance.Manual;
                step.AdvanceOnLayerEndId = null;
                break;
        }
    }

    // ── Contexts ────────────────────────────────────────────────────────────

    DAContextLayerState GetOrCreateState(DASceneContext context, DASceneLayer layer)
    {
        var state = context.LayerStates.FirstOrDefault(s => s.LayerId == layer.Id);
        if (state == null)
        {
            state = new DAContextLayerState
            {
                LayerId = layer.Id,
                Active = false,
                Volume = layer.Audio.Volume,
            };
            context.LayerStates.Add(state);
        }
        return state;
    }

    void AddContext()
    {
        if (Scene == null) return;
        var context = new DASceneContext { Name = $"Context {Scene.Contexts.Count + 1}" };

        // Start from the previous context's state — new contexts are usually variants.
        var previous = Scene.Contexts.LastOrDefault();
        foreach (var layer in Scene.Layers)
        {
            var previousState = previous?.LayerStates.FirstOrDefault(s => s.LayerId == layer.Id);
            context.LayerStates.Add(new DAContextLayerState
            {
                LayerId = layer.Id,
                Active = previousState?.Active ?? (layer.Role != DALayerRole.SoundEffect),
                Volume = previousState?.Volume ?? layer.Audio.Volume,
            });
        }
        Scene.Contexts.Add(context);
    }

    void SetContextLayerVolume(DASceneContext context, DASceneLayer layer, DAContextLayerState state, double volume)
    {
        state.Volume = Math.Clamp(volume, 0, 1);
        // Live feedback: when this context is the one currently previewing,
        // push the new level straight to the playing layer.
        if (_preview?.IsPlaying == true && _preview.CurrentContext?.Id == context.Id)
            _preview.SetLayerVolumeLive(layer, state.Volume);
    }

    void MoveContext(DASceneContext context, int direction)
    {
        if (Scene == null) return;
        int index = Scene.Contexts.IndexOf(context);
        int target = index + direction;
        if (index < 0 || target < 0 || target >= Scene.Contexts.Count) return;
        Scene.Contexts.RemoveAt(index);
        Scene.Contexts.Insert(target, context);
    }

    async Task EnterPreviewContext(DASceneContext context)
    {
        if (Scene == null) return;
        if (_preview == null)
        {
            _preview = new DAScenePlayer(AudioManager, DAService, Scene);
            _preview.StateChanged += OnPreviewStateChanged;
        }
        await _preview.EnterContextAsync(context);
    }

    // ── Preview ─────────────────────────────────────────────────────────────

    async Task StartPreviewAsync()
    {
        if (Scene == null) return;
        if (_preview == null)
        {
            _preview = new DAScenePlayer(AudioManager, DAService, Scene);
            _preview.StateChanged += OnPreviewStateChanged;
        }
        await _preview.StartAsync();
    }

    async Task StopPreviewAsync()
    {
        if (_preview != null)
            await _preview.StopAsync();
    }

    void OnPreviewStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_preview != null)
        {
            _preview.StateChanged -= OnPreviewStateChanged;
            _preview.Dispose();
            _preview = null;
        }
    }
}
