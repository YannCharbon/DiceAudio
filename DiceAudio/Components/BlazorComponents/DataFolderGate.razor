@*
    Shown instead of the app when the data folder cannot be used at startup
    (spec §3.4, §7.2), as in DiceCombats: missing (a drive or a share that is
    not there) or not usable. Nothing has been read; nothing is ever created
    in a missing folder.
*@

@using DiceAudio.Storage
@using DiceAudio.Resources.Localization
@inject DataFolderService DataFolder

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px 16px; color:var(--t1);">
    <div class="da-panel" style="width:min(640px,100%);">
        <h2 style="font-size:22px; margin:0 0 10px; color:var(--t1);">
            @(Location.State == DataLocationState.Missing ? Portability.StartupMissingTitle : Portability.StartupInvalidTitle)
        </h2>
        <p class="da-meta" style="font-size:14px; line-height:1.55;">
            @(Location.State == DataLocationState.Missing
                ? string.Format(Portability.StartupMissingText, Location.Root)
                : string.Format(Portability.StartupInvalidText, Location.Root))
        </p>

        @if (_chosenProblem != null)
        {
            <p class="da-msec" style="margin:10px 0; border-left:3px solid var(--warn);">@_chosenProblem</p>
        }

        <div style="display:flex; flex-direction:column; gap:12px; margin-top:14px;">
            <div>
                <button type="button" class="da-btn da-btn-fill" disabled="@_busy" @onclick="TryAgain">
                    <DaIcon Name="sync" /> @Portability.StartupTryAgainBtn
                </button>
                <div class="da-meta" style="margin-top:4px;">@Portability.StartupTryAgainHelp</div>
            </div>
            @if (DAImportHelper.CanPickFolder)
            {
                <div>
                    <button type="button" class="da-btn da-btn-out" disabled="@_busy" @onclick="ChooseFolder">
                        <DaIcon Name="folder-open" /> @Portability.StartupChooseFolderBtn
                    </button>
                    <div class="da-meta" style="margin-top:4px;">@Portability.StartupChooseFolderHelp</div>
                </div>
            }
            @* Under DICE_DATA_DIR the default folder is the override itself: when
               that is the missing one, the option would only bring this screen back. *@
            @if (!(Location.IsDebugOverride && Location.IsDefault))
            {
                <div>
                    <button type="button" class="da-btn da-btn-out" disabled="@_busy" @onclick="UseLocal">
                        <DaIcon Name="save" /> @Portability.StartupUseLocalBtn
                    </button>
                    <div class="da-meta" style="margin-top:4px;">@Portability.StartupUseLocalHelp</div>
                </div>
            }
            <div>
                <button type="button" class="da-btn da-btn-out" @onclick="Quit">
                    <DaIcon Name="close" /> @Portability.StartupQuitBtn
                </button>
                <div class="da-meta" style="margin-top:4px;">@Portability.StartupQuitHelp</div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _busy;
    private string? _chosenProblem;

    private DataLocation Location => DataFolder.Location;

    private async Task TryAgain()
    {
        _chosenProblem = null;
        if (Location.Evaluate() == DataLocationState.Ok)
        {
            await LoadAsync();
        }
    }

    // The folder where the data is now: one that holds DiceAudio data.
    // Anything else is refused here; a new folder is chosen from Settings.
    private async Task ChooseFolder()
    {
        _chosenProblem = null;
        string? folder = await DAImportHelper.PickFolderAsync();
        if (folder == null) return;

        DataFolderMarker? marker = null;
        try { marker = DataFolderMarker.Read(folder); }
        catch (InvalidDataException) { }
        if (marker == null || marker.App != Location.AppName || marker.Version > DataFolderMarker.CurrentVersion)
        {
            _chosenProblem = string.Format(Portability.StartupInvalidText, folder);
            return;
        }

        Location.SetPointer(DataFolder.IsDefault(folder) ? null : folder);
        if (Location.UsePointerNow() == DataLocationState.Ok)
        {
            await LoadAsync();
        }
        else
        {
            _chosenProblem = string.Format(Portability.StartupInvalidText, folder);
        }
    }

    private async Task UseLocal()
    {
        _chosenProblem = null;
        Location.UseDefaultForThisSession();
        if (Location.State == DataLocationState.Ok)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            await DataFolder.LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Quit()
    {
        Application.Current?.Quit();
    }
}
