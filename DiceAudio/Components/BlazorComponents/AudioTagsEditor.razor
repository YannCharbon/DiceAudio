@* ── The three fixed tag categories, each a row of its own tags plus a field
     to add one. A tag chip here is a delete button: clicking it drops the tag
     from its category, which is why it carries the bin. ── *@

<div>
	<h4 class="modal-title">Tags editor&nbsp;</h4>
</div>
<div style="height: 600px;">
	<div style="padding:5px;">
		<h4>Add/Remove tags</h4>
		<div style="padding:5px;">
			<p>Type</p>
			<div class="da-irow da-irow-wrap">
				@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryTypes)
				{
					<button type="button" class="da-tog" title="Delete tag from this category"
							@onclick="() => DAAudioTagsProvider.Instance.CategoryTypes.Remove(tagName)">
						@tagName.ToString()<DaIcon Name="delete" Size="13" />
					</button>
				}
			</div>
			<div class="da-irow da-irow-wrap" style="padding-top:10px;">
				<div class="da-field" style="max-width:260px;">
					<span class="da-flabel">Enter new tag name</span>
					<input class="da-inp" type="text" @bind="newCategoryTypeTagName" />
				</div>
				<button type="button" class="da-btn da-btn-fill"
						@onclick="() => AddNewTag(DAAudioTag.TagCategory.Type, newCategoryTypeTagName)">
					<DaIcon Name="add" Size="18" />Add new tag
				</button>
			</div>
		</div>
		<div style="padding:5px;">
			<p>Location</p>
			<div class="da-irow da-irow-wrap">
				@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryLocations)
				{
					<button type="button" class="da-tog" title="Delete tag from this category"
							@onclick="() => DAAudioTagsProvider.Instance.CategoryLocations.Remove(tagName)">
						@tagName.ToString()<DaIcon Name="delete" Size="13" />
					</button>
				}
			</div>
			<div class="da-irow da-irow-wrap" style="padding-top:10px;">
				<div class="da-field" style="max-width:260px;">
					<span class="da-flabel">Enter new tag name</span>
					<input class="da-inp" type="text" @bind="newCategoryLocationTagName" />
				</div>
				<button type="button" class="da-btn da-btn-fill"
						@onclick="() => AddNewTag(DAAudioTag.TagCategory.Location, newCategoryLocationTagName)">
					<DaIcon Name="add" Size="18" />Add new tag
				</button>
			</div>
		</div>
		<div style="padding:5px;">
			<p>Expression</p>
			<div class="da-irow da-irow-wrap">
				@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryExpressions)
				{
					<button type="button" class="da-tog" title="Delete tag from this category"
							@onclick="() => DAAudioTagsProvider.Instance.CategoryExpressions.Remove(tagName)">
						@tagName.ToString()<DaIcon Name="delete" Size="13" />
					</button>
				}
			</div>
			<div class="da-irow da-irow-wrap" style="padding-top:10px;">
				<div class="da-field" style="max-width:260px;">
					<span class="da-flabel">Enter new tag name</span>
					<input class="da-inp" type="text" @bind="newCategoryExpressionTagName" />
				</div>
				<button type="button" class="da-btn da-btn-fill"
						@onclick="() => AddNewTag(DAAudioTag.TagCategory.Expression, newCategoryExpressionTagName)">
					<DaIcon Name="add" Size="18" />Add new tag
				</button>
			</div>
		</div>
	</div>
</div>

@code {

	private string newCategoryTypeTagName = "";
	private string newCategoryLocationTagName = "";
	private string newCategoryExpressionTagName = "";

	void AddNewTag(DAAudioTag.TagCategory tagCategory, string newTagName)
	{
		if (tagCategory == DAAudioTag.TagCategory.Type)
		{
			if (!DAAudioTagsProvider.Instance.CategoryTypes.Contains(newCategoryTypeTagName))
			{
				DAAudioTagsProvider.Instance.CategoryTypes.Add(newCategoryTypeTagName);
				newCategoryTypeTagName = "";
			}
		}
		else if (tagCategory == DAAudioTag.TagCategory.Location)
		{
			if (!DAAudioTagsProvider.Instance.CategoryLocations.Contains(newCategoryLocationTagName))
			{
				DAAudioTagsProvider.Instance.CategoryLocations.Add(newCategoryLocationTagName);
				newCategoryLocationTagName = "";
			}
		}
		else if (tagCategory == DAAudioTag.TagCategory.Expression)
		{
			if (!DAAudioTagsProvider.Instance.CategoryExpressions.Contains(newCategoryExpressionTagName))
			{
				DAAudioTagsProvider.Instance.CategoryExpressions.Add(newCategoryExpressionTagName);
				newCategoryExpressionTagName = "";
			}
		}
	}
}
