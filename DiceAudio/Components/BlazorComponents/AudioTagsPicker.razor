@* ── The tags carried by one item, and the three categories to pick from.
     The read-out at the top uses the same category-tinted chip as the cards in
     the explorer, so a tag looks the same wherever it is seen; the pickers
     below are toggles, lit when the item carries that tag. ── *@

@if (AudioItem != null)
{
	<div class="da-irow">
		<div><h4>Tags picker&nbsp;</h4></div>
		<div>
			<button type="button" class="da-btn da-btn-out" @onclick="() => AudioItem.Tags.Clear()">
				<DaIcon Name="delete" Size="18" />Remove all tags
			</button>
		</div>
	</div>
	<div style="height: 500px;">
		<div style="padding:5px;">
		</div>
		<div sstyle="padding:5px;">
			<h4>Audio tags</h4>
			@foreach (DAAudioTag tag in AudioItem.Tags)
			{
				<span class="da-chip @tag.CategoryClass()"><span class="da-dot"></span>@tag.Name</span>
			}
		</div>
		<div style="padding:5px;">
			<h4>Add/Remove tags</h4>
			<div style="padding:5px;">
				<p>Type</p>
				<div class="da-irow da-irow-wrap">
					@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryTypes)
					{
						@if (AudioItem.Tags.Contains(new DAAudioTag(tagName)))
						{
							<button type="button" class="da-tog da-on" @onclick="() => AudioItem.Tags.Remove(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
						else
						{
							<button type="button" class="da-tog" @onclick="() => AudioItem.Tags.Add(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
					}
				</div>
			</div>
			<div style="padding:5px;">
				<p>Location</p>
				<div class="da-irow da-irow-wrap">
					@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryLocations)
					{
						@if (AudioItem.Tags.Contains(new DAAudioTag(tagName)))
						{
							<button type="button" class="da-tog da-on" @onclick="() => AudioItem.Tags.Remove(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
						else
						{
							<button type="button" class="da-tog" @onclick="() => AudioItem.Tags.Add(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
					}
				</div>
			</div>
			<div style="padding:5px;">
				<p>Expression</p>
				<div class="da-irow da-irow-wrap">
					@foreach (string tagName in DAAudioTagsProvider.Instance.CategoryExpressions)
					{
						@if (AudioItem.Tags.Contains(new DAAudioTag(tagName)))
						{
							<button type="button" class="da-tog da-on" @onclick="() => AudioItem.Tags.Remove(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
						else
						{
							<button type="button" class="da-tog" @onclick="() => AudioItem.Tags.Add(new DAAudioTag(tagName))">@tagName.ToString()</button>
						}
					}
				</div>
			</div>
		</div>
	</div>
} else
{
	<p>No AudioItem provided.</p>
}


@code {
	[Parameter] public DAAudioItem? AudioItem { get; set; } = default!;
}
