@using Plugin.Maui.Audio
@inject IAudioManager AudioManager

<div class="row">
    <div class="col col-md-2">
        @if (IsPlaying)
        {
            <span class="oi oi-media-pause command-button command-button-pause" @onclick="pauseAudio"></span>
        }
        else
        {
            <span class="oi oi-media-play command-button command-button-play" @onclick="playAudio"></span>
        }
    </div>
    <div class="col col-sm-2">
        <span class="oi oi-media-stop command-button command-button-stop" @onclick="stopAudio"></span>
    </div>
</div>

<div>
    Duration: @TimeSpan.FromSeconds(_duration).ToString("hh\\:mm\\:ss")
</div>

<MudSlider @bind-Value="@playbackTimeSeconds" Min="0" Max="(int)_duration" @onchange="ProgressionChangedByUser" />

@code {
    [Parameter] public DAAudioItem AudioItem { get; set; } = default!;

    private IAudioPlayer? _audioPlayer;
    private bool IsPlaying = false;
    private double _duration = 0;

    private System.Timers.Timer tickerTimer1 = new System.Timers.Timer(1000);
    private int playbackTimeSeconds = 0;

    protected override void OnInitialized()
    {
        tickerTimer1.Elapsed += async (sender, args) =>
        {
            if (_audioPlayer != null && _audioPlayer.IsPlaying)
            {
                playbackTimeSeconds = (int)_audioPlayer.CurrentPosition;
                await InvokeAsync(StateHasChanged);
            }
        };
    }

    void playAudio()
    {
        stopAudio();

        var filePath = Path.Combine(FileSystem.AppDataDirectory, "Audio", AudioItem.LocalFileName);
        var tmpFilePath = Path.Combine(FileSystem.CacheDirectory, AudioItem.Name);
        File.Copy(filePath, tmpFilePath, true);

        var fileStream = File.OpenRead(tmpFilePath);
        _audioPlayer = AudioManager.CreatePlayer(fileStream);
        _audioPlayer.Volume = 1.0;
        _duration = _audioPlayer.Duration;

        _audioPlayer.Play();
        tickerTimer1.Start();
        IsPlaying = true;
    }

    void pauseAudio()
    {
        _audioPlayer?.Pause();
        tickerTimer1.Stop();
        IsPlaying = false;
    }

    void stopAudio()
    {
        _audioPlayer?.Stop();
        tickerTimer1.Stop();
        IsPlaying = false;
        playbackTimeSeconds = 0;
        StateHasChanged();
    }

    void ProgressionChangedByUser(object val)
    {
        if (_audioPlayer != null)
        {
            _audioPlayer.Seek(playbackTimeSeconds);
        }
    }

    public void Dispose()
    {
        stopAudio();
        _audioPlayer?.Dispose();
    }
}
