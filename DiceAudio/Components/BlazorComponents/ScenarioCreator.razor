@inject DAPlaybackCoordinator Coordinator
@inject DABundleExportService Exports
@implements IDisposable

<style>
    .sc-outer {
        display: flex;
        flex-direction: row;
        border-radius: 12px;
        background: #10101e;
        border: 1px solid #2a2a4a;
        margin: 12px 0;
        overflow: hidden;
        min-height: 240px;
        max-width: 100%;
    }
    .sc-left {
        width: 200px;
        flex-shrink: 0;
        background: #1a1a30;
        padding: 14px 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        border-right: 1px solid #2a2a4a;
    }
    .sc-name-field {
        width: 100%;
    }
    .sc-scroll {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding: 10px 6px;
        flex: 1;
        min-width: 0;   /* let this flex item shrink so it scrolls instead of growing */
        align-items: flex-start;
    }
    /* Uses shared da-cmd-btn-lg from app.css */
    .sc-move-row { display: flex; gap: 6px; }

    /* Drag-and-drop reordering of item cards */
    .sc-items-row {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
    }
    .si-drag-item {
        position: relative;
        flex-shrink: 0;
    }
    .si-drag-handle {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: rgba(0,0,0,0.45);
        color: #fff;
        cursor: grab;
        opacity: 0.55;
        transition: opacity 0.15s;
    }
    .si-drag-handle:hover { opacity: 1; }
    .si-drag-handle:active { cursor: grabbing; }
    /* Placeholder shown at the drop target while dragging (SortableJS default class) */
    .sortable-ghost { opacity: 0.4; }
</style>

<div class="sc-outer">
    @* ─── Left control panel ─── *@
    <div class="sc-left">
        @* Scenario name *@
        <div class="sc-name-field">
            @* onchange, not oninput: MudTextField only reported the new name when
               the box was left, and every report queues a save of the group. *@
            <label class="da-field">
                <span class="da-flabel">Scenario</span>
                <input class="da-inp" type="text" spellcheck="false"
                       value="@Scenario.Name"
                       @onchange="@(e => OnNameChanged(e.Value?.ToString() ?? string.Empty))" />
            </label>
        </div>

        @* Move + delete *@
        <div class="sc-move-row">
            <button type="button" class="da-ib" title="Move up" aria-label="Move up"
                    @onclick="() => MoveScenario?.Invoke(Scenario, true)">
                <DaIcon Name="circle-up" Size="20" />
            </button>
            <button type="button" class="da-ib" title="Move down" aria-label="Move down"
                    @onclick="() => MoveScenario?.Invoke(Scenario, false)">
                <DaIcon Name="circle-down" Size="20" />
            </button>
            @if (Group != null)
            {
                <button type="button" class="da-ib"
                        title="@DiceAudio.Resources.Localization.Portability.ExportScenarioBtn"
                        aria-label="@DiceAudio.Resources.Localization.Portability.ExportScenarioBtn"
                        @onclick="() => Exports.ExportScenario(Group, Scenario)">
                    <DaIcon Name="upload" Size="20" />
                </button>
            }
            <button type="button" class="da-ib da-danger" title="Delete" aria-label="Delete"
                    @onclick="() => DeleteScenario?.Invoke(Scenario)">
                <DaIcon Name="delete" Size="20" />
            </button>
        </div>

        @* Big transport buttons *@
        @if (_player != null)
        {
            <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center;">
                @if (_player.IsPlaying)
                {
                    <div class="da-cmd-btn-lg" @onclick="() => _player.Pause()" title="Pause">
                        <DaIcon Name="pause" Size="28" Class="da-pause-lg" />
                    </div>
                }
                else
                {
                    <div class="da-cmd-btn-lg" @onclick="() => _player.PlayAsync()" title="Play">
                        <DaIcon Name="play" Size="28" Class="da-play-lg" />
                    </div>
                }
                <div class="da-cmd-btn-lg" @onclick="() => _player.StopAsync()" title="Stop">
                    <DaIcon Name="stop" Size="26" Class="da-stop-lg" />
                </div>
                <div class="da-cmd-btn-lg" @onclick="() => _player.PlayNextAsync()" title="Skip to next item">
                    <DaIcon Name="skip-next" Size="26" Class="da-skip-lg" />
                </div>
            </div>
        }
    </div>

    @* ─── Horizontally scrollable item cards ─── *@
    <div class="sc-scroll">
        @if (_player != null)
        {
            <SortableList T="DAScenarioItem"
                          Items="Scenario.Items"
                          Id="@($"sc-items-{Scenario.Id}")"
                          Group="@($"scenario-items-{Scenario.Id}")"
                          Class="sc-items-row"
                          Handle=".si-drag-handle"
                          OnUpdate="OnItemsReordered">
                <SortableItemTemplate>
                    <div class="si-drag-item">
                        <div class="si-drag-handle" title="Drag to reorder">
                            <DaIcon Name="drag" Size="18" />
                        </div>
                        <ScenarioItemComp ScenarioItem="context"
                                          Scenario="Scenario"
                                          Group="Group"
                                          Player="_player.GetItemPlayer(context)"
                                          IsStarting="_player.IsStarting(context)"
                                          OnRequestPlay="_player.PlayItemAsync"
                                          OnRequestPlayAtCue="_player.PlayItemAtCueAsync"
                                          DeleteItem="DeleteItem"
                                          OnEditorClosed="OnItemEditorClosed" />
                    </div>
                </SortableItemTemplate>
            </SortableList>
        }

        <div style="display:flex; flex-direction:column; gap:8px; justify-content:center;
                    padding:16px 20px; flex-shrink:0;">
            <button type="button" class="da-btn da-btn-fill" @onclick="CreateNewItem">
                <DaIcon Name="add" Size="16" />
                New item
            </button>

            @{ var itemPresets = DAService.Presets.Where(p => p.Kind == DAPresetKind.ScenarioItem).ToList(); }
            @if (itemPresets.Count > 0)
            {
                @* The house set has no menu widget, so the preset list is a button
                   that reveals a .da-pop. The fixed sheet behind it keeps MudMenu's
                   click-anywhere-to-dismiss, which a bare popover would lose. *@
                <div style="position:relative;">
                    <button type="button" class="da-btn da-btn-out"
                            @onclick="() => _presetMenuOpen = !_presetMenuOpen">
                        <DaIcon Name="bookmark" Size="16" />
                        From preset
                        <DaIcon Name="chevron-down" Size="16" />
                    </button>
                    @if (_presetMenuOpen)
                    {
                        <div style="position:fixed; inset:0; z-index:59;"
                             @onclick="() => _presetMenuOpen = false"></div>
                        <div class="da-pop">
                            @foreach (var preset in itemPresets)
                            {
                                var p = preset;
                                <button type="button" class="da-btn da-btn-text"
                                        style="width:100%; justify-content:flex-start;"
                                        @onclick="() => InsertPreset(p)">
                                    @(string.IsNullOrEmpty(p.Category) ? p.Name : $"{p.Category} / {p.Name}")
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public DAScenario Scenario { get; set; } = default!;
    /// <summary>Owning group — holds the local scenes the items can reference.</summary>
    [Parameter] public DAScenarioGroup? Group { get; set; }
    [Parameter] public DiceAudioService DAService { get; set; } = default!;
    [Parameter] public Action<DAScenario, bool>? MoveScenario { get; set; }
    [Parameter] public Action<DAScenario>? DeleteScenario { get; set; }

    private DAScenarioPlayer? _player;

    /// Whether the "From preset" popover is showing.
    private bool _presetMenuOpen;

    protected override void OnInitialized()
    {
        // Borrow the player from the coordinator: playback state survives
        // navigating away from and back to this page.
        _player = Coordinator.GetOrCreateScenarioPlayer(Scenario);
        _player.StateChanged += OnPlayerStateChanged;
    }

    void OnPlayerStateChanged() => InvokeAsync(StateHasChanged);

    void OnNameChanged(string name)
    {
        Scenario.Name = name ?? string.Empty;
        DAService.RequestScenarioGroupsSave();
    }

    void CreateNewItem()
    {
        Scenario.Items.Add(new DAScenarioItem());
        _player?.Initialize();   // reconciles; never interrupts playback
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void InsertPreset(DAPreset preset)
    {
        _presetMenuOpen = false;
        var item = preset.ToScenarioItem();   // independent deep copy, fresh ids
        if (item == null) return;
        Scenario.Items.Add(item);
        _player?.Initialize();
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void DeleteItem(DAScenarioItem item)
    {
        Scenario.Items.Remove(item);
        _player?.Initialize();
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    // Reorder item cards via drag and drop. Players are keyed by item id, so
    // moving an item in the list never interrupts playback — only the order
    // (and thus what "skip to next" plays) changes.
    void OnItemsReordered((int oldIndex, int newIndex) move)
    {
        var (oldIndex, newIndex) = move;
        if (oldIndex < 0 || oldIndex >= Scenario.Items.Count) return;
        if (newIndex < 0) newIndex = 0;
        if (newIndex >= Scenario.Items.Count) newIndex = Scenario.Items.Count - 1;
        if (oldIndex == newIndex) return;

        var item = Scenario.Items[oldIndex];
        Scenario.Items.RemoveAt(oldIndex);
        Scenario.Items.Insert(newIndex, item);
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void OnItemEditorClosed()
    {
        _player?.Initialize();
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    public void Dispose()
    {
        // The coordinator owns the player — only detach the UI refresh handler
        // so audio keeps playing while the user navigates elsewhere.
        if (_player != null)
            _player.StateChanged -= OnPlayerStateChanged;
    }
}
