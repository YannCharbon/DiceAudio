@implements IDisposable

<style>
    .si-card {
        border-radius: 10px;
        width: 260px; flex-shrink: 0; margin: 6px;
        overflow: hidden; display: flex; flex-direction: column;
        border: 2px solid #2a2a4a; background: #12121f;
    }
    .si-card-active { border-color: rgba(35,166,213,0.9); background: #14142a; }

    /* ── Handover feedback ──
       A play request is answered by a fade that lasts seconds, so the card the
       user clicked would otherwise sit unchanged until the sound finally starts.
       Uses the theme primary (#e73c7e) rather than a warning colour: it reads as
       the app's own accent and stays apart from the cyan of a playing card. */
    .si-card-staging {
        border-color: rgba(231,60,126,0.9);
        background: #191426;
        animation: si-staging-glow 1.2s ease-in-out infinite;
    }
    @@keyframes si-staging-glow {
        0%, 100% { box-shadow: 0 0 0 0 rgba(231,60,126,0); }
        50%      { box-shadow: 0 0 12px 2px rgba(231,60,126,0.3); }
    }
    /* Runs for exactly the handover fade, so the fill reaching the end and the
       sound starting are the same moment. */
    .si-staging-bar { height: 3px; background: rgba(231,60,126,0.18); overflow: hidden; }
    .si-staging-fill {
        height: 100%; width: 0; background: #e73c7e;
        animation-name: si-staging-fill;
        animation-timing-function: linear;
        animation-fill-mode: forwards;
    }
    @@keyframes si-staging-fill { from { width: 0; } to { width: 100%; } }
    /* On its way out: the dimming alone carries it, no caption needed. */
    .si-card-fading { opacity: 0.6; }
    .si-body   { padding: 8px 10px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .si-name   { font-weight: bold; font-size: 13px; word-break: break-word; }
    .si-meta   { font-size: 11px; color: var(--t3); display: flex; align-items: center; gap: 4px; }
    .si-footer { display: flex; justify-content: flex-end; gap: 4px; padding: 6px 8px;
                 border-top: 1px solid var(--b1); }
</style>

@{
    bool isActive = Player?.State == DAScenarioItemPlayer.PlayState.Play
                 || Player?.State == DAScenarioItemPlayer.PlayState.Pause;
    // Read from the player rather than passed in: the fade is announced on the
    // player's own event, which this card already listens to.
    bool isFadingOut = Player?.IsFadingOut == true;
    string trackName = Player?.CurrentAudioItem?.Name ?? "";
}

<div class="si-card @(isActive ? "si-card-active" : "") @(IsStarting ? "si-card-staging" : "") @(isFadingOut ? "si-card-fading" : "")">
    @* Animated gradient banner — uses shared da-playing-banner / da-stopped-banner from app.css *@
    <div class="@(isActive ? "da-playing-banner" : "da-stopped-banner")">
        @if (trackName.Length > 0)
        {
            <div style="font-size:11px; font-weight:bold; text-align:center;
                        text-shadow:0 1px 3px rgba(0,0,0,0.8); word-break:break-word;">
                @trackName
            </div>
        }
        else
        {
            @* A scene item has no track to name, so the placeholder was the only
               thing on the banner - and it was a music note, which is what every
               other kind of item is. It wears the mark the Scenes menu wears. *@
            <DaIcon Name="@(ScenarioItem.Type == DAScenarioItem.ItemType.Scene ? "movie" : "music-note")"
                    Size="32" style="opacity:0.35;" />
        }
    </div>

    @if (IsStarting)
    {
        <div class="si-staging-bar">
            <div class="si-staging-fill" style="animation-duration:@FadeSecondsCss;"></div>
        </div>
    }

    <div class="si-body">
        <div class="si-name">@ScenarioItem.Name</div>
        <div class="si-meta">
            <span>@ScenarioItem.Type</span>
            @* lightgreen has no token; the secondary teal is the nearest one and
               is what the rest of the app uses for an "on" marker. *@
            @if (ScenarioItem.PlayInLoop)
            { <DaIcon Name="loop" Size="14" style="color:var(--a3);" /> }
            @if (ScenarioItem.Type == DAScenarioItem.ItemType.Playlist && ScenarioItem.PlaylistOrderIsRandom)
            { <DaIcon Name="shuffle" Size="14" style="color:var(--a3);" /> }
        </div>

        <ScenarioItemPlayerComp ScenarioItem="ScenarioItem" Group="Group" Player="Player"
                                IsStarting="IsStarting" IsFadingOut="isFadingOut"
                                OnRequestPlay="OnRequestPlay" OnRequestPlayAtCue="OnRequestPlayAtCue" />
    </div>

    <div class="si-footer">
        <button type="button" class="da-ib" title="Edit" aria-label="Edit" @onclick="OpenEditor">
            <DaIcon Name="edit" Size="16" />
        </button>
        <button type="button" class="da-ib da-danger" title="Delete" aria-label="Delete"
                @onclick="() => DeleteItem?.Invoke(ScenarioItem)">
            <DaIcon Name="delete" Size="16" />
        </button>
    </div>
</div>

<ScenarioItemEditor @ref="_editorRef" ScenarioItem="ScenarioItem" Group="Group" OnClose="OnEditorClose" />

@code {
    [Parameter] public DAScenarioItem ScenarioItem { get; set; } = default!;
    [Parameter] public DAScenario Scenario { get; set; } = default!;
    /// <summary>Owning group — holds the local scenes this item can reference.</summary>
    [Parameter] public DAScenarioGroup? Group { get; set; }
    [Parameter] public DAScenarioItemPlayer? Player { get; set; }
    /// <summary>The user asked for this item and the handover fade is running.</summary>
    [Parameter] public bool IsStarting { get; set; }
    [Parameter] public Func<DAScenarioItem, Task>? OnRequestPlay { get; set; }
    [Parameter] public Func<DAScenarioItem, int, Task>? OnRequestPlayAtCue { get; set; }
    [Parameter] public Action<DAScenarioItem>? DeleteItem { get; set; }
    [Parameter] public Action? OnEditorClosed { get; set; }

    /// <summary>
    /// Handover fade as a CSS duration. Formatted invariantly on purpose: a comma
    /// decimal separator would make the browser drop the animation entirely.
    /// </summary>
    private static readonly string FadeSecondsCss =
        DAScenarioPlayer.HandoverFadeSeconds.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "s";

    private ScenarioItemEditor? _editorRef;
    private DAScenarioItemPlayer? _subscribedPlayer;

    void OpenEditor() => _editorRef?.Show();

    async Task OnEditorClose()
    {
        OnEditorClosed?.Invoke();
        await InvokeAsync(StateHasChanged);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (Player != _subscribedPlayer)
        {
            if (_subscribedPlayer != null)
                _subscribedPlayer.PlayStateChanged -= OnPlayerStateChanged;
            _subscribedPlayer = Player;
            if (_subscribedPlayer != null)
                _subscribedPlayer.PlayStateChanged += OnPlayerStateChanged;
        }
    }

    void OnPlayerStateChanged(object? s, DAScenarioItemPlayer.PlayState _) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (_subscribedPlayer != null)
            _subscribedPlayer.PlayStateChanged -= OnPlayerStateChanged;
    }
}
