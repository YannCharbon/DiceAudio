@page "/ytptest"
@using System.Globalization

@inject YtDlpService YtDlpService
@inject DiceAudioService DAService
@inject DADownloadQueue Queue
@implements IDisposable

<style>
    /* The in-button spinner MudProgressCircular drew. It borrows the shared
       spin-loader keyframes from app.css and takes its lit arc from
       currentColor, so it matches whichever button it sits in. */
    .progress-spinner {
        width: 14px;
        height: 14px;
        flex: none;
        border: 2px solid var(--b2);
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin-loader 0.9s linear infinite;
    }

    /* A progress track and its fill — the two divs that replace
       MudProgressLinear. */
    .dl-track { height: 6px; border-radius: 3px; background: var(--s2); overflow: hidden; margin-top: 6px; }
    .dl-fill  { height: 100%; background: var(--a1); }
</style>

@* ── The playlist question, which has three answers and so cannot be a
     DaConfirm. Same scrim and panel, one more button. ── *@
@if (_playlistAsk != null)
{
    <div class="da-confirm-scrim" @onclick="() => AnswerPlaylist(null)">
        <div class="da-confirm" role="alertdialog" aria-modal="true"
             aria-labelledby="dl-playlist-title" @onclick:stopPropagation="true">
            <h3 id="dl-playlist-title" class="da-confirm-title">Playlist detected</h3>
            <p class="da-confirm-msg">
                This link points to a video inside a playlist. Stage the entire playlist, or only this video?
            </p>
            <div class="da-confirm-foot">
                <button type="button" class="da-btn da-btn-text" @onclick="() => AnswerPlaylist(null)">Cancel</button>
                <button type="button" class="da-btn da-btn-out" @onclick="() => AnswerPlaylist(false)">
                    <DaIcon Name="music-note" Size="18" />Only this video
                </button>
                <button type="button" class="da-btn da-btn-fill" @onclick="() => AnswerPlaylist(true)">
                    <DaIcon Name="playlist" Size="18" />Entire playlist
                </button>
            </div>
        </div>
    </div>
}

@* ── Main download controls ── *@
<div class="da-panel">
    <div class="da-msec" style="margin-bottom:10px;">
        <h2 class="da-h2">Audio Downloader</h2>
        <p class="da-sub">Download audio from YouTube, SoundCloud, and thousands of other sites.</p>
        <p class="da-sub">Downloads carry on in the background when you close this window, and each track joins your library as soon as it is downloaded.</p>
        <div class="da-irow da-irow-wrap" style="gap:6px; margin-top:10px;">
            <button type="button" class="da-btn da-btn-fill"
                    disabled="@(staged.Count == 0)"
                    @onclick="StartDownload">
                <DaIcon Name="download" Size="18" />
                Start Download &nbsp;
                <div class="progress-spinner" style="@GetGlobalSpinnerStyle()"></div>
            </button>
            <button type="button" class="da-btn da-btn-out"
                    disabled="@(!Queue.IsBusy)"
                    @onclick="AbortDownload">
                <DaIcon Name="stop" Size="18" />Abort
            </button>
            <button type="button" class="da-btn da-btn-out"
                    disabled="@(staged.Count == 0)"
                    @onclick="Queue.ClearStaged">
                <DaIcon Name="delete" Size="18" />Clear staged
            </button>
        </div>
    </div>

    @* ── URL staging ── *@
    <div class="da-msec" style="margin-bottom:10px;">
        <div class="da-irow da-irow-wrap">
            <div class="da-field" style="flex:1;">
                <span class="da-flabel">Stage URL</span>
                <input class="da-inp" type="text" spellcheck="false" @bind="urlToStage" />
            </div>
            @if (!string.IsNullOrEmpty(stageErrorMessage))
            {
                <div style="color:var(--danger); font-size:13px;">@stageErrorMessage</div>
            }
            <button type="button" class="da-btn da-btn-fill"
                    disabled="@isStaging"
                    @onclick="StageURL">
                <DaIcon Name="add" Size="18" />
                Stage &nbsp;
                <div class="progress-spinner" style="@GetStageSpinnerStyle()"></div>
            </button>
        </div>
    </div>

    @* ── Target folder picker ── *@
    <div class="da-msec" style="margin-bottom:10px;">
        <FolderSelectField Label="Download to"
                           Folder="@_targetFolder"
                           FolderChanged="OnTargetFolderChanged"
                           OnFolderCreated="OnFolderCreated" />
    </div>

    @* ── Staged items: checked links, not yet sent to the download list ── *@
    @foreach (var item in staged)
    {
        <div class="da-msec" style="margin-bottom:10px;">
            <div class="da-irow da-irow-wrap">
                <div class="da-field" style="flex:1;">
                    <span class="da-flabel">Name</span>
                    <input class="da-inp" type="text" @bind="item.Name" />
                </div>
                <button type="button" class="da-btn da-btn-out"
                        @onclick="() => Queue.Unstage(item)">
                    <DaIcon Name="remove" Size="18" />Unstage
                </button>
            </div>
        </div>
    }

    @* ── The download list. The queue keeps it, so it is still there when
         this window is opened again. ── *@
    @if (jobs.Count > 0)
    {
        <div class="da-msec" style="margin-bottom:10px;">
            <div class="da-irow da-irow-wrap" style="justify-content:space-between;">
                <span class="da-flabel">Download list</span>
                <button type="button" class="da-btn da-btn-text"
                        disabled="@(!jobs.Any(j => j.IsFinished))"
                        @onclick="Queue.ClearFinished">
                    <DaIcon Name="delete" Size="18" />Clear finished
                </button>
            </div>
        </div>

        @foreach (var job in jobs)
        {
            var item = job.Item;
            <div class="da-msec" style="margin-bottom:10px;">
                <div class="da-irow da-irow-wrap">
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:600;">@item.Name</div>
                        <div class="da-meta">@StateLabel(job) · @DAService.FolderDisplayPath(JobFolder(job))</div>
                    </div>
                    <div class="progress-spinner" style="@GetSpinnerStyle(job)"></div>
                    @if (item.IsLocallyAvailable && job.IsFinished)
                    {
                        @* The file name was the icon's tooltip; an <svg> cannot carry
                           one through a title attribute, so the wrapper does. *@
                        <span title="@item.LocalFileName">
                            <DaIcon Name="check-circle" Size="24" style="color:var(--ok);" />
                        </span>
                    }
                </div>
                <div class="dl-track">
                    <div class="dl-fill" style="width:@(Math.Clamp(item.SourceDownloadProgress, 0, 100))%;"></div>
                </div>
                <div style="font-size:12px; color:var(--t3);">@item.SourceDownloadStatusMessage</div>
            </div>
        }
    }
</div>

@* ── Library repair: scan local files ── *@
<div class="da-panel" style="margin-top:16px;">
    <div class="da-msec">
        <h2 class="da-h2">Scan local audio folder</h2>
        <p class="da-sub" style="margin-bottom:10px;">
            If items are missing their local file reference (showing "Not downloaded" despite being on disk),
            click Scan to repair them. Also imports unclaimed MP3 files as new library items.
        </p>
        <button type="button" class="da-btn da-btn-fill"
                disabled="@Queue.IsBusy"
                @onclick="ScanLocalFiles">
            <DaIcon Name="search" Size="18" />Scan audio folder
        </button>
        @if (!string.IsNullOrEmpty(_scanResultMessage))
        {
            <div style="margin-top:8px; color:var(--a2); font-size:13px;">@_scanResultMessage</div>
        }
    </div>
</div>

@code {
    private string urlToStage = "";
    private string stageErrorMessage = "";
    private bool isStaging = false;

    /// <summary>Destination folder — null means the root of the library.</summary>
    private DAVirtualAudioFolder? _targetFolder;
    private string _scanResultMessage = "";

    // What the queue holds, read again at each render: the queue outlives
    // this component, so it is the only place these lists live.
    private IReadOnlyList<DAAudioItem> staged => Queue.Staged;
    private IReadOnlyList<DADownloadJob> jobs => Queue.Jobs;

    protected override async Task OnInitializedAsync()
    {
        Queue.Changed += OnQueueChanged;

        // Keep filing downloads under "Untriaged" when that folder exists.
        await DAService.WhenLoaded;
        _targetFolder = DAService.FindFolderByName("Untriaged");
    }

    private void OnQueueChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Queue.Changed -= OnQueueChanged;

    /// The folder a download goes to: the one chosen for a new link, or the
    /// folder an item of the library (after an import, or "Download" in the
    /// Explorer) is already in.
    private DAVirtualAudioFolder? JobFolder(DADownloadJob job) =>
        job.InLibrary ? DAService.AudioVirtualFolders.FirstOrDefault(f => f.Name == job.Item.Folder?.Name) : job.TargetFolder;

    private async Task OnTargetFolderChanged(DAVirtualAudioFolder? folder)
    {
        _targetFolder = folder;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnFolderCreated(DAVirtualAudioFolder folder) => await DAService.SaveAudioVirtualFoldersAsync();

    // ── Staging ──────────────────────────────────────────────

    private async Task StageURL()
    {
        if (string.IsNullOrWhiteSpace(urlToStage))
        {
            stageErrorMessage = "Please provide a URL.";
            return;
        }
        isStaging = true;
        stageErrorMessage = "";

        if (!Queue.IsStaged(urlToStage))
        {
            if (urlToStage.Contains("list="))
            {
                // A playlist URL. If it also points at a specific video, ask whether
                // to stage the whole playlist or just that one video.
                var singleVideoUrl = TryGetSingleVideoUrl(urlToStage);
                bool stageWholePlaylist = true;

                if (singleVideoUrl != null)
                {
                    var choice = await AskPlaylistAsync();

                    if (choice == null) { isStaging = false; return; }   // cancelled
                    stageWholePlaylist = choice == true;
                }

                if (stageWholePlaylist)
                {
                    var (titles, urls) = await YtDlpService.GetPlaylistVideoTitlesAndUrlsAsync(urlToStage);
                    for (int i = 0; i < titles.Count; i++)
                    {
                        Queue.Stage(new DAAudioItem(titles[i]) { SourceURL = urls[i] });
                    }
                    urlToStage = "";
                }
                else
                {
                    // Only this video: use the cleaned URL (playlist params stripped)
                    // so the later download fetches a single track, not the playlist.
                    await StageSingleUrlAsync(singleVideoUrl!);
                }
            }
            else
            {
                await StageSingleUrlAsync(urlToStage);
            }
        }

        isStaging = false;
    }

    private async Task StageSingleUrlAsync(string url)
    {
        var item = new DAAudioItem("Default") { SourceURL = url };
        item.Name = await YtDlpService.GetVideoTitleAsync(url);
        if (!item.Name.Contains("YtDLP Error"))
        {
            Queue.Stage(item);
            urlToStage = "";
        }
        else
        {
            stageErrorMessage = item.Name;
        }
    }

    // Returns a clean single-video watch URL if the given URL carries a video id
    // (watch?v=… or youtu.be/…), else null (e.g. a playlist-only URL).
    private static string? TryGetSingleVideoUrl(string url)
    {
        var id = DAAudioFileNames.VideoIdFromUrl(url);
        return id == null ? null : $"https://www.youtube.com/watch?v={id}";
    }

    // ── The playlist question ─────────────────────────────────────────
    // Three answers, so DaConfirm (which is yes/no) cannot carry it. Same
    // shape as DaConfirm.AskAsync: the caller keeps reading as a straight
    // line, and a second question settles the first as a cancel.
    private TaskCompletionSource<bool?>? _playlistAsk;

    private Task<bool?> AskPlaylistAsync()
    {
        _playlistAsk?.TrySetResult(null);
        _playlistAsk = new TaskCompletionSource<bool?>(TaskCreationOptions.RunContinuationsAsynchronously);
        StateHasChanged();
        return _playlistAsk.Task;
    }

    private void AnswerPlaylist(bool? answer)
    {
        var pending = _playlistAsk;
        _playlistAsk = null;
        StateHasChanged();
        pending?.TrySetResult(answer);
    }

    // ── Download: handed to the queue, which runs it in the background ──

    private void StartDownload() => Queue.StartStaged(_targetFolder);

    private void AbortDownload() => Queue.CancelAll();

    private static string StateLabel(DADownloadJob job) => job.State switch
    {
        DADownloadState.Waiting      => "Waiting",
        DADownloadState.Downloading  => "Downloading",
        DADownloadState.Done         => "Downloaded",
        DADownloadState.AlreadyThere => "Already on this computer",
        DADownloadState.Failed       => "Failed",
        _                            => "Cancelled",
    };

    // ── Library scan / repair ─────────────────────────────────

    private async Task ScanLocalFiles()
    {
        _scanResultMessage = "Scanning...";
        await InvokeAsync(StateHasChanged);

        int repaired = YtDlpService.RepairMissingLocalFileNames(DAService.AudioItems);

        var unclaimed = YtDlpService.GetUnclaimedMp3Files(DAService.AudioItems);
        int imported = 0;
        foreach (var fileName in unclaimed)
        {
            // "Title [id].mp3" from a current download gives the item "Title".
            var newItem = new DAAudioItem(DAAudioFileNames.ItemNameFor(fileName))
            {
                LocalFileName = fileName,
                IsLocallyAvailable = true
            };
            newItem.Folder = _targetFolder ?? DiceAudioService.NewRootFolderMarker();
            DAService.AddAudioItem(newItem);
            imported++;
        }

        await DAService.SaveAudioItemListAsync();

        _scanResultMessage = repaired == 0 && imported == 0
            ? "Scan complete — no changes needed."
            : $"Scan complete: {repaired} item(s) repaired, {imported} new file(s) imported.";

        await InvokeAsync(StateHasChanged);
    }

    // ── UI helpers ────────────────────────────────────────────

    // The spinner is a div now rather than a component, so the styles only
    // have to decide whether it is in the layout at all.
    private string GetStageSpinnerStyle()  => isStaging    ? "" : "display:none;";
    private string GetGlobalSpinnerStyle() => Queue.IsBusy ? "" : "display:none;";
    private string GetSpinnerStyle(DADownloadJob job) => job.State == DADownloadState.Downloading ? "" : "display:none;";
}
