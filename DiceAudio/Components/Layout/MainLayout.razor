@inherits LayoutComponentBase

@inject DiceAudioService AudioService
@inject DAStorageNotices Notices
@inject NavigationManager Navigation
@inject DiceAudio.Storage.DataFolderService DataFolder
@inject DAExternalChanges ExternalChanges
@inject DAPlaybackCoordinator Playback
@implements IDisposable

@using DiceAudio.Resources.Localization

<PopupNotification></PopupNotification>

<BundleExportDialog />

<ImportWizard />

@* A data file that could not be read at startup, a save that failed, or
   how a restore ended: the user must see it and acknowledge it, so it is a
   dialog rather than a toast that fades away. The messages live in
   DAStorageNotices, so they survive the rebuild of the pages after a
   restore. Drawn like DaConfirm, with a single button and
   no title, as in DiceCombats: there is nothing to decide, only something
   to know. *@
@if (_storageNotices.Count > 0)
{
    <div class="da-confirm-scrim">
        <div class="da-confirm" role="alertdialog" aria-modal="true">
            @foreach (var line in _storageNotices)
            {
                <p class="da-confirm-msg">@line</p>
            }
            <div class="da-confirm-foot">
                <button type="button" class="da-btn da-btn-fill" @onclick="CloseStorageNotice">
                    <DaIcon Name="check" />
                    @Portability.AlertCloseBtn
                </button>
            </div>
        </div>
    </div>
}

@* When the data folder could not be used at startup, nothing has been read:
   the startup screen stands in for the whole app until a usable folder is
   chosen. (While an ordinary start is still reading, the app shows as usual:
   every save waits for the load.) *@
@if (ShowGate)
{
    <div style="@(OperatingSystem.IsWindows() ? "padding-top:32px;" : "")">
        <DataFolderGate />
    </div>
}
else
{
@* A save found its file changed on another computer (A9): nothing was
   written. The user chooses which version to keep. *@
@if (!ShowGate && ExternalChanges.PendingConflict is string conflict)
{
    <div class="da-confirm-scrim">
        <div class="da-confirm" role="alertdialog" aria-modal="true">
            <h3 class="da-confirm-title">@Portability.ChangedOnDiskTitle</h3>
            <p class="da-confirm-msg">@string.Format(Portability.ChangedOnDiskText, conflict)</p>
            @if (Playback.ActiveScenarioPlayers.Count > 0)
            {
                <p class="da-confirm-msg">@Portability.ChangedReloadStopsPlayback</p>
            }
            <div class="da-confirm-foot">
                <button type="button" class="da-btn da-btn-out" disabled="@_externalBusy" @onclick="OverwriteExternal">
                    <DaIcon Name="save" /> @Portability.ChangedOverwriteBtn
                </button>
                <button type="button" class="da-btn da-btn-fill" disabled="@_externalBusy" @onclick="ReloadExternal">
                    <DaIcon Name="sync" /> @Portability.ChangedReloadBtn
                </button>
            </div>
        </div>
    </div>
}

<div class="page">
    <!--<div class="sidebar">
        <NavMenu />
    </div>-->
    <DCNavMenu />


    @* On Windows the web page includes the 32px title strip above the 50px
       bar (WebTitleBar extends the webview to the window top), so the scroll
       area starts 82px down; elsewhere the bar alone is 50px. *@
    <main id="mainscroll" style="@(OperatingSystem.IsWindows() ? "margin-top:82px;height:calc(100vh - 82px);" : "")">
        <MudThemeProvider IsDarkMode="true" Theme="DCTheme" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        @* main already sits 50px below the top (under the fixed app bar); keep
           only the 20px breathing space here. *@
        <article class="content px-4" style="padding-top:20px;" id="mainpagebody">
            @if (DataFolder.Location.IsSessionFallback)
            {
                <div class="da-msec" style="margin-bottom:12px; border-left:3px solid var(--warn);">@Portability.StartupUsingLocalBanner</div>
            }
            @* Changed on another computer: never reloaded without the user. *@
            @if (ExternalChanges.ChangedElsewhere.Count > 0)
            {
                <div class="da-msec da-irow da-irow-wrap" style="margin-bottom:12px; border-left:3px solid var(--warn); gap:10px; align-items:center;">
                    <span style="flex:1 1 240px;">
                        @Portability.ChangedBanner
                        @if (Playback.ActiveScenarioPlayers.Count > 0)
                        {
                            @(" ")@Portability.ChangedReloadStopsPlayback
                        }
                    </span>
                    <button type="button" class="da-btn da-btn-out da-btn-sm" disabled="@_externalBusy" @onclick="ReloadExternal">
                        <DaIcon Name="sync" Size="16" /> @Portability.ChangedReloadBtn
                    </button>
                </div>
            }
            @Body
        </article>
    </main>
</div>
}

@code {
    MudTheme DCTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
            {
                Primary = "#e73c7e",
                Secondary = "#23a6ab",
            },
    };

    /// The messages waiting to be read, oldest first. Each one names its own
    /// file or says what happened, so they can be shown together without a
    /// title that would fit only some.
    private IReadOnlyList<string> _storageNotices = Array.Empty<string>();

    private bool ShowGate => !DataFolder.IsLoaded && DataFolder.Location.State != DiceAudio.Storage.DataLocationState.Ok;

    private void OnLoadedChanged() => _ = InvokeAsync(StateHasChanged);

    private bool _externalBusy;

    private async Task ReloadExternal()
    {
        _externalBusy = true;
        try { await ExternalChanges.ReloadAsync(); }
        finally { _externalBusy = false; }
    }

    private async Task OverwriteExternal()
    {
        _externalBusy = true;
        try { await ExternalChanges.OverwriteAsync(); }
        finally { _externalBusy = false; }
    }

    protected override void OnInitialized()
    {
        DataFolder.LoadedChanged += OnLoadedChanged;
        ExternalChanges.Changed += OnLoadedChanged;
        Notices.Changed += OnNoticesChanged;
        _storageNotices = Notices.Pending;
        App.PagesReloadRequested += ReloadInPlace;
    }

    // A full reload of the web page in the same web view: every component and
    // every scoped service starts again, as with a new page, but the native
    // window around it is left alone (see App.ReloadPages). The notices live
    // in DAStorageNotices, so a restore's message is still there afterwards.
    private void ReloadInPlace()
    {
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    // Raised on whatever thread added the message.
    private void OnNoticesChanged() => _ = InvokeAsync(() =>
    {
        _storageNotices = Notices.Pending;
        StateHasChanged();
    });

    private void CloseStorageNotice() => Notices.DismissAll();

    public void Dispose()
    {
        Notices.Changed -= OnNoticesChanged;
        DataFolder.LoadedChanged -= OnLoadedChanged;
        ExternalChanges.Changed -= OnLoadedChanged;
        App.PagesReloadRequested -= ReloadInPlace;
    }
}
