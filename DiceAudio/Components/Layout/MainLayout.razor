@inherits LayoutComponentBase

@inject DiceAudioService AudioService
@implements IDisposable

@using DiceAudio.Resources.Localization

<PopupNotification></PopupNotification>

@* A data file that could not be read at startup, or a save that failed:
   the user must see it and acknowledge it, so it is a dialog rather than
   a toast that fades away. *@
@if (_storageNotices.Count > 0)
{
    var notice = _storageNotices[0];
    <div class="da-confirm-scrim">
        <div class="da-confirm" role="alertdialog" aria-modal="true" aria-labelledby="da-storage-notice-t">
            <h3 id="da-storage-notice-t" class="da-confirm-title">@notice.Title</h3>
            @foreach (var line in notice.Lines)
            {
                <p class="da-confirm-msg">@line</p>
            }
            <div class="da-confirm-foot">
                <button type="button" class="da-btn da-btn-fill" @onclick="CloseStorageNotice">
                    <DaIcon Name="check" />
                    @Portability.OkBtn
                </button>
            </div>
        </div>
    </div>
}

<div class="page">
    <!--<div class="sidebar">
        <NavMenu />
    </div>-->
    <DCNavMenu />


    @* On Windows the web page includes the 32px title strip above the 50px
       bar (WebTitleBar extends the webview to the window top), so the scroll
       area starts 82px down; elsewhere the bar alone is 50px. *@
    <main id="mainscroll" style="@(OperatingSystem.IsWindows() ? "margin-top:82px;height:calc(100vh - 82px);" : "")">
        <MudThemeProvider IsDarkMode="true" Theme="DCTheme" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        @* main already sits 50px below the top (under the fixed app bar); keep
           only the 20px breathing space here. *@
        <article class="content px-4" style="padding-top:20px;" id="mainpagebody">
            @Body
        </article>
    </main>
</div>

@code {
    MudTheme DCTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
            {
                Primary = "#e73c7e",
                Secondary = "#23a6ab",
            },
    };

    /// The notices waiting to be read, oldest first; the first one is shown.
    /// Each keeps its own title: a failed save is never listed under the
    /// title of a failed load, or the reverse.
    private readonly List<(string Title, List<string> Lines)> _storageNotices = new();

    protected override void OnInitialized()
    {
        AudioService.Store.SaveFailed += OnSaveFailed;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await AudioService.WhenLoaded;
        if (AudioService.UnreadableFilesNoticeShown || AudioService.UnreadableFiles.Count == 0) return;

        AudioService.UnreadableFilesNoticeShown = true;
        ShowStorageNotice(Portability.ErrorLoadFailedTitle,
                          AudioService.UnreadableFiles.Select(f => string.Format(Portability.ErrorLoadFailed, f)));
    }

    // Raised on whatever thread the save ran on.
    private void OnSaveFailed(string fileName, Exception error) =>
        _ = InvokeAsync(() => ShowStorageNotice(Portability.ErrorSaveFailedTitle,
                                                new[] { string.Format(Portability.ErrorSaveFailed, fileName) }));

    private void ShowStorageNotice(string title, IEnumerable<string> lines)
    {
        // A notice of the same kind still waiting takes the new lines (one
        // dialog for several failed saves); any other kind queues behind.
        int same = _storageNotices.FindIndex(n => n.Title == title);
        if (same >= 0)
            _storageNotices[same] = (title, _storageNotices[same].Lines.Concat(lines).Distinct().ToList());
        else
            _storageNotices.Add((title, lines.ToList()));
        StateHasChanged();
    }

    private void CloseStorageNotice()
    {
        if (_storageNotices.Count > 0) _storageNotices.RemoveAt(0);
    }

    public void Dispose()
    {
        AudioService.Store.SaveFailed -= OnSaveFailed;
    }
}
