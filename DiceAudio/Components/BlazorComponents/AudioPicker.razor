@inject DiceAudioService DAService

@* ── General audio item picker modal.
     Two modes:
       • multi-select — toggles entries in SelectionList (List<DAAudioUsage>)
       • single-select — invokes OnPicked with the chosen item and closes
     Overlay z-index 5000: above the item editor (3000) and scene editor (4800). ── *@
@if (_visible)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.82); z-index:5000; overflow-y:auto;"
     @onclick="Hide">
    <div style="background:#232338; margin:3% auto; max-width:960px; border-radius:12px;
                padding:20px 24px; position:relative;"
         @onclick:stopPropagation="true">

        <MudText Typo="Typo.h6" Style="margin-bottom:14px;">@Title</MudText>

        @* ── Search + kind filter ── *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Style="margin-bottom:10px; flex-wrap:wrap; gap:6px;">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged"
                          Placeholder="Search by name…" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" Clearable="true" Style="min-width:240px; flex:1;" />

            <MudButton Variant="@(_kinds.Count == 3 ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Default" Size="Size.Small"
                       OnClick="SelectAllKinds">All</MudButton>
            @foreach (var kind in new[] { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect })
            {
                var k = kind;
                <MudButton Variant="@(_kinds.Contains(k) && _kinds.Count < 3 ? Variant.Filled : Variant.Outlined)"
                           Color="@k.Color()" Size="Size.Small" StartIcon="@k.Icon()"
                           OnClick="() => ToggleKind(k)">@k.Label()</MudButton>
            }

            <MudButton Variant="@(_filterOpen ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.FilterList"
                       OnClick="() => _filterOpen = !_filterOpen">Tags</MudButton>
            @if (_filterTags.Count > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => _filterTags.Clear()">Clear tags</MudButton>
            }
        </MudStack>

        @if (_filterOpen)
        {
            <div style="background:#1a1a2e; border-radius:8px; padding:10px; margin-bottom:12px;">
                <MudText Typo="Typo.caption" Style="color:grey;">Type</MudText>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryTypeTags())
                    { <span class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)" style="cursor:pointer;">@tag</span> }
                </div>
                <MudText Typo="Typo.caption" Style="color:grey;">Location</MudText>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryLocationTags())
                    { <span class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)" style="cursor:pointer;">@tag</span> }
                </div>
                <MudText Typo="Typo.caption" Style="color:grey;">Expression</MudText>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryExpressionTags())
                    { <span class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)" style="cursor:pointer;">@tag</span> }
                </div>
            </div>
        }

        @* ── Folder navigation (hidden while searching — search is global) ── *@
        @if (string.IsNullOrWhiteSpace(_search))
        {
            <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:8px;">
                @if (_currentFolderName == ".")
                {
                    <span style="font-weight:bold;">Root</span>
                }
                else
                {
                    <span class="sap-crumb" @onclick='() => _currentFolderName = "."'>Root</span>
                    @foreach (var crumb in BreadcrumbChain())
                    {
                        var c = crumb;
                        <span style="color:#888;">/</span>
                        @if (c.Name == _currentFolderName)
                        {
                            <span style="font-weight:bold;">@c.Name</span>
                        }
                        else
                        {
                            <span class="sap-crumb" @onclick="() => _currentFolderName = c.Name">@c.Name</span>
                        }
                    }
                }
            </div>

            <div class="da-grid da-picker-folders" style="margin-bottom:4px;">
                @foreach (var folder in DAService.ChildFolders(DAService.FindFolderByName(_currentFolderName)))
                {
                    @RenderFolderCard(folder)
                }
            </div>
        }

        @* ── Audio items grid ── *@
        <div class="da-grid da-picker" style="max-height:480px; overflow-y:auto;">
            @{
                var visibleItems = FilteredItems().ToList();
            }
            @if (!visibleItems.Any())
            {
                <p style="padding:20px; color:grey;">No matching audio items found.</p>
            }
            @foreach (var item in visibleItems)
            {
                bool isSelected = !SingleSelect && SelectionList != null
                    && SelectionList.Any(u => u.AudioItemId == item.Id);

                @* Inclusion is green and lives on the hero — deliberately unlike the
                   explorer's blue batch selection, which means something else. *@
                <article class="da-card @item.Kind.KindClass() @(_playingIds.Contains(item.Id) ? "playing" : "") @(isSelected ? "added" : "")">
                    <div class="da-hero" @onclick="() => PickItem(item)"
                         title="@(SingleSelect ? "Click to pick this item"
                                  : isSelected ? "Click to remove it from the selection"
                                  : "Click to add it to the selection")">
                        @* Inert here (pointer-events:none): the whole hero is one target. *@
                        <button type="button" class="da-kind" tabindex="-1" title="@item.Kind.Label()">
                            <MudIcon Icon="@item.Kind.Icon()" Style="font-size:15px;" />
                            <span class="da-kind-label">@item.Kind.Label()</span>
                        </button>
                        <div class="da-name" title="@($"{item.Name} — {item.Folder.Name}")">@item.Name</div>
                        @if (!SingleSelect)
                        {
                            <span class="da-pickmark">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size:17px;" />
                            </span>
                        }
                    </div>
                    <div class="da-body">
                        <div class="da-tags">
                            @foreach (var tag in item.Tags)
                            {
                                <span class="da-chip @tag.CategoryClass()"><span class="da-dot"></span>@tag.Name</span>
                            }
                        </div>
                        @if (item.IsLocallyAvailable)
                        {
                            <MusicPlayer AudioItem="@item"
                                         PlayingChanged="@((bool playing) => SetPlaying(item, playing))" />
                        }
                        else
                        {
                            <div class="da-offline">
                                <MudIcon Icon="@Icons.Material.Filled.CloudDownload" Style="font-size:13px;" />
                                Not downloaded
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        @* ── Footer ── *@
        <div style="display:flex; justify-content:flex-end; margin-top:14px;">
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="async () => await Hide()">OK</MudButton>
        </div>
    </div>
</div>
}

<style>
    /* The item and folder cards come from app.css (.da-card and friends), shared
       with the explorer. What remains here is the tag-filter panel. */
    .sap-tag {
        color:#cfcfdd; background:rgba(139,139,166,.12); border:1px solid rgba(139,139,166,.35);
        border-radius:5px; padding:3px 7px; margin:2px; font-size:11px; line-height:1;
    }
    .sap-tag-sel {
        color:#0b0b14; background:#23a6d5; border:1px solid #23a6d5;
        border-radius:5px; padding:3px 7px; margin:2px; font-size:11px; line-height:1; font-weight:bold;
    }
    .sap-crumb { cursor:pointer; color:#90caf9; }
    .sap-crumb:hover { text-decoration:underline; }
</style>

@code {
    /// <summary>Multi-select mode: entries are toggled in this list.</summary>
    [Parameter] public List<DAAudioUsage>? SelectionList { get; set; }

    /// <summary>Single-select mode: pick one item, raise OnPicked, close.</summary>
    [Parameter] public bool SingleSelect { get; set; }
    [Parameter] public EventCallback<DAAudioItem> OnPicked { get; set; }

    [Parameter] public string Title { get; set; } = "Pick audio";
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _visible;

    // Items whose player is running, so their card hero animates while playing.
    private readonly HashSet<Guid> _playingIds = new();

    private void SetPlaying(DAAudioItem item, bool playing)
    {
        if (playing) _playingIds.Add(item.Id);
        else _playingIds.Remove(item.Id);
    }

    private string _currentFolderName = ".";
    private string _search = "";
    private bool _filterOpen;
    private readonly List<string> _filterTags = new();
    private HashSet<AudioKind> _kinds = new() { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };

    /// <summary>Opens the picker, optionally pre-filtering to the given kinds.</summary>
    public void Show(IEnumerable<AudioKind>? kinds = null)
    {
        _visible = true;
        _currentFolderName = ".";
        _search = "";
        _filterOpen = false;
        _filterTags.Clear();
        _kinds = kinds != null && kinds.Any()
            ? new HashSet<AudioKind>(kinds)
            : new HashSet<AudioKind> { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };
        StateHasChanged();
    }

    public async Task Hide()
    {
        _visible = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }

    // Ancestor chain (root-most first) down to the current folder, for breadcrumbs.
    private List<DAVirtualAudioFolder> BreadcrumbChain() =>
        DAService.FolderAncestry(DAService.FindFolderByName(_currentFolderName));

    private RenderFragment RenderFolderCard(DAVirtualAudioFolder folder) => __builder =>
    {
        <article class="da-card da-folder">
            <div class="da-hero" title="@folder.Name" @onclick="() => _currentFolderName = folder.Name">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Style="font-size:38px;" />
            </div>
            <div class="da-body"><b>@folder.Name</b></div>
        </article>;
    };

    private IEnumerable<DAAudioItem> FilteredItems()
    {
        var items = DAService.AudioItems.Where(a => _kinds.Contains(a.Kind));

        if (!string.IsNullOrWhiteSpace(_search))
            items = items.Where(a => a.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        else
            items = items.Where(a => a.Folder.Name == _currentFolderName);

        if (_filterTags.Count > 0)
            items = items.Where(a => _filterTags.Any(ft => a.Tags.Any(t => t.Name == ft)));

        return items.Take(200);   // hard cap so huge libraries stay responsive
    }

    private async Task PickItem(DAAudioItem item)
    {
        if (SingleSelect)
        {
            await OnPicked.InvokeAsync(item);
            await Hide();
            return;
        }

        if (SelectionList == null) return;
        var existing = SelectionList.FirstOrDefault(u => u.AudioItemId == item.Id);
        if (existing != null) SelectionList.Remove(existing);
        else SelectionList.Add(new DAAudioUsage(item.Id));
    }

    private void OnSearchChanged(string value) => _search = value ?? "";

    private void SelectAllKinds() =>
        _kinds = new HashSet<AudioKind> { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };

    private void ToggleKind(AudioKind kind)
    {
        // Clicking a kind narrows to it; clicking the active single kind restores all.
        if (_kinds.Count == 1 && _kinds.Contains(kind))
            SelectAllKinds();
        else
            _kinds = new HashSet<AudioKind> { kind };
    }

    private void ToggleFilterTag(string tag)
    {
        if (_filterTags.Contains(tag)) _filterTags.Remove(tag);
        else _filterTags.Add(tag);
    }

    private string FilterChipClass(string tag) =>
        _filterTags.Contains(tag) ? "sap-tag-sel" : "sap-tag";
}
