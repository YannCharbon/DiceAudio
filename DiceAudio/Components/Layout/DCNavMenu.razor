@implements IDisposable
@inject NavigationManager Nav
@inject DAPlaybackCoordinator Coordinator

@* The bar used to carry its own 200-line <style> block. The capsules, the
   links, the utility slot and the live chip now live in app.css under the same
   class names as DiceCombats', so the two apps' title bars are one piece of
   CSS wearing two gradients. What stays here is only what is genuinely this
   app's: where its gem sits, and the equaliser. *@

<style>
    /* ── the gem ──
       Sized and positioned against this logo's own artwork, which is why it
       cannot live in the shared sheet: the hexagon's edge has to equal the bar
       height, and that ratio belongs to the file. */
    .nav-logo {
        position: relative;
        z-index: 5;
        width: 104px; /* reserve the notch the gem occupies */
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .nav-logo img {
            width: 100px;
            transform: translateY(0px);
        }

    /* ── Windows: the web page is the title bar ──
       The WebView2 extends to the window's top edge (see WebTitleBar). A 32px
       strip above the bar acts as the draggable title bar; the bar sits below
       it and the gem crowns over both. */
    .da-titlestrip {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 32px;
        background: var(--s0);
        z-index: 9; /* under the bar and the gem */
        app-region: drag;
        -webkit-app-region: drag;
    }

    .da-bar-win {
        top: 32px; /* below the drag strip */
    }

        .da-bar-win .nav-logo {
            align-self: stretch; /* span the bar so the img anchors to its top */
        }

            .da-bar-win .nav-logo img {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
                width: 90.7px;   /* 72.583 × (50 / 40.001): hexagon edge = bar height */
                top: -27.1px;    /* flat-top corners (21.65 × 1.25 into the image) on the bar top */
                app-region: no-drag;
                -webkit-app-region: no-drag;
            }

    /* ── the equaliser ──
       DiceCombats' live chip carries a single pulsing dot. This app's live
       state is sound, so it gets three bars that move like a level meter. */
    .da-eq {
        display: inline-flex;
        align-items: flex-end;
        gap: 2px;
        height: 14px;
        flex: none;
    }

        .da-eq span {
            width: 3px;
            background: var(--a3);
            border-radius: 2px;
            animation: da-eq 1s ease-in-out infinite;
        }

            .da-eq span:nth-child(1) { height: 6px; animation-delay: -0.2s; }
            .da-eq span:nth-child(2) { height: 13px; animation-delay: -0.5s; }
            .da-eq span:nth-child(3) { height: 9px; animation-delay: 0s; }

    @@keyframes da-eq {
        0%, 100% { transform: scaleY(0.45); }
        50% { transform: scaleY(1); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .da-eq span { animation: none; }
    }
</style>

@if (OperatingSystem.IsWindows())
{
    @* Draggable title strip: the OS treats it as caption (drag, double-click
       maximize, right-click system menu) via WebView2 non-client regions. *@
    <div class="da-titlestrip"></div>
}

<nav class="da-bar @(OperatingSystem.IsWindows() ? "da-bar-win" : "")">
    @* The two capsules are not the same width, so each takes an equal share of
       the leftover space and the gem lands on the window's true centre. *@
    <div class="da-side da-side-left">
        <div class="da-seg">
            <a class="da-navlink @(IsActive("audioexplorer") ? "active" : "")" href="audioexplorer">
                <DaIcon Name="library-music" Size="18" />
                <span>Explorer</span>
            </a>
            <a class="da-navlink @(IsActive("scenes") ? "active" : "")" href="scenes">
                <DaIcon Name="movie" Size="18" />
                <span>Scenes</span>
            </a>
        </div>
    </div>

    <div class="nav-logo" @onclick="GoHome"><img src="diceaudio_logo.svg" /></div>

    <div class="da-side da-side-right">
        <div class="da-seg">
            <a class="da-navlink @(IsActive("scenarios") ? "active" : "")" href="scenarios">
                <DaIcon Name="auto-stories" Size="18" />
                <span>Scenarios</span>
            </a>
            <a class="da-navlink @(IsActive("presets") ? "active" : "")" href="presets">
                <DaIcon Name="bookmarks" Size="18" />
                <span>Presets</span>
            </a>
        </div>
    </div>

    <div class="da-util">
        @if (_nowPlaying is not null)
        {
            @* The equaliser is three bars rather than the shared single pulse:
               this app's live state is sound, and the bars say so at a glance. *@
            <div class="da-live" title="@_nowPlaying" @onclick="GoToScenarios">
                <span class="da-eq"><span></span><span></span><span></span></span>
                <span class="da-live-name">@_nowPlaying</span>
            </div>
        }
        <button type="button" class="da-ub" title="Settings" aria-label="Settings" @onclick="GoToSettings">
            <DaIcon Name="settings" Size="18" />
        </button>
    </div>
</nav>

@code {
    private string? _nowPlaying;

    protected override void OnInitialized()
    {
        // Live status: the chip follows whatever the coordinator is actually playing.
        Coordinator.StateChanged += OnPlaybackStateChanged;
        // Re-render so the active nav link tracks navigation.
        Nav.LocationChanged += OnLocationChanged;
        RecomputeNowPlaying();
    }

    private string CurrentPath =>
        Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private bool IsActive(string route) =>
        CurrentPath.Equals(route, StringComparison.OrdinalIgnoreCase) ||
        CurrentPath.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);

    private void RecomputeNowPlaying()
    {
        var active = Coordinator.ActiveScenarioPlayers;
        if (active.Count == 0)
        {
            _nowPlaying = null;
            return;
        }

        var first = active[0];
        var name = first.CurrentItem?.Name ?? first.Scenario.Name;
        _nowPlaying = active.Count > 1 ? $"{name}  +{active.Count - 1}" : name;
    }

    private void OnPlaybackStateChanged()
    {
        // StateChanged may fire off the UI thread (audio callbacks).
        InvokeAsync(() =>
        {
            RecomputeNowPlaying();
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void GoHome() => Nav.NavigateTo("/");
    private void GoToScenarios() => Nav.NavigateTo("scenarios");
    private void GoToSettings() => Nav.NavigateTo("settings");

    public void Dispose()
    {
        Coordinator.StateChanged -= OnPlaybackStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
