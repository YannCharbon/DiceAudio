@* ── Self-contained modal overlay: everything that configures one scenario group ── *@
@if (_visible && Group != null)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.75); z-index:3000; overflow-y:auto;"
     @onclick="Close">
    <div style="background:#2D2D2D; margin:6% auto; max-width:560px; border-radius:12px;
                padding:24px; position:relative;"
         @onclick:stopPropagation="true">

        <MudText Typo="Typo.h6" Style="margin-bottom:4px;">Scenario group settings</MudText>
        <MudText Typo="Typo.body2" Style="color:grey; margin-bottom:18px;">@Group.Name</MudText>

        @* ── Playback ── *@
        <MudText Typo="Typo.subtitle2" Style="margin-bottom:8px;">Playback</MudText>

        <MudSwitch T="bool" Value="Group.StopOtherScenariosOnPlay"
                   ValueChanged="OnStopOthersChanged"
                   Color="Color.Secondary"
                   Label="One scenario at a time" />

        <MudText Typo="Typo.body2" Style="color:grey; margin:2px 0 10px 0;">
            On (the default), starting an item in one scenario of this group fades out
            (@DAScenarioPlayer.HandoverFadeSeconds s) whatever the other scenarios are playing, so a
            single scenario is ever audible. Turn it off and the scenarios layer instead: an ambience
            scenario keeps playing under a music one, and each is stopped on its own.
        </MudText>

        <MudDivider Style="margin:18px 0 14px 0;" />

        @* ── Deletion ── *@
        <MudText Typo="Typo.subtitle2" Style="margin-bottom:8px;">Delete</MudText>

        @if (!_confirmDelete)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="() => _confirmDelete = true">Delete this group</MudButton>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Style="gap:10px; flex-wrap:wrap;">
                <MudText Typo="Typo.body2">
                    Delete “@Group.Name” and its @Group.Scenarios.Count scenario(s)?
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="ConfirmDelete">Delete</MudButton>
                <MudButton Variant="Variant.Text"
                           OnClick="() => _confirmDelete = false">Cancel</MudButton>
            </MudStack>
        }

        <div style="display:flex; margin-top:22px;">
            <div style="flex:1;"></div>
            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="Close">OK</MudButton>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public DAScenarioGroup? Group { get; set; }
    /// <summary>Invoked when the user confirms deletion; the modal closes itself first.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _visible;
    private bool _confirmDelete;

    public void Show()
    {
        _visible = true;
        _confirmDelete = false;
        StateHasChanged();
    }

    void OnStopOthersChanged(bool value)
    {
        if (Group == null) return;
        Group.StopOtherScenariosOnPlay = value;
        StateHasChanged();
    }

    async Task ConfirmDelete()
    {
        _visible = false;
        StateHasChanged();
        await OnDelete.InvokeAsync();
    }

    async Task Close()
    {
        _visible = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }
}
