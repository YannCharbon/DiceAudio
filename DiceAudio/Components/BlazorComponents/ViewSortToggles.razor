@* Compact Big/List and sort toggles, shared by the explorer and the audio
   picker. Meant to sit at the right end of a breadcrumb bar: the icon carries
   the current state, the tooltip spells it out. *@

<div class="da-view-toggles">
    <button type="button" class="da-viewbtn"
            title="@($"Folders are shown as {(FolderView == DAViewMode.Big ? "big cards" : "a list")} — click to switch")"
            @onclick="ToggleFolders">
        <DaIcon Name="@(FolderView == DAViewMode.Big ? "grid-view" : "list")" Size="15" />
        Folders
    </button>

    <button type="button" class="da-viewbtn"
            title="@($"Audio items are shown as {(ItemView == DAViewMode.Big ? "big cards" : "a list")} — click to switch")"
            @onclick="ToggleItems">
        <DaIcon Name="@(ItemView == DAViewMode.Big ? "grid-view" : "list")" Size="15" />
        Items
    </button>

    <button type="button" class="da-viewbtn"
            title="@($"Sorted by {(Sort == DASortMode.Name ? "name" : "the order things were added")} — click to switch")"
            @onclick="ToggleSort">
        @* access-time stands in for Material's Schedule: both are a clock face. *@
        <DaIcon Name="@(Sort == DASortMode.Name ? "sort-alpha" : "access-time")" Size="15" />
        @(Sort == DASortMode.Name ? "Name" : "Added")
    </button>
</div>

@code {
    [Parameter] public DAViewMode FolderView { get; set; }
    [Parameter] public EventCallback<DAViewMode> FolderViewChanged { get; set; }

    [Parameter] public DAViewMode ItemView { get; set; }
    [Parameter] public EventCallback<DAViewMode> ItemViewChanged { get; set; }

    [Parameter] public DASortMode Sort { get; set; }
    [Parameter] public EventCallback<DASortMode> SortChanged { get; set; }

    Task ToggleFolders() =>
        FolderViewChanged.InvokeAsync(FolderView == DAViewMode.Big ? DAViewMode.List : DAViewMode.Big);

    Task ToggleItems() =>
        ItemViewChanged.InvokeAsync(ItemView == DAViewMode.Big ? DAViewMode.List : DAViewMode.Big);

    Task ToggleSort() =>
        SortChanged.InvokeAsync(Sort == DASortMode.Name ? DASortMode.DateAdded : DASortMode.Name);
}
