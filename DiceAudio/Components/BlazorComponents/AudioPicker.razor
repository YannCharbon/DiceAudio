@inject DiceAudioService DAService

@* ── General audio item picker modal.
     Two modes:
       • multi-select — toggles entries in SelectionList (List<DAAudioUsage>)
       • single-select — invokes OnPicked with the chosen item and closes
     Overlay z-index 5000: above the item editor (3000) and scene editor (4800). ── *@
@if (_visible)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.82); z-index:5000; overflow-y:auto;"
     @onclick="Hide">
    <div style="background:var(--s5); margin:3% auto; max-width:960px; border-radius:12px;
                padding:20px 24px; position:relative;"
         @onclick:stopPropagation="true">

        <h2 class="da-h2" style="margin-bottom:14px;">@Title</h2>

        @* ── Search + kind filter ── *@
        <div class="da-irow da-irow-wrap" style="margin-bottom:10px; gap:6px;">
            @* The search field keeps its leading icon and its clear button: the
               box itself is the frame, so the input inside it draws no second one. *@
            <div class="sap-search">
                <DaIcon Name="search" Size="16" Class="da-i-muted" />
                <input class="da-inp" type="text" spellcheck="false" placeholder="Search by name…"
                       aria-label="Search by name" value="@_search"
                       @oninput="@(e => OnSearchChanged(e.Value?.ToString() ?? string.Empty))" />
                @if (!string.IsNullOrEmpty(_search))
                {
                    <button type="button" class="da-ib" title="Clear the search" aria-label="Clear the search"
                            @onclick="@(() => OnSearchChanged(string.Empty))">
                        <DaIcon Name="close" Size="14" />
                    </button>
                }
            </div>

            <button type="button" class="da-btn @(_kinds.Count == 3 ? "da-btn-fill" : "da-btn-out") da-btn-sm"
                    @onclick="SelectAllKinds">All</button>
            @foreach (var kind in new[] { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect })
            {
                var k = kind;
                var narrowed = _kinds.Contains(k) && _kinds.Count < 3;
                @* The kind tint the MudButton's Color carried, taken from the
                   --kc the kind class defines rather than named again here. *@
                <button type="button" class="da-btn @(narrowed ? "da-btn-fill" : "da-btn-out") da-btn-sm @k.KindClass()"
                        style="@(narrowed ? "" : "color:var(--kc); border-color:var(--kc-edge);")"
                        @onclick="() => ToggleKind(k)">
                    <DaIcon Name="@KindIcon(k)" Size="16" />@k.Label()
                </button>
            }

            <button type="button" class="da-btn @(_filterOpen ? "da-btn-fill" : "da-btn-out") da-btn-sm"
                    @onclick="() => _filterOpen = !_filterOpen">
                <DaIcon Name="filter" Size="16" />Tags
            </button>
            @if (_filterTags.Count > 0)
            {
                <button type="button" class="da-btn da-btn-text da-btn-sm" @onclick="() => _filterTags.Clear()">Clear tags</button>
            }
        </div>

        @if (_filterOpen)
        {
            <div style="background:var(--s4); border-radius:8px; padding:10px; margin-bottom:12px;">
                <div class="da-flabel">Type</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryTypeTags())
                    { <button type="button" class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)">@tag</button> }
                </div>
                <div class="da-flabel">Location</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryLocationTags())
                    { <button type="button" class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)">@tag</button> }
                </div>
                <div class="da-flabel">Expression</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryExpressionTags())
                    { <button type="button" class="@FilterChipClass(tag)" @onclick="() => ToggleFilterTag(tag)">@tag</button> }
                </div>
            </div>
        }

        @* ── Folder navigation (hidden while searching — search is global) ── *@
        @* One bar: breadcrumbs on the left, view and sort on the right. *@
        <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap; margin-bottom:8px;">
            @if (string.IsNullOrWhiteSpace(_search))
            {
                @if (_currentFolderName == ".")
                {
                    <span style="font-weight:bold;">Root</span>
                }
                else
                {
                    <span class="da-crumb" @onclick='() => _currentFolderName = "."'>Root</span>
                    @foreach (var crumb in BreadcrumbChain())
                    {
                        var c = crumb;
                        <span style="color:var(--t4);">/</span>
                        @if (c.Name == _currentFolderName)
                        {
                            <span style="font-weight:bold;">@c.Name</span>
                        }
                        else
                        {
                            <span class="da-crumb" @onclick="() => _currentFolderName = c.Name">@c.Name</span>
                        }
                    }
                }
            }
            <ViewSortToggles @bind-FolderView="FolderView" @bind-ItemView="ItemView" @bind-Sort="Sort" />
        </div>

        @if (string.IsNullOrWhiteSpace(_search))
        {
            var folders = SortFolders(DAService.ChildFolders(DAService.FindFolderByName(_currentFolderName))).ToList();

            <div class="@(_folderView == DAViewMode.Big ? "da-grid da-picker-folders" : "da-list") "
                 style="margin-bottom:4px;">
                @foreach (var folder in folders)
                {
                    @(_folderView == DAViewMode.Big ? RenderFolderCard(folder) : RenderFolderRow(folder))
                }
            </div>
        }

        @* ── Audio items grid ── *@
        <div class="@(_itemView == DAViewMode.Big ? "da-grid" : "da-list") da-picker"
             style="max-height:480px; overflow-y:auto;">
            @{
                var visibleItems = FilteredItems().ToList();
            }
            @if (!visibleItems.Any())
            {
                <p class="da-empty" style="padding:20px;">No matching audio items found.</p>
            }
            @foreach (var item in visibleItems)
            {
                @(_itemView == DAViewMode.Big ? RenderItemCard(item) : RenderItemRow(item))
            }
        </div>

        @* ── Footer ── *@
        <div style="display:flex; justify-content:flex-end; margin-top:14px;">
            <button type="button" class="da-btn da-btn-fill" @onclick="async () => await Hide()">
                <DaIcon Name="check" Size="18" />OK
            </button>
        </div>
    </div>
</div>
}

<style>
    /* The item and folder cards come from app.css (.da-card and friends), shared
       with the explorer. What remains here is the search box and the small
       toolbar buttons. */

    /* The box is the field: the input inside it is borderless so there is only
       one frame around the icon, the text and the clear button. */
    .sap-search {
        display: flex; align-items: center; gap: 6px;
        min-width: 240px; flex: 1; height: 32px;
        padding: 0 5px 0 9px;
        background: var(--s2);
        border: 1px solid var(--ctl);
        border-radius: var(--r-btn);
        color: var(--t3);
    }
    .sap-search:focus-within { border-color: var(--a2); }
    .sap-search .da-inp { border: 0; background: transparent; height: 30px; padding: 0; color: var(--t1); }
    .sap-search .da-inp:focus-visible { outline: none; }
    .sap-search .da-ib { width: 24px; height: 24px; }

</style>

@code {
    /// <summary>Multi-select mode: entries are toggled in this list.</summary>
    [Parameter] public List<DAAudioUsage>? SelectionList { get; set; }

    /// <summary>Single-select mode: pick one item, raise OnPicked, close.</summary>
    [Parameter] public bool SingleSelect { get; set; }
    [Parameter] public EventCallback<DAAudioItem> OnPicked { get; set; }

    [Parameter] public string Title { get; set; } = "Pick audio";
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _visible;

    // Items whose player is running, so their card hero animates while playing.
    private readonly HashSet<Guid> _playingIds = new();

    private void SetPlaying(DAAudioItem item, bool playing)
    {
        if (playing) _playingIds.Add(item.Id);
        else _playingIds.Remove(item.Id);
    }

    private string _currentFolderName = ".";
    private string _search = "";
    private bool _filterOpen;
    private readonly List<string> _filterTags = new();
    private HashSet<AudioKind> _kinds = new() { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };

    /// <summary>Opens the picker, optionally pre-filtering to the given kinds.</summary>
    public void Show(IEnumerable<AudioKind>? kinds = null)
    {
        _visible = true;
        // Pick up whatever the explorer was last set to.
        _folderView = DAViewPrefs.FolderView;
        _itemView   = DAViewPrefs.ItemView;
        _sort       = DAViewPrefs.Sort;
        _currentFolderName = ".";
        _search = "";
        _filterOpen = false;
        _filterTags.Clear();
        _kinds = kinds != null && kinds.Any()
            ? new HashSet<AudioKind>(kinds)
            : new HashSet<AudioKind> { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };
        StateHasChanged();
    }

    public async Task Hide()
    {
        _visible = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }

    // Ancestor chain (root-most first) down to the current folder, for breadcrumbs.
    private List<DAVirtualAudioFolder> BreadcrumbChain() =>
        DAService.FolderAncestry(DAService.FindFolderByName(_currentFolderName));


    bool IsAdded(DAAudioItem item) =>
        !SingleSelect && SelectionList != null && SelectionList.Any(u => u.AudioItemId == item.Id);

    string PickTitle(DAAudioItem item) =>
        SingleSelect ? "Click to pick this item"
        : IsAdded(item) ? "Click to remove it from the selection"
        : "Click to add it to the selection";

    RenderFragment RenderItemCard(DAAudioItem item) => __builder =>
    {
        var isSelected = IsAdded(item);
        <article class="da-card @item.Kind.KindClass() @(_playingIds.Contains(item.Id) ? "playing" : "") @(isSelected ? "added" : "")">
                <div class="da-hero" @onclick="() => PickItem(item)"
                     title="@(SingleSelect ? "Click to pick this item"
                              : isSelected ? "Click to remove it from the selection"
                              : "Click to add it to the selection")">
                    @* Inert here (pointer-events:none): the whole hero is one target. *@
                    <button type="button" class="da-kind" tabindex="-1" title="@item.Kind.Label()">
                        <DaIcon Name="@KindIcon(item.Kind)" Size="15" />
                        <span class="da-kind-label">@item.Kind.Label()</span>
                    </button>
                    <div class="da-name" title="@($"{item.Name} — {item.Folder.Name}")">@item.Name</div>
                    @if (!SingleSelect)
                    {
                        <span class="da-pickmark">
                            <DaIcon Name="check" Size="17" />
                        </span>
                    }
                </div>
                <div class="da-body">
                    <div class="da-tags">
                        @foreach (var tag in item.Tags)
                        {
                            <span class="da-chip @tag.CategoryClass()"><span class="da-dot"></span>@tag.Name</span>
                        }
                    </div>
                    @if (item.IsLocallyAvailable)
                    {
                        <MusicPlayer AudioItem="@item"
                                     PlayingChanged="@((bool playing) => SetPlaying(item, playing))" />
                    }
                    else
                    {
                        <div class="da-offline">
                            <DaIcon Name="cloud-download" Size="13" />
                            Not downloaded
                        </div>
                    }
                </div>
            </article>;
    };

    @* One row per item: the whole row is the selection target, and the green
       medallion sits at its right end instead of over the artwork. *@
    RenderFragment RenderItemRow(DAAudioItem item) => __builder =>
    {
        var isSelected = IsAdded(item);

        <div class="da-row @item.Kind.KindClass() @(_playingIds.Contains(item.Id) ? "playing" : "") @(isSelected ? "added" : "")"
             @onclick="() => PickItem(item)" title="@PickTitle(item)">
            <span class="da-row-kind" title="@item.Kind.Label()">
                <DaIcon Name="@KindIcon(item.Kind)" Size="18" />
            </span>
            <div class="da-row-name" title="@($"{item.Name} — {item.Folder.Name}")">@item.Name</div>
            <div class="da-tags">
                @foreach (var tag in item.Tags)
                {
                    <span class="da-chip @tag.CategoryClass()"><span class="da-dot"></span>@tag.Name</span>
                }
            </div>
            <div class="da-row-player" @onclick="() => { }" @onclick:stopPropagation="true">
                @if (item.IsLocallyAvailable)
                {
                    <MusicPlayer AudioItem="@item" Compact="true"
                                 PlayingChanged="@((bool playing) => SetPlaying(item, playing))" />
                }
                else
                {
                    <div class="da-offline">
                        <DaIcon Name="cloud-download" Size="13" />
                        Not downloaded
                    </div>
                }
            </div>
            @if (!SingleSelect)
            {
                <span class="da-pickmark">
                    <DaIcon Name="check" Size="17" />
                </span>
            }
            else
            {
                <span></span>
            }
        </div>;
    };

    RenderFragment RenderFolderRow(DAVirtualAudioFolder folder) => __builder =>
    {
        @* The whole row opens the folder, padding included. *@
        <div class="da-row da-folder-row" @onclick="() => _currentFolderName = folder.Name">
            <button type="button" class="da-folder-tile" title="@folder.Name">
                <DaIcon Name="folder" Size="19" />
            </button>
            <span class="da-row-name" title="@folder.Name">@folder.Name</span>
            <span></span>
        </div>;
    };

    // ── view + sort (shared with the explorer; see DAViewMode.cs) ──────────
    // Backed by the app preferences, and re-read on Show() so the picker always
    // opens on whatever the explorer was last set to.
    private DAViewMode _folderView = DAViewPrefs.FolderView;
    private DAViewMode _itemView   = DAViewPrefs.ItemView;
    private DASortMode _sort       = DAViewPrefs.Sort;

    private DAViewMode FolderView
    {
        get => _folderView;
        set { _folderView = value; DAViewPrefs.FolderView = value; }
    }

    private DAViewMode ItemView
    {
        get => _itemView;
        set { _itemView = value; DAViewPrefs.ItemView = value; }
    }

    private DASortMode Sort
    {
        get => _sort;
        set { _sort = value; DAViewPrefs.Sort = value; }
    }

    private IEnumerable<DAVirtualAudioFolder> SortFolders(IEnumerable<DAVirtualAudioFolder> folders) =>
        _sort == DASortMode.Name
            ? folders.OrderBy(f => f.Name, StringComparer.CurrentCultureIgnoreCase)
            : folders;

    private IEnumerable<DAAudioItem> SortItems(IEnumerable<DAAudioItem> items) =>
        _sort == DASortMode.Name
            ? items.OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase)
            : items;

    private RenderFragment RenderFolderCard(DAVirtualAudioFolder folder) => __builder =>
    {
        <article class="da-card da-folder">
            <div class="da-hero" title="@folder.Name" @onclick="() => _currentFolderName = folder.Name">
                <DaIcon Name="folder" Size="38" Stroke="1.4" />
            </div>
            <div class="da-body"><b>@folder.Name</b></div>
        </article>;
    };

    private IEnumerable<DAAudioItem> FilteredItems()
    {
        var items = DAService.AudioItems.Where(a => _kinds.Contains(a.Kind));

        if (!string.IsNullOrWhiteSpace(_search))
            items = items.Where(a => a.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        else
            items = items.Where(a => a.Folder.Name == _currentFolderName);

        if (_filterTags.Count > 0)
            items = items.Where(a => _filterTags.Any(ft => a.Tags.Any(t => t.Name == ft)));

        return SortItems(items).Take(200);   // hard cap so huge libraries stay responsive
    }

    private async Task PickItem(DAAudioItem item)
    {
        if (SingleSelect)
        {
            await OnPicked.InvokeAsync(item);
            await Hide();
            return;
        }

        if (SelectionList == null) return;
        var existing = SelectionList.FirstOrDefault(u => u.AudioItemId == item.Id);
        if (existing != null) SelectionList.Remove(existing);
        else SelectionList.Add(new DAAudioUsage(item.Id));
    }

    private void OnSearchChanged(string value) => _search = value ?? "";

    private void SelectAllKinds() =>
        _kinds = new HashSet<AudioKind> { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect };

    private void ToggleKind(AudioKind kind)
    {
        // Clicking a kind narrows to it; clicking the active single kind restores all.
        if (_kinds.Count == 1 && _kinds.Contains(kind))
            SelectAllKinds();
        else
            _kinds = new HashSet<AudioKind> { kind };
    }

    private void ToggleFilterTag(string tag)
    {
        if (_filterTags.Contains(tag)) _filterTags.Remove(tag);
        else _filterTags.Add(tag);
    }

    private string FilterChipClass(string tag) =>
        _filterTags.Contains(tag) ? "da-tog da-on" : "da-tog";

    /// <summary>
    /// The house icon for an audio kind. AudioKindExtensions.Icon() still
    /// answers with a Material name because the scene editor reads it, so the
    /// mapping onto <see cref="DaIcon"/>'s set lives here.
    /// </summary>
    private static string KindIcon(AudioKind kind) => kind switch
    {
        AudioKind.Music => "music-note",
        AudioKind.Ambiance => "forest",
        _ => "volume-up",
    };
}
