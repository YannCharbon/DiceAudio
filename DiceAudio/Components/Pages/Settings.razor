@page "/settings"

@implements IDisposable

@inject DiceAudioService AudioService
@inject DAControlServer ControlServer
@inject YtDlpUpdateService YtDlpUpdates

@* Laid out like DiceCombats' settings page, so the two apps' settings read as
   one screen in two colours: a da-h1 title over a da-sub, each section
   introduced by a da-pill, its content on a da-panel with notes a step up the
   surface ramp. What this page carried instead was .settings-group - a flat
   #505050 box with a white glow - and bare bootstrap h3/h5/h6 headings. *@

<h1 class="da-h1">Settings</h1>
<p class="da-sub" style="margin-bottom:18px;">How DiceAudio updates itself, downloads audio and talks to your notes.</p>

<div class="da-stack">

    <div class="da-panel">
        <div style="display:flex;">
            <div class="da-pill">
                <DaIcon Name="sync" Size="26" />
                <h3>Updates</h3>
            </div>
        </div>

        @* The release check is a statement about the app, so it reads as a note
           (--s4 on the panel's --s3) rather than as two stray headings. *@
        <div class="da-note" style="margin-top:14px;">
            @if (_updateAvailable)
            {
                <div class="da-irow" style="gap:9px;">
                    <DaIcon Name="download" Size="18" Class="da-i-info" />
                    <span>DiceAudio <b>@_updateInfos?.tag_name</b> is available.</span>
                </div>
                <div class="da-meta" style="margin-top:7px;">
                    Visit <a href="@_updateInfos?.html_url">@_updateInfos?.html_url</a> to download the update.
                </div>
            }
            else
            {
                <div class="da-irow" style="gap:9px;">
                    <DaIcon Name="check-circle" Size="18" Class="da-i-accent" />
                    <span>DiceAudio is up to date.</span>
                </div>
            }
        </div>
    </div>

    <div class="da-panel">
        <div style="display:flex;">
            <div class="da-pill">
                <DaIcon Name="cloud-download" Size="26" />
                <h3>YouTube downloader (yt-dlp)</h3>
            </div>
        </div>

        @if (!YtDlpUpdateService.IsSupported)
        {
            <p class="da-meta" style="margin-top:14px;">yt-dlp is only available on Windows.</p>
        }
        else
        {
            <div class="da-irow da-irow-wrap" style="gap:14px;margin-top:14px;">
                @if (!_ytDlpVersionRead)
                {
                    <span class="da-tag">Reading version...</span>
                }
                else if (_ytDlpVersion != null)
                {
                    <span class="da-tag" style="color:var(--a2);border-color:var(--a2);">yt-dlp @_ytDlpVersion</span>
                }
                else
                {
                    <span class="da-tag" style="color:var(--danger);border-color:var(--danger);">yt-dlp could not be run</span>
                }

                <label class="da-chk">
                    <input type="checkbox" checked="@_ytDlpAutoUpdate"
                           @onchange="@(e => OnYtDlpAutoUpdateToggled(e.Value is bool b && b))" />
                    <span>Update yt-dlp automatically</span>
                </label>

                @* Works regardless of the switch: an explicit request is an explicit
                   request, and it reports here rather than on the loading screen. *@
                <button type="button" class="da-btn da-btn-out" disabled="@_ytDlpChecking" @onclick="CheckYtDlpNow">
                    <DaIcon Name="sync" />
                    @(_ytDlpChecking ? "Checking..." : "Check now")
                </button>
            </div>

            @if (_ytDlpCheckMessage != null)
            {
                <p style="margin:8px 0 0 0;font-size:13px;color:var(--t2);">@_ytDlpCheckMessage</p>
                @if (_ytDlpCheckPercent is int percent)
                {
                    @* A plain two-div bar: MudProgressLinear was the last Mud
                       control on the page and all it gave was a fill. *@
                    <div style="max-width:320px;margin-top:6px;height:6px;border-radius:var(--r-pill);background:var(--s2);overflow:hidden;"
                         role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                        <div style="height:100%;width:@(percent)%;background:var(--a1);transition:width var(--fx);"></div>
                    </div>
                }
            }

            <p class="da-meta" style="margin-top:10px;line-height:1.55;">
                yt-dlp is the tool that downloads audio from YouTube. YouTube breaks it every few
                weeks, so DiceAudio checks for a newer one at startup, at most twice a day, and shows
                the progress on the loading screen. Turn this off to keep the version you have.
                <br />
                @(YtDlpUpdateService.IsUsingDownloadedBinary
                    ? "In use: a downloaded update."
                    : "In use: the version that shipped with DiceAudio.")
                @if (YtDlpUpdates.LastCheckUtc is DateTime checkedAt)
                {
                    @($" Last checked {checkedAt.ToLocalTime():dd.MM.yyyy HH:mm}.")
                }
                else
                {
                    @(" Not checked yet.")
                }
            </p>
        }
    </div>

    <div class="da-panel">
        <div style="display:flex;">
            <div class="da-pill">
                <DaIcon Name="public" Size="26" />
                <h3>Remote control (Trilium)</h3>
            </div>
        </div>

        @if (!DAControlServer.IsSupported)
        {
            <p class="da-meta" style="margin-top:14px;">Remote control is only available on Windows.</p>
        }
        else
        {
            <div class="da-irow da-irow-wrap" style="gap:14px;margin-top:14px;align-items:flex-end;">
                <label class="da-chk" style="margin-bottom:7px;">
                    <input type="checkbox" checked="@_serverEnabled"
                           @onchange="@(e => OnServerToggled(e.Value is bool b && b))" />
                    <span>Enable HTTP control server</span>
                </label>

                <div class="da-field" style="max-width:130px;">
                    <label class="da-flabel" for="control-port">Port</label>
                    <input class="da-inp" id="control-port" type="number" min="1024" max="65535"
                           value="@_serverPort"
                           @onchange="@(e => OnPortChanged(int.TryParse(e.Value?.ToString(), out var v) ? v : _serverPort))" />
                </div>

                @if (ControlServer.IsRunning)
                {
                    <span class="da-tag" style="color:var(--a3);border-color:var(--a3);margin-bottom:7px;">
                        Running on http://localhost:@ControlServer.Port/
                    </span>
                }
                else if (!string.IsNullOrEmpty(ControlServer.LastError))
                {
                    <span class="da-tag" style="color:var(--danger);border-color:var(--danger);margin-bottom:7px;">@ControlServer.LastError</span>
                }
            </div>

            <p class="da-meta" style="margin-top:10px;line-height:1.55;">
                Lets the Trilium Notes widget (see <code>TriliumPlugin/</code> in the repository) play, stop
                and advance scenario items and scenes from inside your campaign notes.
                The server only listens on localhost.
            </p>
        }
    </div>

    <div class="da-panel" style="margin-bottom:20px;">
        <div style="display:flex;">
            <div class="da-pill">
                <DaIcon Name="text-snippet" Size="26" />
                <h3>About</h3>
            </div>
        </div>

        <div class="da-irow da-irow-wrap" style="gap:13px;margin-top:14px;">
            @* The app's own mark, for the same reason as in DiceCombats: this
               line names the software and its version, so the identifying image
               is the logo, and it carries no tile because the logo has its own
               colours and shape. *@
            <img src="diceaudio_logo.svg" width="46" height="46" alt="" />
            <div class="da-strip-body">
                <div class="da-strip-name">Current software: DiceAudio @AudioService.GetVersion()</div>
                <div class="da-meta">&copy; Copyright Yann Charbon</div>
            </div>
        </div>

        <WelcomeMessage SettingsView="true" NewVersion="true" />
    </div>

</div>

@code {
    private bool _serverEnabled;
    private int _serverPort = DAControlServer.DefaultPort;

    private bool _ytDlpAutoUpdate;
    private string? _ytDlpVersion;
    private bool _ytDlpVersionRead;

    protected override void OnInitialized()
    {
        _serverEnabled = Preferences.Default.Get(DAControlServer.PrefEnabled, false);
        _serverPort = Preferences.Default.Get(DAControlServer.PrefPort, DAControlServer.DefaultPort);
        _ytDlpAutoUpdate = YtDlpUpdates.AutoUpdateEnabled;
    }

    void OnYtDlpAutoUpdateToggled(bool enabled)
    {
        _ytDlpAutoUpdate = enabled;
        YtDlpUpdates.AutoUpdateEnabled = enabled;
    }

    private bool _ytDlpChecking;
    private string? _ytDlpCheckMessage;
    private int? _ytDlpCheckPercent;

    async Task CheckYtDlpNow()
    {
        if (_ytDlpChecking) return;

        _ytDlpChecking = true;
        _ytDlpCheckMessage = null;
        _ytDlpCheckPercent = null;

        // The check outlives the page if the user navigates away mid-download, so
        // every update to the UI has to be skipped once this component is gone.
        var progress = new Progress<YtDlpUpdateProgress>(step =>
        {
            if (_disposed) return;
            _ = InvokeAsync(() =>
            {
                // Checked again here: disposal can happen between the test above
                // and this callback actually running on the dispatcher.
                if (_disposed) return;
                _ytDlpCheckMessage = step.Message;
                _ytDlpCheckPercent = step.Percent;
                StateHasChanged();
            });
        });

        try
        {
            var report = await YtDlpUpdates.CheckAndUpdateAsync(progress);
            _ytDlpCheckMessage = report.Message;
            _ytDlpCheckPercent = null;

            // The binary may have just been replaced, so re-read what runs now.
            _ytDlpVersion = await YtDlpUpdates.ReadInstalledVersionAsync();
            _ytDlpVersionRead = true;
        }
        catch (Exception ex)
        {
            _ytDlpCheckMessage = $"yt-dlp check failed: {ex.Message}";
            _ytDlpCheckPercent = null;
        }
        finally
        {
            _ytDlpChecking = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private bool _disposed;

    public void Dispose() => _disposed = true;

    void OnServerToggled(bool enabled)
    {
        _serverEnabled = enabled;
        Preferences.Default.Set(DAControlServer.PrefEnabled, enabled);
        if (enabled) ControlServer.Start(_serverPort);
        else ControlServer.Stop();
    }

    void OnPortChanged(int port)
    {
        _serverPort = port;
        Preferences.Default.Set(DAControlServer.PrefPort, port);
        if (_serverEnabled) ControlServer.Start(port);   // restart on the new port
    }

    private bool _updateAvailable = false;
    private GitHubRelease? _updateInfos = null;

    // Everything here runs once per visit. It used to run on every render, and
    // because it ends in StateHasChanged that render triggered another one: an
    // endless loop that hammered the GitHub API until the hourly limit for the
    // IP was used up (after which api.github.com answers 403 to everything).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _updateInfos = await AudioService.CheckUpdate();
        if (_updateInfos != null)
        {
            _updateAvailable = (AudioService.GetVersion() != _updateInfos?.tag_name);
        }

        // Spawns yt-dlp, so it happens after the first render rather than
        // holding the page back.
        _ytDlpVersion = await YtDlpUpdates.ReadInstalledVersionAsync();
        _ytDlpVersionRead = true;

        StateHasChanged();
    }
}
