@inject DiceAudioService DAService

@* ── Self-contained modal overlay: everything that configures one scenario group ── *@
@if (_visible && Group != null)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.75); z-index:3000; overflow-y:auto;"
     @onclick="Close">
    <div style="background:#2D2D2D; margin:6% auto; max-width:560px; border-radius:12px;
                padding:24px; position:relative;"
         @onclick:stopPropagation="true">

        <h4 style="margin-bottom:4px;">Scenario group settings</h4>
        <p class="da-sub" style="margin-bottom:18px;">@Group.Name</p>

        @* ── Collection ── *@
        <h5 style="margin:0 0 8px;">Collection</h5>

        @* Free text: picking an existing collection or typing a brand new one both
           just set the group's Collection, and clearing it takes the group back out.
           A datalist carries MudAutocomplete's suggestions — and its filtering,
           which the browser does as the user types — without the widget. *@
        <label class="da-field">
            <span class="da-flabel">Collection</span>
            <span style="position:relative; display:block;">
                <input class="da-inp" type="text" list="scg-collections" spellcheck="false"
                       style="padding-right:@(Group.Collection.Length > 0 ? "60px" : "32px");"
                       placeholder="Leave empty to keep this group on its own"
                       value="@Group.Collection"
                       @onchange="@(e => OnCollectionChanged(e.Value?.ToString() ?? string.Empty))" />
                @if (Group.Collection.Length > 0)
                {
                    <button type="button" class="da-ib" title="Clear" aria-label="Clear"
                            style="position:absolute; right:30px; top:50%; transform:translateY(-50%);
                                   width:28px; height:28px;"
                            @onclick="() => OnCollectionChanged(string.Empty)">
                        <DaIcon Name="close" Size="14" />
                    </button>
                }
                <span style="position:absolute; right:9px; top:50%; transform:translateY(-50%);
                             color:var(--t3); pointer-events:none; display:inline-flex;">
                    <DaIcon Name="folder-open" />
                </span>
            </span>
        </label>
        <datalist id="scg-collections">
            @foreach (var collection in DAService.GetCollections())
            {
                <option value="@collection"></option>
            }
        </datalist>

        <p class="da-sub" style="margin:6px 0 10px 0;">
            Files this group with the others of the same collection — one adventure, season
            or show — so the scenarios explorer lists them together in a folder instead of
            all groups side by side. A collection exists as long as one group names it.
        </p>

        <hr style="border:0; border-top:1px solid var(--b1); margin:18px 0 14px 0;" />

        @* ── Playback ── *@
        <h5 style="margin:0 0 8px;">Playback</h5>

        @* The switch becomes the app's own tick box: both carried the same on/off
           meaning and the tick box is the one shape the set draws. *@
        <label class="da-chk">
            <input type="checkbox" checked="@Group.StopOtherScenariosOnPlay"
                   @onchange="@(e => OnStopOthersChanged(e.Value is bool on && on))" />
            One scenario at a time
        </label>

        <p class="da-sub" style="margin:2px 0 10px 0;">
            On (the default), starting an item in one scenario of this group fades out
            (@DAScenarioPlayer.HandoverFadeSeconds s) whatever the other scenarios are playing, so a
            single scenario is ever audible. Turn it off and the scenarios layer instead: an ambience
            scenario keeps playing under a music one, and each is stopped on its own.
        </p>

        <hr style="border:0; border-top:1px solid var(--b1); margin:18px 0 14px 0;" />

        @* ── Deletion ── *@
        <h5 style="margin:0 0 8px;">Delete</h5>

        @if (!_confirmDelete)
        {
            <button type="button" class="da-btn da-btn-danger" @onclick="() => _confirmDelete = true">
                <DaIcon Name="delete" Size="16" />
                Delete this group
            </button>
        }
        else
        {
            <div class="da-irow da-irow-wrap" style="gap:10px;">
                <span>
                    Delete “@Group.Name” and its @Group.Scenarios.Count scenario(s)?
                </span>
                <button type="button" class="da-btn da-btn-danger" @onclick="ConfirmDelete">
                    <DaIcon Name="delete" Size="16" />
                    Delete
                </button>
                <button type="button" class="da-btn da-btn-text" @onclick="() => _confirmDelete = false">
                    Cancel
                </button>
            </div>
        }

        <div style="display:flex; margin-top:22px;">
            <div style="flex:1;"></div>
            <button type="button" class="da-btn da-btn-fill" @onclick="Close">
                <DaIcon Name="check" Size="16" />
                OK
            </button>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public DAScenarioGroup? Group { get; set; }
    /// <summary>Invoked when the user confirms deletion; the modal closes itself first.</summary>
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _visible;
    private bool _confirmDelete;

    public void Show()
    {
        _visible = true;
        _confirmDelete = false;
        StateHasChanged();
    }

    async Task OnCollectionChanged(string collection)
    {
        if (Group == null) return;
        // Saved right away: the explorer reads the collections back from the
        // groups, and a rename of the group itself is saved by its own Save button.
        await DAService.SetGroupCollectionAsync(Group, collection);
        StateHasChanged();
    }

    // MudAutocomplete's SearchFunc went with the widget: the datalist above
    // offers every collection and the browser narrows it as the user types.

    void OnStopOthersChanged(bool value)
    {
        if (Group == null) return;
        Group.StopOtherScenariosOnPlay = value;
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    async Task ConfirmDelete()
    {
        _visible = false;
        StateHasChanged();
        await OnDelete.InvokeAsync();
    }

    async Task Close()
    {
        _visible = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }
}
