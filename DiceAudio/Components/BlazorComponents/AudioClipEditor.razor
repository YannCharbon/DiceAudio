@using Plugin.Maui.Audio
@inject IAudioManager AudioManager
@inject DiceAudioService AudioFiles
@inject IJSRuntime JS
@implements IDisposable

<style>
    .ace-wave-box {
        position: relative;
        height: 110px;
        background: var(--s1);
        border: 1px solid var(--b1);
        border-radius: 8px;
        overflow: hidden;
        margin: 10px 0 2px 0;
    }
    /* Inset by half a handle width: a range thumb's centre can only travel between
       6px and width-6px, so the waveform is drawn over exactly that span. Without
       this the cut lines and the audio under them disagree by up to half a handle.

       width/height MUST stay explicit. A canvas is a replaced element, so `auto`
       resolves to its intrinsic size — the width/height attributes the draw code
       sets from clientWidth * devicePixelRatio. That closes a feedback loop where
       every redraw scales the element up by the pixel ratio, until the WebView
       renderer dies. */
    .ace-canvas {
        position: absolute; top: 0; left: 6px;
        width: calc(100% - 12px); height: 100%;
    }
    .ace-shade  { position: absolute; top: 0; bottom: 0; background: rgba(0,0,0,0.65); pointer-events: none; }
    .ace-playhead {
        position: absolute; top: 0; bottom: 0; width: 2px;
        background: #ffd166; pointer-events: none;
        box-shadow: 0 0 6px rgba(255,209,102,0.9);
    }
    .ace-slider {
        position: absolute; inset: 0; width: 100%; height: 100%; margin: 0;
        -webkit-appearance: none; appearance: none;
        background: transparent; pointer-events: none;
    }
    .ace-slider::-webkit-slider-runnable-track { background: transparent; }
    /* Handles stay translucent so the waveform under them keeps reading, and go
       nearly clear while dragged — that is the moment the detail matters most. */
    .ace-slider::-webkit-slider-thumb {
        -webkit-appearance: none; appearance: none;
        pointer-events: auto; cursor: ew-resize;
        width: 12px; height: 108px; border-radius: 4px;
        border: 1px solid rgba(255,255,255,0.35);
        background: rgba(231,60,126,0.55);
        box-shadow: 0 0 4px rgba(0,0,0,0.6);
        transition: background 0.1s;
    }
    .ace-slider:hover::-webkit-slider-thumb  { background: rgba(231,60,126,0.35); }
    .ace-slider:active::-webkit-slider-thumb { background: rgba(231,60,126,0.15); }

    .ace-slider-end::-webkit-slider-thumb        { background: rgba(35,166,171,0.55); }
    .ace-slider-end:hover::-webkit-slider-thumb  { background: rgba(35,166,171,0.35); }
    .ace-slider-end:active::-webkit-slider-thumb { background: rgba(35,166,171,0.15); }

    /* A handle whose bound sits outside the zoomed view, parked on the nearest
       edge. Still grabbable — dragging it brings the bound into the view. */
    .ace-slider-off::-webkit-slider-thumb {
        border-style: dashed;
        border-color: rgba(255,255,255,0.65);
    }

    /* The exact cut, drawn down the middle of the handle. */
    .ace-cut {
        position: absolute; top: 0; bottom: 0;
        width: 2px; margin-left: -1px; pointer-events: none;
    }
    .ace-cut-start { background: #ff5fa2; box-shadow: 0 0 5px rgba(255,95,162,0.95); }
    .ace-cut-end   { background: #3fd9d9; box-shadow: 0 0 5px rgba(63,217,217,0.95); }

    /* ── Control panel below the waveform ── */
    .ace-panel {
        background: var(--s4);
        border: 1px solid var(--b1);
        border-radius: 8px;
        padding: 4px 12px;
        margin-top: 10px;
    }
    .ace-row {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        padding: 10px 0;
    }
    .ace-row + .ace-row { border-top: 1px solid var(--b1); }
    .ace-spacer { flex: 1 1 auto; }

    .ace-readout {
        font-size: 12px; color: var(--t3); font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    /* Fixed width so Bounds / Edges / Preview form one column and every row's
       controls start on the same vertical line. */
    .ace-label {
        flex: 0 0 62px;
        font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--t4); white-space: nowrap;
    }

    /* Checkbox + its own caption: MudBlazor's built-in label renders at body1
       (16px), which towered over the field labels around it. */
    /* The box is a bare .da-chk now, which brings no padding of its own, so
       the gap the control used to supply is declared here. */
    .ace-toggle { display: inline-flex; align-items: center; gap: 7px; }
    .ace-toggle-name {
        font-size: 13px; color: var(--t2); cursor: pointer; user-select: none;
        white-space: nowrap;
    }
    .ace-toggle-name-off { color: var(--t4); }
    .ace-fade-group { display: inline-flex; align-items: center; gap: 8px; }

    /* Zoom / scroll furniture */
    .ace-toolbar {
        display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
        margin-top: 6px;
    }
    .ace-view-range {
        display: flex; justify-content: space-between;
        font-size: 11px; color: var(--t4); font-variant-numeric: tabular-nums;
        padding: 0 2px;
    }
    .ace-zoom-hint { font-size: 11px; color: var(--t4); margin-left: auto; }

</style>

@if (_visible && Usage != null && Item != null)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.85); z-index:5200; overflow-y:auto;"
     @onclick="CloseAsync">
    <div style="background:var(--s5); margin:5% auto; max-width:720px; border-radius:12px;
                padding:22px 26px; position:relative;"
         @onclick:stopPropagation="true">

        <h2 class="da-h2" style="margin-bottom:4px;">Track settings</h2>
        <p class="da-sub" style="margin-bottom:12px;">@Item.Name</p>

        @* ── Volume ── *@
        <div class="da-flabel">Volume: @Usage.Volume.ToString("P0")</div>
        @* --pp fills the track up to the thumb, the same way the music player's
           seek bar does. *@
        <input type="range" class="da-range" min="0" max="1" step="0.01"
               style="margin-bottom:8px; --pp:@Pct(Usage.Volume);"
               aria-label="Volume" value="@Inv(Usage.Volume)"
               @oninput="@(e => Usage.Volume = ParseD(e.Value, Usage.Volume))" />

        @if (ShowSceneSettings)
        {
            <div class="da-irow da-irow-wrap" style="gap:18px; margin-bottom:8px;">
                <label class="da-chk">
                    <input type="checkbox" checked="@Usage.Loop"
                           @onchange="@(e => Usage.Loop = e.Value is bool v && v)" />
                    Loop
                </label>
                @* Distinct from the clip-edge ramps below: these apply when the layer
                   itself is brought in or taken out, not at the clip's own bounds. *@
                <div class="da-field">
                    <span class="da-flabel">Layer fade-in (s)</span>
                    <div class="da-step">
                        <button type="button" @onclick="@(() => Usage.FadeInSeconds = Math.Max(0, Usage.FadeInSeconds - 1))">&minus;</button>
                        <input type="number" value="@Inv(Usage.FadeInSeconds)" min="0" step="1"
                               @onchange="@(e => Usage.FadeInSeconds = Math.Max(0, ParseD(e.Value, Usage.FadeInSeconds)))" />
                        <button type="button" @onclick="@(() => Usage.FadeInSeconds = Math.Max(0, Usage.FadeInSeconds + 1))">+</button>
                    </div>
                </div>
                <div class="da-field">
                    <span class="da-flabel">Layer fade-out (s)</span>
                    <div class="da-step">
                        <button type="button" @onclick="@(() => Usage.FadeOutSeconds = Math.Max(0, Usage.FadeOutSeconds - 1))">&minus;</button>
                        <input type="number" value="@Inv(Usage.FadeOutSeconds)" min="0" step="1"
                               @onchange="@(e => Usage.FadeOutSeconds = Math.Max(0, ParseD(e.Value, Usage.FadeOutSeconds)))" />
                        <button type="button" @onclick="@(() => Usage.FadeOutSeconds = Math.Max(0, Usage.FadeOutSeconds + 1))">+</button>
                    </div>
                </div>
            </div>
        }

        @* ── Clip region ── *@
        <div class="da-irow" style="gap:8px; margin-top:6px;">
            <DaIcon Name="cut" Size="16" Class="da-i-accent" />
            <span style="font-size:14px; font-weight:600;">Clip (non-destructive — the file is never modified)</span>
        </div>

        @if (_fileDuration <= 0)
        {
            <div style="color:var(--danger); padding:8px 0; font-size:13px;">
                Audio file unavailable — cannot edit the clip.
            </div>
        }
        else
        {
            <div class="ace-wave-box" @onclick="OnWaveClick"
                 @onwheel="OnWaveWheel" @onwheel:preventDefault="true"
                 title="@(_previewPlayer?.IsPlaying == true
                          ? "Click to seek the preview · scroll to zoom"
                          : "Scroll to zoom around the pointer")">
                <canvas id="@_canvasId" class="ace-canvas"></canvas>

                @{
                    bool startInView = IsInView(ClipStartValue);
                    bool endInView = IsInView(ClipEndValue);
                }

                @* Shading outside the selected region (positions must be culture-invariant CSS) *@
                <div class="ace-shade" style="left:0; width:@TrackPos(ClipStartValue);"></div>
                <div class="ace-shade" style="left:@TrackPos(ClipEndValue); right:0;"></div>

                @if (_previewPlayer != null && _previewPlayer.IsPlaying && IsInView(ClipStartValue + _previewPosition))
                {
                    <div class="ace-playhead" style="left:@TrackPos(ClipStartValue + _previewPosition);"></div>
                }

                @* The exact cut lines, down the middle of each handle. Only drawn for a
                   bound that is actually in view — a parked handle sits on the edge, not
                   where its bound really is, and a line there would lie about the cut. *@
                @if (startInView)
                {
                    <div class="ace-cut ace-cut-start" style="left:@TrackPos(ClipStartValue);"></div>
                }
                @if (endInView)
                {
                    <div class="ace-cut ace-cut-end" style="left:@TrackPos(ClipEndValue);"></div>
                }

                @* Dual-thumb range (two overlaid native sliders), spanning the visible
                   window rather than the whole file — that is what makes the handles
                   precise once zoomed in. Both are always rendered: a bound outside the
                   view parks its handle on the nearest edge, still grabbable, and
                   dragging it walks the bound back into the view.
                   Only the thumbs take pointer events, so the track never jumps on a
                   stray click. stopPropagation: releasing a thumb must not seek. *@
                <input type="range" class="ace-slider @(startInView ? "" : "ace-slider-off")"
                       min="0" max="@SliderSteps" step="1"
                       value="@SliderValue(ClipStartValue)" @oninput="OnStartSliderInput"
                       @onclick:stopPropagation="true"
                       title="@(startInView
                                ? "Clip start — drag to move"
                                : "Clip start is outside the view — drag to bring it here")" />

                <input type="range" class="ace-slider ace-slider-end @(endInView ? "" : "ace-slider-off")"
                       min="0" max="@SliderSteps" step="1"
                       value="@SliderValue(ClipEndValue)" @oninput="OnEndSliderInput"
                       @onclick:stopPropagation="true"
                       title="@(endInView
                                ? "Clip end — drag to move"
                                : "Clip end is outside the view — drag to bring it here")" />
            </div>

            <div class="ace-view-range">
                <span>@FormatTime(_viewStart)</span>
                <span>@FormatTime(ViewEnd)</span>
            </div>

            @* Horizontal scroll over the file; only meaningful once zoomed in. *@
            @if (IsZoomed)
            {
                <input type="range" class="da-range" min="0" max="1" step="0.0005"
                       style="margin:0 2px; --pp:@Pct(ScrollFraction);"
                       aria-label="Scroll the view over the file" value="@Inv(ScrollFraction)"
                       @oninput="@(e => OnScrollChanged(ParseD(e.Value, ScrollFraction)))" />
            }

            <div class="ace-toolbar">
                <button type="button" class="da-ib" title="Zoom out" aria-label="Zoom out"
                        disabled="@(!IsZoomed)" @onclick="() => ZoomByAroundCentre(0.5)">
                    <DaIcon Name="zoom-out" Size="18" />
                </button>
                <button type="button" class="da-ib" title="Zoom in" aria-label="Zoom in"
                        disabled="@(_viewDuration <= MinViewDuration + 1e-6)"
                        @onclick="() => ZoomByAroundCentre(2)">
                    <DaIcon Name="zoom-in" Size="18" />
                </button>
                <button type="button" class="da-btn da-btn-text da-btn-sm" @onclick="ZoomToClip">
                    <DaIcon Name="center-focus" Size="16" />Zoom to clip
                </button>
                <button type="button" class="da-btn da-btn-text da-btn-sm"
                        disabled="@(!IsZoomed)" @onclick="ZoomFit">
                    <DaIcon Name="fit-screen" Size="16" />Whole track
                </button>
                <span class="ace-zoom-hint">
                    showing @FormatTime(_viewDuration) of @FormatTime(_fileDuration)
                </span>
            </div>

            <div class="ace-panel">

                @* Bounds *@
                <div class="ace-row">
                    <span class="ace-label">Bounds</span>
                    <div class="da-field">
                        <span class="da-flabel">Start (s)</span>
                        <div class="da-step da-step-wide">
                            <button type="button" @onclick="@(() => SetClipStart(ClipStartValue - 0.05))">&minus;</button>
                            <input type="number" value="@Inv(ClipStartValue, "F2")"
                                   min="0" max="@Inv(_fileDuration)" step="0.05"
                                   @onchange="@(e => SetClipStart(ParseD(e.Value, ClipStartValue)))" />
                            <button type="button" @onclick="@(() => SetClipStart(ClipStartValue + 0.05))">+</button>
                        </div>
                    </div>
                    <div class="da-field">
                        <span class="da-flabel">End (s)</span>
                        <div class="da-step da-step-wide">
                            <button type="button" @onclick="@(() => SetClipEnd(ClipEndValue - 0.05))">&minus;</button>
                            <input type="number" value="@Inv(ClipEndValue, "F2")"
                                   min="0" max="@Inv(_fileDuration)" step="0.05"
                                   @onchange="@(e => SetClipEnd(ParseD(e.Value, ClipEndValue)))" />
                            <button type="button" @onclick="@(() => SetClipEnd(ClipEndValue + 0.05))">+</button>
                        </div>
                    </div>
                    <span class="ace-spacer"></span>
                    <span class="ace-readout">
                        @FormatTime(ClipEndValue - ClipStartValue) of @FormatTime(_fileDuration)
                    </span>
                    <button type="button" class="da-ib"
                            title="Reset the clip to the whole track"
                            aria-label="Reset the clip to the whole track"
                            @onclick="ResetClip">
                        <DaIcon Name="restore" Size="18" />
                    </button>
                </div>

                @* Edge fades. Both fields stay mounted and disable when off, so
                   toggling never reflows the row. *@
                <div class="ace-row">
                    <span class="ace-label">Edges</span>

                    <div class="ace-fade-group">
                        <span class="ace-toggle">
                            @* The label carries only the box: the name beside it is
                               its own click target, as it already was. *@
                            <label class="da-chk" aria-label="Fade in">
                                <input type="checkbox" checked="@(Usage.ClipFadeInSeconds != null)"
                                       @onchange="@(e => ToggleClipFadeIn(e.Value is bool v && v))" />
                            </label>
                            <span class="ace-toggle-name @(Usage.ClipFadeInSeconds == null ? "ace-toggle-name-off" : "")"
                                  @onclick="() => ToggleClipFadeIn(Usage.ClipFadeInSeconds == null)">Fade in</span>
                        </span>
                        <div class="da-field">
                            <span class="da-flabel">Seconds</span>
                            <div class="da-step da-step-wide">
                                <button type="button" disabled="@(Usage.ClipFadeInSeconds == null)"
                                        @onclick="@(() => SetClipFadeIn((Usage.ClipFadeInSeconds ?? DefaultClipFadeSeconds) - 0.1))">&minus;</button>
                                <input type="number" value="@Inv(Usage.ClipFadeInSeconds ?? DefaultClipFadeSeconds, "F2")"
                                       disabled="@(Usage.ClipFadeInSeconds == null)"
                                       min="0" max="@Inv(_fileDuration)" step="0.1"
                                       @onchange="@(e => SetClipFadeIn(ParseD(e.Value, Usage.ClipFadeInSeconds ?? DefaultClipFadeSeconds)))" />
                                <button type="button" disabled="@(Usage.ClipFadeInSeconds == null)"
                                        @onclick="@(() => SetClipFadeIn((Usage.ClipFadeInSeconds ?? DefaultClipFadeSeconds) + 0.1))">+</button>
                            </div>
                        </div>
                    </div>

                    <div class="ace-fade-group">
                        <span class="ace-toggle">
                            <label class="da-chk" aria-label="Fade out">
                                <input type="checkbox" checked="@(Usage.ClipFadeOutSeconds != null)"
                                       @onchange="@(e => ToggleClipFadeOut(e.Value is bool v && v))" />
                            </label>
                            <span class="ace-toggle-name @(Usage.ClipFadeOutSeconds == null ? "ace-toggle-name-off" : "")"
                                  @onclick="() => ToggleClipFadeOut(Usage.ClipFadeOutSeconds == null)">Fade out</span>
                        </span>
                        <div class="da-field">
                            <span class="da-flabel">Seconds</span>
                            <div class="da-step da-step-wide">
                                <button type="button" disabled="@(Usage.ClipFadeOutSeconds == null)"
                                        @onclick="@(() => SetClipFadeOut((Usage.ClipFadeOutSeconds ?? DefaultClipFadeSeconds) - 0.1))">&minus;</button>
                                <input type="number" value="@Inv(Usage.ClipFadeOutSeconds ?? DefaultClipFadeSeconds, "F2")"
                                       disabled="@(Usage.ClipFadeOutSeconds == null)"
                                       min="0" max="@Inv(_fileDuration)" step="0.1"
                                       @onchange="@(e => SetClipFadeOut(ParseD(e.Value, Usage.ClipFadeOutSeconds ?? DefaultClipFadeSeconds)))" />
                                <button type="button" disabled="@(Usage.ClipFadeOutSeconds == null)"
                                        @onclick="@(() => SetClipFadeOut((Usage.ClipFadeOutSeconds ?? DefaultClipFadeSeconds) + 0.1))">+</button>
                            </div>
                        </div>
                    </div>

                    <span class="ace-spacer"></span>
                    @* The tooltip MudTooltip carried. A title attribute on an <svg>
                       is not a tooltip, so the wrapper holds it. *@
                    <span title="A cut rarely lands on a zero crossing, which is what clicks. These ramps apply wherever this clip plays, and on every loop.">
                        <DaIcon Name="help" Size="17" style="color:var(--t4);" />
                    </span>
                </div>

                @* Preview *@
                <div class="ace-row">
                    <span class="ace-label">Preview</span>

                    @if (_previewPlayer != null && _previewPlayer.IsPlaying)
                    {
                        <div class="da-cmd-btn" @onclick="StopPreview" title="Stop preview">
                            <DaIcon Name="stop" Size="20" Class="da-stop" Filled="true" />
                        </div>
                        <span class="ace-readout">
                            @FormatTime(_previewPosition) / @FormatTime(ClipEndValue - ClipStartValue)
                            — click the waveform to seek
                        </span>
                    }
                    else
                    {
                        <div class="da-cmd-btn" @onclick="StartPreview" title="Preview the clip">
                            <DaIcon Name="play" Size="22" Class="da-play" Filled="true" />
                        </div>
                        <span class="ace-readout">Plays the selected region only</span>
                    }

                    <span class="ace-spacer"></span>
                    <span class="ace-toggle">
                        <label class="da-chk" aria-label="Loop the selection">
                            <input type="checkbox" checked="@_previewLoop"
                                   @onchange="@(e => OnPreviewLoopChanged(e.Value is bool v && v))" />
                        </label>
                        <span class="ace-toggle-name @(_previewLoop ? "" : "ace-toggle-name-off")"
                              @onclick="() => OnPreviewLoopChanged(!_previewLoop)">Loop the selection</span>
                    </span>
                </div>
            </div>
        }

        @* ── Footer ── *@
        <div style="display:flex; justify-content:flex-end; margin-top:18px;">
            <button type="button" class="da-btn da-btn-fill" @onclick="CloseAsync">
                <DaIcon Name="check" Size="18" />OK
            </button>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public EventCallback OnClosed { get; set; }
    /// <summary>Shows loop/fade fields (used when editing a scene layer).</summary>
    [Parameter] public bool ShowSceneSettings { get; set; }

    public DAAudioUsage? Usage { get; private set; }
    public DAAudioItem? Item { get; private set; }

    private bool _visible;
    private double _fileDuration;
    private readonly string _canvasId = $"ace-wave-{Guid.NewGuid():N}";

    // ── Zoomed view over the file ───────────────────────────────────────────
    // Everything on the waveform — bars, shading, playhead, handles, clicks — is
    // expressed against this window, which is what makes editing an hour-long
    // track practical: at full zoom-out a pixel is seconds, zoomed in it is
    // milliseconds.
    private double _viewStart;
    private double _viewDuration;
    /// <summary>Canvas width in CSS pixels, cached to convert pointer offsets without a round trip.</summary>
    private double _waveWidthPx;

    private double ViewEnd => _viewStart + _viewDuration;
    private bool IsZoomed => _fileDuration > 0 && _viewDuration < _fileDuration - 1e-6;
    /// <summary>Deepest zoom. Below a couple of seconds the peak data has nothing left to show.</summary>
    private double MinViewDuration => Math.Min(_fileDuration, 2.0);

    private float[]? _peaks;
    private bool _peaksLoaded;
    private bool _needsRedraw;

    private DAAudioPlayer? _previewPlayer;
    private double _previewPosition;
    private readonly System.Timers.Timer _previewTicker = new(100);

    protected override void OnInitialized()
    {
        _previewTicker.Elapsed += (_, _) =>
        {
            if (_previewPlayer?.IsPlaying == true)
            {
                _previewPosition = _previewPlayer.CurrentPosition;
                InvokeAsync(StateHasChanged);
            }
        };
    }

    private double ClipStartValue => Usage?.ClipStartSeconds ?? 0;
    private double ClipEndValue => Usage?.ClipEndSeconds ?? _fileDuration;

    // Position within the visible window as a 0..1 fraction, clamped — an
    // out-of-view bound pins to an edge, which is what the shading and the parked
    // handles both want.
    private double Fraction(double seconds) =>
        _viewDuration <= 0 ? 0 : Math.Clamp((seconds - _viewStart) / _viewDuration, 0, 1);

    private bool IsInView(double seconds) =>
        seconds >= _viewStart - 1e-6 && seconds <= ViewEnd + 1e-6;

    // The handles resolve the visible window into a fixed number of steps, so the
    // precision they offer follows the zoom instead of the file length.
    private const int SliderSteps = 2000;

    private int SliderValue(double seconds) => (int)Math.Round(Fraction(seconds) * SliderSteps);

    private double SecondsFromSlider(double rawStep) =>
        _viewStart + Math.Clamp(rawStep / SliderSteps, 0, 1) * _viewDuration;

    /// <summary>Width of a range thumb in CSS pixels; must match the stylesheet.</summary>
    private const int HandleWidthPx = 12;

    /// <summary>
    /// Where a moment sits inside the waveform box, expressed the way the browser
    /// lays a range thumb out: the thumb never overhangs the track, so its centre
    /// runs from half a thumb in to half a thumb short of the end, not 0%..100%.
    /// Positioning the shading, the cut lines and the playhead with the same
    /// formula is what keeps them on the very pixel the handle is on — at full
    /// zoom-out the naive percentage was off by up to half a thumb, which is
    /// several seconds on an hour-long track.
    /// Built culture-invariantly: fr-FR would emit "0,42", which browsers drop.
    /// </summary>
    private string TrackPos(double seconds)
    {
        var fraction = Fraction(seconds)
            .ToString("F5", System.Globalization.CultureInfo.InvariantCulture);
        return $"calc({HandleWidthPx / 2}px + (100% - {HandleWidthPx}px) * {fraction})";
    }

    /// <summary>
    /// A number written for an HTML attribute. The whole file is careful about
    /// this already (see TrackPos): fr-FR would emit "0,42", which a browser
    /// drops on the floor — and a range input would snap back to its minimum.
    /// </summary>
    private static string Inv(double value, string format = "0.####") =>
        value.ToString(format, System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>A 0..1 fraction as a CSS percentage, for a range track's fill.</summary>
    private static string Pct(double fraction) =>
        (Math.Clamp(fraction, 0, 1) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>Reads back what a number input holds, keeping the old value if it holds nothing.</summary>
    private static double ParseD(object? raw, double fallback) =>
        double.TryParse(raw?.ToString(), System.Globalization.NumberStyles.Any,
                        System.Globalization.CultureInfo.InvariantCulture, out var parsed)
            ? parsed : fallback;

    private static string FormatTime(double seconds)
    {
        var span = TimeSpan.FromSeconds(Math.Max(0, seconds));
        // mm is minutes-within-the-hour: without this an hour-long track reads 00:00.
        return span.TotalHours >= 1
            ? span.ToString(@"h\:mm\:ss\.f")
            : span.ToString(@"mm\:ss\.f");
    }

    public void Show(DAAudioUsage usage, DAAudioItem item)
    {
        Usage = usage;
        Item = item;
        _visible = true;
        _peaks = null;
        _peaksLoaded = false;
        _needsRedraw = false;
        _waveWidthPx = 0;
        _fileDuration = 0;
        _viewStart = 0;
        _viewDuration = 0;
        _previewPosition = 0;

        var playablePath = AudioFiles.GetPlayablePath(item.LocalFileName);
        if (playablePath != null)
        {
            try
            {
                // A throw-away player just to read the file duration.
                using var probe = DAAudioPlayer.Create(playablePath, AudioManager);
                _fileDuration = probe.FileDuration;
            }
            catch { _fileDuration = 0; }

            _viewStart = 0;
            _viewDuration = _fileDuration;
            _ = ComputePeaksAsync(playablePath);
        }

        StateHasChanged();
    }

    async Task CloseAsync()
    {
        StopPreview();
        _visible = false;
        _peaksLoaded = false;
        try { await JS.InvokeVoidAsync("daWaveform.unload", _canvasId); }
        catch { /* page already gone — nothing to release */ }
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }

    // ── Clip bound updates ──────────────────────────────────────────────────

    void OnStartSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var step))
            SetClipStart(SecondsFromSlider(step));
    }

    void OnEndSliderInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any,
                            System.Globalization.CultureInfo.InvariantCulture, out var step))
            SetClipEnd(SecondsFromSlider(step));
    }

    void SetClipStart(double seconds)
    {
        if (Usage == null) return;
        seconds = Math.Clamp(seconds, 0, Math.Max(0, ClipEndValue - 0.1));
        Usage.ClipStartSeconds = seconds <= 0 ? null : seconds;
        SyncPreviewBounds();
    }

    void SetClipEnd(double seconds)
    {
        if (Usage == null) return;
        seconds = Math.Clamp(seconds, ClipStartValue + 0.1, _fileDuration);
        Usage.ClipEndSeconds = seconds >= _fileDuration - 0.05 ? null : seconds;
        SyncPreviewBounds();
    }

    void ResetClip()
    {
        if (Usage == null) return;
        Usage.ClipStartSeconds = null;
        Usage.ClipEndSeconds = null;
        SyncPreviewBounds();
    }

    // ── Clip edge ramps ─────────────────────────────────────────────────────

    /// <summary>Half a second is long enough to kill a click, short enough not to be heard as a fade.</summary>
    private const double DefaultClipFadeSeconds = 0.5;

    void ToggleClipFadeIn(bool enabled)
    {
        if (Usage == null) return;
        Usage.ClipFadeInSeconds = enabled ? DefaultClipFadeSeconds : null;
        SyncPreviewFades();
    }

    void ToggleClipFadeOut(bool enabled)
    {
        if (Usage == null) return;
        Usage.ClipFadeOutSeconds = enabled ? DefaultClipFadeSeconds : null;
        SyncPreviewFades();
    }

    void SetClipFadeIn(double seconds)
    {
        if (Usage == null) return;
        Usage.ClipFadeInSeconds = Math.Max(0, seconds);
        SyncPreviewFades();
    }

    void SetClipFadeOut(double seconds)
    {
        if (Usage == null) return;
        Usage.ClipFadeOutSeconds = Math.Max(0, seconds);
        SyncPreviewFades();
    }

    // Lets a running preview audition the ramps without restarting it.
    void SyncPreviewFades()
    {
        if (Usage != null)
            _previewPlayer?.SetClipFades(Usage.ClipFadeInSeconds, Usage.ClipFadeOutSeconds);
    }

    // Keeps an active preview following the handles as they are dragged.
    void SyncPreviewBounds()
    {
        if (Usage != null)
            _previewPlayer?.SetClipBounds(Usage.ClipStartSeconds, Usage.ClipEndSeconds);
    }

    // ── Zoom & scroll ───────────────────────────────────────────────────────

    /// <summary>Where the visible window sits in the file, 0..1 (0 when fully zoomed out).</summary>
    private double ScrollFraction
    {
        get
        {
            double slack = _fileDuration - _viewDuration;
            return slack <= 1e-6 ? 0 : Math.Clamp(_viewStart / slack, 0, 1);
        }
    }

    void OnScrollChanged(double fraction)
    {
        double slack = Math.Max(0, _fileDuration - _viewDuration);
        _viewStart = Math.Clamp(fraction, 0, 1) * slack;
        _needsRedraw = true;
    }

    void ZoomByAroundCentre(double factor) => ZoomAround(_viewStart + _viewDuration / 2, factor);

    /// <summary>
    /// Scales the window by <paramref name="factor"/> while keeping
    /// <paramref name="anchorSeconds"/> under the same pixel, so wheel-zoom homes in
    /// on whatever the pointer is over instead of drifting.
    /// </summary>
    void ZoomAround(double anchorSeconds, double factor)
    {
        if (_fileDuration <= 0 || _viewDuration <= 0) return;

        double anchorFraction = Math.Clamp((anchorSeconds - _viewStart) / _viewDuration, 0, 1);
        double newDuration = Math.Clamp(_viewDuration / factor, MinViewDuration, _fileDuration);
        if (Math.Abs(newDuration - _viewDuration) < 1e-9) return;

        _viewDuration = newDuration;
        _viewStart = Math.Clamp(anchorSeconds - anchorFraction * newDuration,
                                0, Math.Max(0, _fileDuration - newDuration));
        _needsRedraw = true;
    }

    void ZoomFit()
    {
        _viewStart = 0;
        _viewDuration = _fileDuration;
        _needsRedraw = true;
    }

    /// <summary>Frames the current clip with a little air on each side.</summary>
    void ZoomToClip()
    {
        if (_fileDuration <= 0) return;

        double length = Math.Max(MinViewDuration, ClipEndValue - ClipStartValue);
        double padded = Math.Clamp(length * 1.2, MinViewDuration, _fileDuration);
        double centre = (ClipStartValue + ClipEndValue) / 2;

        _viewDuration = padded;
        _viewStart = Math.Clamp(centre - padded / 2, 0, Math.Max(0, _fileDuration - padded));
        _needsRedraw = true;
    }

    void OnWaveWheel(WheelEventArgs e)
    {
        if (_fileDuration <= 0) return;

        double fraction = _waveWidthPx > 0 ? Math.Clamp(e.OffsetX / _waveWidthPx, 0, 1) : 0.5;
        ZoomAround(_viewStart + fraction * _viewDuration, e.DeltaY < 0 ? 1.3 : 1 / 1.3);
    }

    // ── Preview ─────────────────────────────────────────────────────────────

    private bool _previewLoop;

    void StartPreview()
    {
        if (Usage == null || Item == null) return;
        StopPreview();

        var playablePath = AudioFiles.GetPlayablePath(Item.LocalFileName);
        if (playablePath == null) return;

        try
        {
            _previewPlayer = DAAudioPlayer.Create(playablePath, Usage, AudioManager);
            _previewPlayer.Loop = _previewLoop;             // audition how the selection loops
            _previewPlayer.PlaybackEnded += OnPreviewEnded;
            _previewPlayer.Play();
            _previewTicker.Start();
        }
        catch { _previewPlayer = null; }
    }

    void OnPreviewLoopChanged(bool value)
    {
        _previewLoop = value;
        if (_previewPlayer != null)
            _previewPlayer.Loop = value;   // applies live during preview
    }

    // Click on the waveform seeks the running preview to that spot (clamped to the clip).
    async Task OnWaveClick(MouseEventArgs e)
    {
        if (_previewPlayer == null || !_previewPlayer.IsPlaying || _fileDuration <= 0) return;

        double width = _waveWidthPx;
        if (width <= 0)
        {
            try { width = await JS.InvokeAsync<double>("daWaveform.width", _canvasId); }
            catch { }
        }
        if (width <= 0) return;

        double absoluteSeconds = _viewStart + Math.Clamp(e.OffsetX / width, 0, 1) * _viewDuration;
        double clipRelative = Math.Clamp(absoluteSeconds - ClipStartValue, 0, ClipEndValue - ClipStartValue);
        _previewPlayer.Seek(clipRelative);
        _previewPosition = clipRelative;
        StateHasChanged();
    }

    void StopPreview()
    {
        _previewTicker.Stop();
        if (_previewPlayer != null)
        {
            _previewPlayer.PlaybackEnded -= OnPreviewEnded;
            _previewPlayer.Dispose();
            _previewPlayer = null;
        }
        _previewPosition = 0;
    }

    void OnPreviewEnded(object? s, EventArgs e)
    {
        _previewTicker.Stop();
        _previewPosition = 0;
        InvokeAsync(StateHasChanged);
    }

    // ── Waveform ────────────────────────────────────────────────────────────

    private async Task ComputePeaksAsync(string filePath)
    {
#if WINDOWS
        try
        {
            // Resolution follows the file length so a zoomed-in window still has
            // detail to show: an hour-long track resolves to ~90 ms per bar. The
            // decode reads every sample either way, so this costs memory, not time.
            int buckets = (int)Math.Clamp(_fileDuration * 25, 1200, 40000);
            _peaks = await Task.Run(() => ComputePeaks(filePath, buckets));
        }
        catch
        {
            _peaks = null;   // decode failed → plain background, still fully usable
        }
        _peaksLoaded = false;
        _needsRedraw = true;
        await InvokeAsync(StateHasChanged);
#else
        await Task.CompletedTask;   // no waveform off-Windows (baseline UI only)
#endif
    }

#if WINDOWS
    private static float[] ComputePeaks(string filePath, int buckets)
    {
        // Same reader the player uses, so the peaks and playback agree on where a
        // given second of the file is — that is the whole point of the waveform.
        using var reader = new DAFloatFileReader(filePath);
        var peaks = new float[buckets];
        long totalSamples = reader.TotalSampleCount;
        long samplesPerBucket = Math.Max(1, totalSamples / buckets);

        var buffer = new float[16384];
        int bucketIndex = 0;
        long count = 0;
        float max = 0;
        int read;
        while ((read = reader.Read(buffer, 0, buffer.Length)) > 0 && bucketIndex < buckets)
        {
            for (int i = 0; i < read; i++)
            {
                float abs = Math.Abs(buffer[i]);
                if (abs > max) max = abs;
                if (++count >= samplesPerBucket)
                {
                    if (bucketIndex < buckets) peaks[bucketIndex++] = max;
                    max = 0;
                    count = 0;
                }
            }
        }
        return peaks;
    }
#endif

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_visible || _fileDuration <= 0) return;

        if (_waveWidthPx <= 0)
        {
            try { _waveWidthPx = await JS.InvokeAsync<double>("daWaveform.width", _canvasId); }
            catch { /* canvas not ready — retried on the next render */ }
        }

        if (_peaks == null) return;

        try
        {
            if (!_peaksLoaded)
            {
                // Handed over once; zooming and scrolling then redraw from the
                // browser-side copy instead of re-marshalling the whole array.
                await JS.InvokeVoidAsync("daWaveform.load", _canvasId, _peaks);
                _peaksLoaded = true;
                _needsRedraw = true;
            }

            if (_needsRedraw)
            {
                _needsRedraw = false;
                // The redraw hands back the canvas width it just measured. Taking
                // it here keeps the cached geometry honest for free: the box is
                // inside a scrolling overlay, so it changes width whenever the
                // dialog grows past the viewport, and a stale width silently
                // skews every click-to-seek by that ratio.
                _waveWidthPx = await JS.InvokeAsync<double>("daWaveform.drawRange", _canvasId,
                                                            _viewStart / _fileDuration, ViewEnd / _fileDuration);
            }
        }
        catch { /* canvas not ready — ignored */ }
    }

    public void Dispose()
    {
        _previewTicker.Dispose();
        StopPreview();
    }
}
