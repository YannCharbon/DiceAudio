@page "/audioexplorer"
@inject DiceAudioService DAService
@inject PopupNotificationService Notifications
@inject DADownloadQueue DownloadQueue
@inject DABundleExportService Exports
@inject DAImportService Imports
@using DiceAudio.Resources.Localization
@implements IDisposable

<style>
  /*  The cards themselves live in app.css (.da-card and friends), shared with
      the audio picker.                                                       */

  /*  breadcrumbs + nav buttons ------------------------------------ */
  .nav-bar     { display:flex; align-items:center; gap:8px; margin:14px 0; flex-wrap:wrap; }
  .crumb-link  { cursor:pointer; color:var(--a2); }
  .crumb-link:hover { text-decoration:underline; }
  .crumb-sep   { color:var(--t4); }

  /*  tag filter ---------------------------------------------------- */
  /*  cat-expr on the bar supplies --cf, the Expression category's own tint,
      which is the colour the expression line has always read in.             */
  .filter-bar  { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
                 background:var(--s2); border:1px solid var(--b2); border-radius:8px;
                 padding:6px 10px; margin-bottom:10px; }
  .filter-expr { color:var(--cf); font-weight:600; }
  /*  multi-selection ---------------------------------------------- */
  .selection-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
                   background:var(--s2); border:1px solid var(--a2); border-radius:8px;
                   padding:6px 10px; margin-bottom:10px; }
  .selection-count { color:var(--a2); font-weight:600; }


  /*  The search box is the field, so the input inside it draws no second
      frame — it holds the leading icon and the clear button too.             */
  .axp-search { display:flex; align-items:center; gap:6px;
                max-width:420px; height:32px; margin-bottom:10px;
                padding:0 5px 0 9px;
                background:var(--s2); border:1px solid var(--ctl);
                border-radius:var(--r-btn); color:var(--t3); }
  .axp-search:focus-within { border-color:var(--a2); }
  .axp-search .da-inp { border:0; background:transparent; height:30px; padding:0; color:var(--t1); }
  .axp-search .da-inp:focus-visible { outline:none; }
  .axp-search .da-ib { width:24px; height:24px; }
</style>

<!-- ─────────────────────  MODALS  ───────────────────── -->
<GenericModal TContent="AudioDownloader"  @ref="AudioDownloaderModalRef"  OnClose="HandleAudioDownloaderModalClose"><AudioDownloader /></GenericModal>
<GenericModal TContent="AudioTagsPicker"  @ref="AudioTagsPickerModalRef"  OnClose="HandleAudioTagsPickerModalClose"><AudioTagsPicker AudioItem="_currentAudioItemForTagsPicker" /></GenericModal>
<GenericModal TContent="MoveToFolder"     @ref="MoveToFolderModalRef"     OnClose="HandleMoveToFolderModalClose"><MoveToFolder AudioItem="_currentAudioItemForMoveToFolder" /></GenericModal>
<GenericModal TContent="AudioTagsEditor"  @ref="AudioTagsEditorModalRef"  OnClose="HandleAudioTagsEditorModalClose"><AudioTagsEditor /></GenericModal>
<GenericModal TContent="AudioFilterEditor" @ref="AudioFilterModalRef"    OnClose="HandleAudioFilterModalClose"><AudioFilterEditor Filter="_filter" MatchCount="CountFilterMatches" UpdateParent="StateHasChanged" /></GenericModal>
<GenericModal TContent="MoveToFolder"     @ref="MoveManyToFolderModalRef" OnClose="HandleMoveToFolderModalClose"><MoveToFolder AudioItems="_selectedItemsForMove" OnMoved="OnSelectionMoved" /></GenericModal>
<GenericModal TContent="MoveFolder"       @ref="MoveFolderModalRef"      OnClose="HandleMoveFolderModalClose"><MoveFolder Folder="_currentFolderForMove" /></GenericModal>
<AudioImporter @ref="_audioImporterRef" OnImported="OnImportFinished" />

@* Deleting an item takes the file off the disk with it, so the question is
   asked destructively. *@
<DaConfirm @ref="_confirm" Destructive="true" />

<!-- ─────────────────────  TOOLBAR  ───────────────────── -->
<h3>Explorer</h3>
<div class="da-irow da-irow-wrap" style="gap:8px; margin-bottom:10px;">
    <button type="button" class="da-btn da-btn-fill" @onclick="@(() => AudioDownloaderModalRef?.Show())">
        <DaIcon Name="download" Size="18" />Audio downloader
    </button>
    <button type="button" class="da-btn da-btn-fill" @onclick="@(() => _audioImporterRef?.Show())">
        <DaIcon Name="folder-upload" Size="18" />Import audio from disk
    </button>
    <button type="button" class="da-btn da-btn-out" @onclick="() => Imports.RequestImport(DiceAudio.Portability.DAImportOrigin.Explorer)">
        <DaIcon Name="upload-file" Size="18" />@Portability.ImportFromFileBtn
    </button>
    @* Until the tag files are read, the editor would show empty lists, and
       saving them would replace the real ones. *@
    <button type="button" class="da-btn da-btn-fill" disabled="@(!DAAudioTagsProvider.Instance.IsLoaded)"
            @onclick="@(() => AudioTagsEditorModalRef?.Show())">
        <DaIcon Name="tag" Size="18" />Add/Remove tags
    </button>
    <button type="button" class="da-btn da-btn-out"
            title="Create a subfolder of the folder you are in"
            @onclick="StartNewFolder">
        <DaIcon Name="folder-add" Size="18" />New folder
    </button>
    <button type="button" class="da-btn @(_filter.IsActive ? "da-btn-fill" : "da-btn-out")"
            @onclick="@(() => AudioFilterModalRef?.Show())">
        <DaIcon Name="filter" Size="18" />Filter by tags
    </button>
    <button type="button" class="da-btn @(_selectionMode ? "da-btn-fill" : "da-btn-out")"
            title="Show a checkbox on every card and start with all of them selected, so you only have to untick what should stay behind"
            @onclick="ToggleSelectionMode">
        <DaIcon Name="@(_selectionMode ? "close" : "select-all")" Size="18" />@(_selectionMode ? "Exit selection" : "Select multiple items")
    </button>
</div>

<!-- ─────────────────────  NEW FOLDER  ───────────────────── -->
@if (_creatingFolder)
{
    <div class="da-irow da-irow-wrap" style="gap:8px; margin-bottom:10px;">
        @* oninput, not a change binding: that is what Immediate="true" bought,
           and the Enter key below reads _newFolderName as it is typed. *@
        <div class="da-field" style="max-width:280px;">
            <span class="da-flabel">@($"New folder in {(IsRoot ? "Root" : _currentFolder.Name)}")</span>
            <input class="da-inp" type="text" value="@_newFolderName"
                   @oninput="@(e => _newFolderName = e.Value?.ToString() ?? string.Empty)"
                   @onkeyup="OnNewFolderKeyUp" />
        </div>
        <button type="button" class="da-btn da-btn-fill" @onclick="ConfirmNewFolder">
            <DaIcon Name="add" Size="18" />Create
        </button>
        <button type="button" class="da-btn da-btn-text" @onclick="CancelNewFolder">Cancel</button>
        @if (_newFolderExists)
        {
            <div class="da-meta" style="color:var(--danger);">A folder with that name already exists.</div>
        }
    </div>
}

<!-- ─────────────────────  SEARCH  ───────────────────── -->
<div class="axp-search">
    <DaIcon Name="search" Size="16" Class="da-i-muted" />
    <input class="da-inp" type="text" spellcheck="false"
           placeholder="Search all audio items by name…" aria-label="Search all audio items by name"
           value="@_search" @oninput="OnSearchInput" />
    @if (!string.IsNullOrEmpty(_search))
    {
        <button type="button" class="da-ib" title="Clear the search" aria-label="Clear the search"
                @onclick="@(() => OnSearchChanged(string.Empty))">
            <DaIcon Name="close" Size="14" />
        </button>
    }
</div>

<!-- ─────────────────────  KIND FILTER  ───────────────────── -->
<div class="da-irow da-irow-wrap" style="gap:6px; margin-bottom:10px;">
    <button type="button" class="da-btn @(_kindFilter == null ? "da-btn-fill" : "da-btn-out") da-btn-sm"
            @onclick="() => _kindFilter = null">All</button>
    @foreach (var kind in new[] { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect })
    {
        var k = kind;
        var active = _kindFilter == k;
        @* The kind tint the MudButton's Color carried, taken from the --kc the
           kind class defines rather than named again here. *@
        <button type="button" class="da-btn @(active ? "da-btn-fill" : "da-btn-out") da-btn-sm @k.KindClass()"
                style="@(active ? "" : "color:var(--kc); border-color:var(--kc-edge);")"
                @onclick="() => _kindFilter = k">
            <DaIcon Name="@KindIcon(k)" Size="16" />@k.Label()
        </button>
    }
    @* Items whose file is not on this computer, in every folder: after an
       import, the ones still waiting for a download or for "Pick file…". *@
    <button type="button" class="da-btn @(_missingOnly ? "da-btn-fill" : "da-btn-out") da-btn-sm"
            aria-pressed="@(_missingOnly ? "true" : "false")"
            @onclick="() => _missingOnly = !_missingOnly">
        <DaIcon Name="folder-off" Size="16" />@Portability.MissingFilesFilter
    </button>
</div>

<!-- ─────────────────────  SELECTION  ───────────────────── -->
@{ var shownItems = GetFilteredItems().ToList(); }
@if (_selectionMode)
{
    <div class="selection-bar">
        <DaIcon Name="check-circle" Size="18" Class="da-i-info" />
        <span class="selection-count">@_selectedIds.Count selected</span>
        @{ var offScreen = _selectedIds.Count - shownItems.Count(i => _selectedIds.Contains(i.Id)); }
        @if (offScreen > 0)
        {
            <span style="color:var(--t3); font-size:13px;">(@offScreen not shown here)</span>
        }
        <button type="button" class="da-btn da-btn-fill da-btn-sm"
                disabled="@(_selectedIds.Count == 0)"
                @onclick="OpenBulkMove">
            <DaIcon Name="folder-move" Size="16" />Move to folder…
        </button>
        <button type="button" class="da-btn da-btn-out da-btn-sm"
                disabled="@(_selectedIds.Count == 0)"
                @onclick="ExportSelection">
            <DaIcon Name="upload" Size="16" />@Portability.ExportSelectionBtn
        </button>
        <button type="button" class="da-btn da-btn-text da-btn-sm" @onclick="ClearSelection">
            <DaIcon Name="deselect" Size="16" />Clear selection
        </button>
    </div>
}

<!-- ─────────────────────  ACTIVE TAG FILTER  ───────────────────── -->
@if (_filter.IsActive)
{
    <div class="filter-bar cat-expr">
        <DaIcon Name="filter" Size="18" style="color:var(--cf);" />
        <span style="color:var(--t3);">Showing items matching</span>
        <span class="filter-expr">@_filter.Describe()</span>
        <span style="color:var(--t3);">
            @(!string.IsNullOrWhiteSpace(_search)
                ? "across all folders (search is on)"
                : _filter.IncludeSubfolders ? "in this folder and its subfolders" : "in this folder only")
        </span>
        <button type="button" class="da-btn da-btn-text da-btn-sm" @onclick="@(() => AudioFilterModalRef?.Show())">
            <DaIcon Name="edit" Size="16" />Edit
        </button>
        <button type="button" class="da-btn da-btn-text da-btn-sm" style="color:var(--danger);" @onclick="ClearFilter">
            <DaIcon Name="close" Size="16" />Clear
        </button>
    </div>
}

<!-- ────────────────────  NAV + BREADCRUMBS ─────────────────── -->
@* One bar: history and breadcrumbs on the left, view and sort on the right. *@
<div class="nav-bar">
@if (!string.IsNullOrWhiteSpace(_search))
{
        <DaIcon Name="search" Size="18" style="color:var(--a2);" />
        <span style="color:var(--a2);">Search results for "<b>@_search</b>" across all folders</span>
}
else if (_missingOnly)
{
        <DaIcon Name="folder-off" Size="18" style="color:var(--a2);" />
        <span style="color:var(--a2);"><b>@Portability.MissingFilesFilter</b> across all folders</span>
}
else if (_breadcrumb.Any())
{
        <button type="button" class="da-ib" title="Back" aria-label="Back"
                disabled="@(!CanGoBack)" @onclick="GoBack">
            <DaIcon Name="arrow-back" Size="18" />
        </button>
        <button type="button" class="da-ib" title="Forward" aria-label="Forward"
                disabled="@(!CanGoForward)" @onclick="GoForward">
            <DaIcon Name="arrow-right" Size="18" />
        </button>

        @for (var i = 0; i < _breadcrumb.Count; i++)
        {
            var crumb = _breadcrumb[i];
            bool isLast   = i == _breadcrumb.Count - 1;

            if (!isLast)
            {
                <span class="crumb-link" @onclick="@(() => NavigateToFolder(crumb))">
                    @(crumb == _rootFolder ? "Root" : crumb.Name)
                </span>
                <span class="crumb-sep">/</span>
            }
            else
            {
                <span>@(crumb == _rootFolder ? "Root" : crumb.Name)</span>
            }
        }
}
    <ViewSortToggles @bind-FolderView="FolderView" @bind-ItemView="ItemView" @bind-Sort="Sort" />
</div>


<!-- ─────────────────────  FOLDERS  ───────────────────── -->
@if (!AcrossAllFolders)
{
    var folders = SortFolders(IsRoot ? _folderTree : _currentFolder.VirtualAudioSubFolders).ToList();

    <div class="@(_folderView == DAViewMode.Big ? "da-grid" : "da-list")">
        @foreach (var folder in folders)
        {
            @(_folderView == DAViewMode.Big ? RenderFolderCard(folder) : RenderFolderRow(folder))
        }
    </div>
}

<!-- ─────────────────────  AUDIO ITEMS  ───────────────────── -->
@{
    var matches = shownItems;
    var shown = matches.Count > MaxRenderedItems ? matches.Take(MaxRenderedItems).ToList() : matches;
    // In a folder: the items shown here that wait for their first download.
    var toDownload = AcrossAllFolders ? new List<DAAudioItem>() : matches.Where(CanQueue).ToList();
}
@if (toDownload.Count > 0)
{
    <div class="da-irow" style="margin:4px 0 10px;">
        <button type="button" class="da-btn da-btn-out da-btn-sm" title="@Portability.DownloadAllHelp"
                disabled="@(!DAService.CanWriteData)" @onclick="() => Download(toDownload)">
            <DaIcon Name="cloud-download" Size="16" />@string.Format(Portability.DownloadAllBtn, toDownload.Count)
        </button>
    </div>
}
<div class="@(_itemView == DAViewMode.Big ? "da-grid" : "da-list") @(_selectionMode ? "da-selectable" : "")">
    @foreach (var item in shown)
    {
        @(_itemView == DAViewMode.Big ? RenderItemCard(item) : RenderItemRow(item))
    }
</div>


@if (matches.Count > shown.Count)
{
    <div class="da-meta" style="color:var(--warn); margin:8px 2px;">
        Showing the first @shown.Count of @matches.Count items — narrow down with the search box, the kind filter or the tag filter to see the rest.
    </div>
}

@code {
    private DaConfirm? _confirm;

    // modal refs
    private GenericModal<AudioDownloader>? AudioDownloaderModalRef;
    private GenericModal<AudioTagsPicker>?  AudioTagsPickerModalRef;
    private GenericModal<AudioTagsEditor>?  AudioTagsEditorModalRef;
    private GenericModal<MoveToFolder>?     MoveToFolderModalRef;
    private GenericModal<AudioFilterEditor>? AudioFilterModalRef;
    private GenericModal<MoveToFolder>?     MoveManyToFolderModalRef;
    private GenericModal<MoveFolder>?       MoveFolderModalRef;

    // tree + navigation state
    private readonly DAVirtualAudioFolder _rootFolder = new() { Name = "." };
    private DAVirtualAudioFolder _currentFolder = default!;
    private List<DAVirtualAudioFolder> _folderTree = new();
    private List<DAVirtualAudioFolder> _breadcrumb = new();

    private List<DAVirtualAudioFolder> _history = new();
    private int _historyIndex = -1;

    private bool IsRoot => _currentFolder == _rootFolder || _currentFolder.Name == ".";

    private bool CanGoBack    => _historyIndex > 0;
    private bool CanGoForward => _historyIndex < _history.Count - 1;

    /// Lets the home page open one of this page's modals directly, the way
    /// DiceCombats routes to /combatmanager/new: "download" raises the
    /// downloader, "import" the disk importer.
    [SupplyParameterFromQuery(Name = "open")] public string? OpenPanel { get; set; }

    private bool _openPanelHandled;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _openPanelHandled || string.IsNullOrEmpty(OpenPanel)) return;
        _openPanelHandled = true;
        if (OpenPanel == "download") AudioDownloaderModalRef?.Show();
        else if (OpenPanel == "import") _audioImporterRef?.Show();
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        DownloadQueue.LibraryChanged += OnDownloadAdded;
        DownloadQueue.Changed += OnDownloadProgress;
        BuildFolderTree();
        // initialize navigation at root
        _currentFolder = _rootFolder;
        _history.Clear();
        _historyIndex = -1;
        NavigateToFolder(_rootFolder);
    }

    // A download finished in the background, perhaps after the downloader was
    // closed: its item (and a folder made for it) must show without a reload.
    void OnDownloadAdded() => _ = InvokeAsync(() =>
    {
        BuildFolderTree();
        StateHasChanged();
    });

    // The download list changed (an item queued, a download's progress): the
    // status lines follow, at most a few times a second, since each redraw of
    // the page redraws up to 200 cards.
    private bool _progressRedrawPending;

    void OnDownloadProgress()
    {
        if (_progressRedrawPending) return;
        _progressRedrawPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(500);
            _progressRedrawPending = false;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        DownloadQueue.LibraryChanged -= OnDownloadAdded;
        DownloadQueue.Changed -= OnDownloadProgress;
    }

    // Renders once more when the tags arrive, which enables their editor.
    protected override async Task OnInitializedAsync()
    {
        if (!DAAudioTagsProvider.Instance.IsLoaded)
            await DAAudioTagsProvider.Instance.WhenLoaded;
    }

    void BuildFolderTree()
    {
        // Derive missing virtual folders from item metadata (handles empty audioVirtualFolders.json).
        // Always create a NEW object so the canonical folder in AudioVirtualFolders is never
        // aliased with an item's embedded Folder property (which would cause mutations via
        // MoveToFolder to corrupt the canonical folder name).
        foreach (var item in DAService.AudioItems)
        {
            if (item.Folder != null && item.Folder.Name != "." &&
                DAService.AudioVirtualFolders.FindIndex(x => x.Name == item.Folder.Name) == -1)
            {
                DAService.AudioVirtualFolders.Add(new DAVirtualAudioFolder(item.Folder.Name)
                {
                    ParentFolderId = item.Folder.ParentFolderId
                });
            }
        }

        // Deduplicate by name then by ID — heals corrupted data that has same name or same ID
        // appearing multiple times (e.g. from a previous broken run).
        var seenNames = new HashSet<string>();
        var seenIds   = new HashSet<Guid>();
        var deduped = DAService.AudioVirtualFolders
            .Where(f => seenNames.Add(f.Name) && seenIds.Add(f.Id))
            .ToList();
        DAService.AudioVirtualFolders.Clear();
        DAService.AudioVirtualFolders.AddRange(deduped);

        var map = DAService.AudioVirtualFolders.ToDictionary(f => f.Id);
        _folderTree.Clear();

        foreach (var f in map.Values)
        {
            f.VirtualAudioSubFolders.Clear();
            if (f.ParentFolderId != Guid.Empty && map.TryGetValue(f.ParentFolderId, out var p))
                p.VirtualAudioSubFolders.Add(f);
            else
                _folderTree.Add(f);
        }
    }

    void NavigateToFolder(DAVirtualAudioFolder folder)
    {
        // manage history
        if (_historyIndex < 0 || _history[_historyIndex] != folder)
        {
            // drop forward entries
            if (_historyIndex < _history.Count - 1)
                _history.RemoveRange(_historyIndex + 1, _history.Count - _historyIndex - 1);

            _history.Add(folder);
            _historyIndex = _history.Count - 1;
        }

        _currentFolder = folder;
        UpdateBreadcrumb();
    }

    void GoBack()
    {
        if (!CanGoBack) return;
        _historyIndex--;
        _currentFolder = _history[_historyIndex];
        UpdateBreadcrumb();
    }

    void GoForward()
    {
        if (!CanGoForward) return;
        _historyIndex++;
        _currentFolder = _history[_historyIndex];
        UpdateBreadcrumb();
    }

    void UpdateBreadcrumb()
    {
        _breadcrumb.Clear();
        var ptr = _currentFolder;
        while (ptr != null)
        {
            _breadcrumb.Insert(0, ptr);
            if (ptr == _rootFolder) break;
            ptr = ptr.ParentFolderId == Guid.Empty
                  ? _rootFolder
                  : DAService.AudioVirtualFolders.FirstOrDefault(f => f.Id == ptr.ParentFolderId);
        }
    }

    RenderFragment RenderItemCard(DAAudioItem item) => __builder =>
    {
        <article class="da-card @item.Kind.KindClass() @(IsPlaying(item) ? "playing" : "") @(_selectionMode && IsSelected(item) ? "marked" : "")">
            @* The hero is the artwork; in selection mode it is also the hit area. *@
            <div class="da-hero"
                 @onclick="@(() => { if (_selectionMode) ToggleSelected(item); })"
                 title="@(_selectionMode ? "Click to select this item" : null)">
                @if (_selectionMode)
                {
                    <label class="da-selbox" title="Select this item"
                           @onclick="@(() => { })" @onclick:stopPropagation="true">
                        <input type="checkbox" checked="@IsSelected(item)"
                               aria-label="@($"Select {item.Name}")"
                               @onchange="@((ChangeEventArgs e) => SetSelected(item, (bool)(e.Value ?? false)))" />
                    </label>
                }
                @* Icon only; the label unfurls on hover. Click cycles Music → Ambiance → SFX. *@
                <button type="button" class="da-kind"
                        title="@($"{item.Kind.Label()} — click to change kind")"
                        @onclick="@(() => ToggleKind(item))" @onclick:stopPropagation="true">
                    <DaIcon Name="@KindIcon(item.Kind)" Size="15" />
                    <span class="da-kind-label">@item.Kind.Label()</span>
                </button>
                @* The folder is a tooltip only — the breadcrumb already shows it. *@
                <div class="da-name" title="@($"{item.Name} — {item.Folder.Name}")">@item.Name</div>
            </div>
            <div class="da-body">
                <div class="da-tags">
                    @foreach (var tag in item.Tags)
                    {
                        <span class="da-chip @tag.CategoryClass()"><span class="da-dot"></span>@tag.Name</span>
                    }
                    @if (item.IsCloudOnly)
                    {
                        <span class="da-chip" title="@Portability.CloudOnlyBadge"><DaIcon Name="cloud-download" Size="12" /> @Portability.CloudOnlyBadge</span>
                    }
                </div>
                @if (item.IsLocallyAvailable)
                {
                    <MusicPlayer AudioItem="@item"
                                 PlayingChanged="@((bool playing) => SetPlaying(item, playing))"></MusicPlayer>
                }
                else
                {
                    @RenderFileStatus(item)
                }
                <div class="da-acts">
                    <button type="button" class="da-ib" title="Edit tags" aria-label="Edit tags"
                            @onclick="@(() => OpenAudioTagsPicker(item))">
                        <DaIcon Name="tag" Size="18" />
                    </button>
                    <button type="button" class="da-ib" title="Move to folder" aria-label="Move to folder"
                            @onclick="@(() => OpenMoveToFolderPicker(item))">
                        <DaIcon Name="folder-move" Size="18" />
                    </button>
                    <button type="button" class="da-ib" title="Export" aria-label="Export"
                            @onclick="@(() => Exports.ExportAudioItems(new[] { item }))">
                        <DaIcon Name="upload" Size="18" />
                    </button>
                    <button type="button" class="da-ib da-danger" title="Delete" aria-label="Delete"
                            @onclick="@(() => DeleteAudioItem(item))">
                        <DaIcon Name="delete" Size="18" />
                    </button>
                </div>
            </div>
        </article>;
    };

    @* One row per item: kind tile, name, tags, a single-row player, actions. *@
    RenderFragment RenderItemRow(DAAudioItem item) => __builder =>
    {
        <div class="da-row @item.Kind.KindClass() @(IsPlaying(item) ? "playing" : "") @(_selectionMode && IsSelected(item) ? "marked" : "")"
             @onclick="@(() => { if (_selectionMode) ToggleSelected(item); })"
             title="@(_selectionMode ? "Click to select this item" : null)">
            @if (_selectionMode)
            {
                <label class="da-selbox" title="Select this item"
                       @onclick="@(() => { })" @onclick:stopPropagation="true">
                    <input type="checkbox" checked="@IsSelected(item)"
                           aria-label="@($"Select {item.Name}")"
                           @onchange="@((ChangeEventArgs e) => SetSelected(item, (bool)(e.Value ?? false)))" />
                </label>
            }
            <button type="button" class="da-row-kind"
                    title="@($"{item.Kind.Label()} — click to change kind")"
                    @onclick="@(() => ToggleKind(item))" @onclick:stopPropagation="true">
                <DaIcon Name="@KindIcon(item.Kind)" Size="18" />
            </button>
            <div class="da-row-name" title="@($"{item.Name} — {item.Folder.Name}")">@item.Name</div>
            <div class="da-tags">
                @foreach (var tag in item.Tags)
                {
