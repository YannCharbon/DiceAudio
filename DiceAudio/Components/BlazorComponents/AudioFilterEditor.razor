<style>
    .filter-expression {
        background: var(--s2); border: 1px solid var(--b2); border-radius: 8px;
        padding: 10px 12px; margin-bottom: 12px;
    }
    /* The expression reads in the Expression category's own tint, which the
       .cat-expr class on the box above supplies as --cf. */
    .filter-expression-text { color: var(--cf); font-weight: 600; }
    .filter-criteria { background: var(--s4); border-radius: 8px; padding: 10px; margin-bottom: 10px; }
</style>

<h4 style="margin-bottom:6px;">Filter by tags</h4>

<div class="filter-expression cat-expr">
    @if (Filter.IsActive)
    {
        <span style="color:var(--t3);">Show all audio items matching:&nbsp;</span>
        <span class="filter-expression-text">@Filter.Describe()</span>
    }
    else
    {
        <span style="color:var(--t3);">No filter yet — add a criteria and click tags to build an expression.</span>
    }
    @if (MatchCount != null)
    {
        <div style="color:var(--t3); font-size:small; margin-top:6px;">
            @MatchCount() item(s) match in @(Filter.IncludeSubfolders ? "this folder and its subfolders" : "this folder")
        </div>
    }
</div>

<label class="da-chk">
    <input type="checkbox" checked="@Filter.IncludeSubfolders"
           @onchange="@((ChangeEventArgs e) => { Filter.IncludeSubfolders = e.Value is bool v && v; UpdateParent?.Invoke(); })" />
    Include the subfolders (their matches are shown next to the current folder's items)
</label>

<div style="margin-top:10px;">
    @if (Filter.Criterias.Count == 0)
    {
        <p style="color:var(--t3);">No criteria added yet.</p>
    }

    @foreach (var criteria in Filter.Criterias)
    {
        <div class="filter-criteria">
            <div class="da-irow" style="margin-bottom:8px;">
                @if (criteria.EditionModeEnabled)
                {
                    <button type="button" class="da-btn da-btn-fill da-btn-sm"
                            @onclick="() => { criteria.EditionModeEnabled = false; UpdateParent?.Invoke(); }">
                        <DaIcon Name="check" Size="16" />Validate
                    </button>
                }
                else
                {
                    <button type="button" class="da-btn da-btn-out da-btn-sm"
                            @onclick="() => criteria.EditionModeEnabled = true">
                        <DaIcon Name="edit" Size="16" />Edit
                    </button>
                }
                <button type="button" class="da-btn da-btn-danger da-btn-sm"
                        @onclick="() => { Filter.Criterias.Remove(criteria); UpdateParent?.Invoke(); }">
                    <DaIcon Name="delete" Size="16" />Delete
                </button>
            </div>

            @if (criteria.EditionModeEnabled)
            {
                @* A native select needs no popover placement, so MudSelect's
                   PopoverClass has nothing to carry over. *@
                <div class="da-field" style="max-width:150px; margin-bottom:8px;">
                    <span class="da-flabel">Condition</span>
                    <select class="da-inp" value="@GetCondInt(criteria)"
                            @onchange="@(e => { SetCondInt(criteria, int.TryParse(e.Value?.ToString(), out var v) ? v : GetCondInt(criteria)); UpdateParent?.Invoke(); })">
                        <option value="0">NOT</option>
                        <option value="1">AND</option>
                        <option value="2">OR</option>
                    </select>
                </div>

                <div class="da-flabel">Type</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryTypeTags())
                    {
                        <button type="button" class="@CriteriaTagClass(criteria, tag)"
                                @onclick="() => ToggleCriteriaTag(criteria, tag)">@tag</button>
                    }
                </div>
                <div class="da-flabel">Location</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 8px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryLocationTags())
                    {
                        <button type="button" class="@CriteriaTagClass(criteria, tag)"
                                @onclick="() => ToggleCriteriaTag(criteria, tag)">@tag</button>
                    }
                </div>
                <div class="da-flabel">Expression</div>
                <div style="display:flex; flex-wrap:wrap; gap:4px; padding:4px 0 4px 0;">
                    @foreach (var tag in DAAudioTag.GetAllCategoryExpressionTags())
                    {
                        <button type="button" class="@CriteriaTagClass(criteria, tag)"
                                @onclick="() => ToggleCriteriaTag(criteria, tag)">@tag</button>
                    }
                </div>
            }
            else
            {
                <div class="da-irow da-irow-wrap">
                    @* The condition kept MudBlazor's Warning colour: it is the
                       operator, and it has to stand out from the tags it joins. *@
                    <span class="da-tag" style="color:var(--warn);">@criteria.Condition.ToString()</span>
                    @foreach (var tag in criteria.TagNames)
                    {
                        <span class="da-tag">@tag</span>
                    }
                </div>
            }
        </div>
    }

    <div class="da-irow da-irow-wrap" style="gap:8px;">
        <button type="button" class="da-btn da-btn-out" @onclick="AddCriteria">
            <DaIcon Name="add" Size="18" />Add criteria
        </button>
        @if (Filter.Criterias.Count > 0)
        {
            <button type="button" class="da-btn da-btn-danger" @onclick="ClearAll">
                <DaIcon Name="filter-off" Size="18" />Clear filter
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public DAAudioFilter Filter { get; set; } = new();

    /// <summary>How many items the filter currently matches — evaluated by the page.</summary>
    [Parameter] public Func<int>? MatchCount { get; set; }

    [Parameter] public Action? UpdateParent { get; set; }

    static int GetCondInt(DARandomPlayCriteria c) => (int)c.Condition;
    static void SetCondInt(DARandomPlayCriteria c, int v) => c.Condition = (DARandomPlayCriteria.ConditionType)v;

    void AddCriteria()
    {
        // AND first: "show me the items carrying these tags" is what a filter is
        // asked for most of the time; NOT and OR are one click away.
        Filter.Criterias.Add(new DARandomPlayCriteria
        {
            Condition = DARandomPlayCriteria.ConditionType.And
        });
        UpdateParent?.Invoke();
    }

    void ClearAll()
    {
        Filter.Criterias.Clear();
        UpdateParent?.Invoke();
    }

    void ToggleCriteriaTag(DARandomPlayCriteria criteria, string tag)
    {
        if (criteria.TagNames.Contains(tag))
            criteria.TagNames.Remove(tag);
        else
            criteria.TagNames.Add(tag);

        // Live feedback: the expression line and the match count follow every click.
        UpdateParent?.Invoke();
    }

    string CriteriaTagClass(DARandomPlayCriteria criteria, string tag) =>
        criteria.TagNames.Contains(tag) ? "da-tog da-on" : "da-tog";
}
