@implements IDisposable

<style>
    .da-ctx-btn {
        background: #1e1e38; border: 1px solid #363660; border-radius: 10px;
        padding: 3px 9px; font-size: 11px; cursor: pointer; user-select: none;
        transition: background 0.15s, border-color 0.15s;
    }
    .da-ctx-btn:hover { background: #2e2e58; border-color: #5555aa; }
    .da-ctx-btn-active {
        background: rgba(35,166,213,0.3); border-color: #23a6d5; color: #bfe8ff;
        font-weight: bold;
    }

    /* Linear step sequence — numbered chips, so a long scene costs a couple of
       wrapped rows instead of growing the card by one row per step. The names
       live in the tooltips and in the caption under the strip. */
    .da-step-strip {
        display: flex; flex-wrap: wrap; gap: 3px;
        justify-content: center; margin: 4px 0 2px 0;
    }
    .da-step-chip {
        flex: 0 1 auto; min-width: 0; height: 19px; padding: 0 5px;
        display: flex; align-items: center; gap: 4px;
        background: #1e1e38; border: 1px solid #363660; border-radius: 5px;
        font-size: 11px; line-height: 1; cursor: pointer; user-select: none;
        color: #a8a8c8;
        transition: background 0.15s, border-color 0.15s;
    }
    .da-step-chip:hover { background: #2e2e58; border-color: #5555aa; color: #e0e0f5; }
    .da-step-chip-active {
        background: rgba(35,166,213,0.35); border-color: #23a6d5; color: #bfe8ff;
        font-weight: bold;
    }

    /* The number sits outside the clipped area, so it stays put while a long
       name scrolls past it. */
    .da-step-num {
        flex: 0 0 auto; min-width: 11px; text-align: center;
        font-variant-numeric: tabular-nums; opacity: 0.8;
    }
    .da-step-chip-active .da-step-num { opacity: 1; }

    /* Capped so two chips fit a card row. A name longer than the cap fills the
       label exactly, which is what makes the scroll distance below exact. */
    .da-step-label { flex: 0 1 auto; max-width: 88px; overflow: hidden; }
    .da-step-label-text { display: inline-block; white-space: nowrap; }

    .da-step-scroll .da-step-label-text {
        animation: da-step-marquee 6s linear infinite;
    }
    /* Ends pause before turning round. min() guards the case where the name is
       narrower than the cap after all — it then simply never moves. */
    @@keyframes da-step-marquee {
        0%, 18%   { transform: translateX(0); }
        50%, 68%  { transform: translateX(min(0px, calc(88px - 100%))); }
        100%      { transform: translateX(0); }
    }
    .da-step-caption {
        font-size: 11px; text-align: center;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }

    /* A transport command answered by a fade — play handing over, or stop fading
       to silence — pulses until the fade is done, so the acknowledgement is where
       the user is looking rather than seconds away. */
    .da-cmd-btn-pending {
        cursor: default;
        animation: da-pending-blink 1.2s ease-in-out infinite;
    }
    .da-cmd-btn-staging { border-color: #e73c7e; }
    @@keyframes da-pending-blink {
        0%, 100% { opacity: 0.55; }
        50%      { opacity: 1; }
    }
</style>

@* Uses shared da-cmd-btn CSS from app.css *@

@if (Player != null && ScenarioItem.Type == DAScenarioItem.ItemType.Scene)
{
    @* ── Scene transport ── *@
    var scene = Player.ScenePlayer;
    bool scenePlaying = scene?.IsPlaying == true;
    // The item's scene may be a group-local one; always resolve it.
    var itemScene = Group?.ResolveScene(ScenarioItem) ?? ScenarioItem.Scene;
    bool contextual = itemScene?.Mode == DASceneMode.Contextual;

    <div style="display:flex; justify-content:center; margin:6px 0;">
        @if (IsStarting)
        {
            <div class="da-cmd-btn da-cmd-btn-pending da-cmd-btn-staging" title="Starting — waiting for the fade out to finish">
                <DaIcon Name="hourglass" Size="22" style="color:var(--a1);" />
            </div>
        }
        else if (!scenePlaying)
        {
            <div class="da-cmd-btn" @onclick="RequestPlay" title="Start scene">
                <DaIcon Name="play" Size="22" Class="da-play" />
            </div>
        }
        else
        {
            @if (!contextual)
            {
                <div class="da-cmd-btn" @onclick="() => Player.AdvanceSceneAsync()" title="Advance to next step">
                    <DaIcon Name="skip-next" Size="20" Class="da-skip" />
                </div>
            }
            @if (IsFadingOut)
            {
                <div class="da-cmd-btn da-cmd-btn-pending" title="Stopping — fading out">
                    <DaIcon Name="stop" Size="20" Class="da-stop" />
                </div>
            }
            else
            {
                <div class="da-cmd-btn" @onclick="() => Player.StopWithFadeAsync()" title="Stop scene">
                    <DaIcon Name="stop" Size="20" Class="da-stop" />
                </div>
            }
        }
    </div>

    @if (itemScene == null)
    {
        <div style="font-size:11px; color:orange; text-align:center;">No scene configured — edit this item</div>
    }
    else if (contextual)
    {
        @* ── Context navigation buttons ── *@
        <div style="display:flex; flex-wrap:wrap; gap:3px; justify-content:center; margin:2px 0;">
            @foreach (var context in itemScene.Contexts)
            {
                var c = context;
                bool isCurrent = scenePlaying && scene?.CurrentContext?.Id == c.Id;
                <div class="da-ctx-btn @(isCurrent ? "da-ctx-btn-active" : "")"
                     title="@($"Switch to \"{c.Name}\" ({c.TransitionSeconds:0.#} s crossfade)")"
                     @onclick="() => EnterContextAsync(c)">@c.Name</div>
            }
        </div>
        @if (!scenePlaying)
        {
            <div style="font-size:11px; color:grey; text-align:center;">
                Click a context to start · @itemScene.CueSummary
            </div>
        }
    }
    else
    {
        @* ── Step sequence: shows the whole run order, and lets the user jump
             straight to any step instead of only advancing one at a time. ── *@
        <div class="da-step-strip">
            @for (int i = 0; i < itemScene.Steps.Count; i++)
            {
                var stepIndex = i;
                var step = itemScene.Steps[stepIndex];
                bool isCurrent = scenePlaying && scene?.CurrentStepIndex == stepIndex;
                <div class="da-step-chip @(isCurrent ? "da-step-chip-active" : "") @(step.Name.Length > StepNameScrollChars ? "da-step-scroll" : "")"
                     title="@($"Jump to step {stepIndex + 1}: {step.Name}")"
                     @onclick="() => GoToStepAsync(stepIndex)">
                    <span class="da-step-num">@(stepIndex + 1)</span>
                    <span class="da-step-label"><span class="da-step-label-text">@step.Name</span></span>
                </div>
            }
        </div>

        @if (itemScene.Steps.Count == 0)
        {
            <div class="da-step-caption" style="color:orange;">No step configured — edit this item</div>
        }
        else if (scenePlaying && scene?.CurrentStep != null)
        {
            <div class="da-step-caption" style="color:#90caf9;"
                 title="@scene.CurrentStep.Name">
                @(scene.CurrentStepIndex + 1)/@itemScene.Steps.Count · <b>@scene.CurrentStep.Name</b>
            </div>
        }
        else
        {
            <div class="da-step-caption" style="color:grey;">
                @itemScene.Steps.Count step(s) · click one to start there
            </div>
        }
    }
}
else if (Player != null)
{
    @* ── Transport controls ── *@
    <div style="display:flex; justify-content:center; margin:6px 0;">
        <div class="da-cmd-btn" @onclick="() => Player.SkipBackwardAsync()" title="Skip backward">
            <DaIcon Name="skip-previous" Size="20" Class="da-skip" />
        </div>

        @if (IsStarting)
        {
            <div class="da-cmd-btn da-cmd-btn-pending da-cmd-btn-staging" title="Starting — waiting for the fade out to finish">
                <DaIcon Name="hourglass" Size="22" style="color:var(--a1);" />
            </div>
        }
        else if (Player.State == DAScenarioItemPlayer.PlayState.Play)
        {
            <div class="da-cmd-btn" @onclick="() => Player.Pause()" title="Pause">
                <DaIcon Name="pause" Size="22" Class="da-pause" />
            </div>
        }
        else
        {
            <div class="da-cmd-btn" @onclick="RequestPlay" title="Play">
                <DaIcon Name="play" Size="22" Class="da-play" />
            </div>
        }

        @if (IsFadingOut)
        {
            <div class="da-cmd-btn da-cmd-btn-pending" title="Stopping — fading out">
                <DaIcon Name="stop" Size="20" Class="da-stop" />
            </div>
        }
        else
        {
            <div class="da-cmd-btn" @onclick="() => Player.StopWithFadeAsync()" title="Stop">
                <DaIcon Name="stop" Size="20" Class="da-stop" />
            </div>
        }
        <div class="da-cmd-btn" @onclick="() => Player.SkipForwardAsync()" title="Skip forward">
            <DaIcon Name="skip-next" Size="20" Class="da-skip" />
        </div>
    </div>

    @* ── Duration + progress ── *@
    <div style="font-size:11px; color:grey; margin:2px 0;">
        Duration: @TimeSpan.FromSeconds(Player.DisplayDuration).ToString(@"hh\:mm\:ss")
    </div>
    @* A native range brings dragging, touch and the arrow keys for free. --pp
       is what paints the played part of the track, which MudSlider drew itself. *@
    <input type="range" class="da-range" aria-label="Seek"
           style="@($"margin:0 0 4px 0; --pp:{SeekPercent};")"
           min="0" max="@(Math.Max(Player.Duration, 1))" step="1"
           value="@Inv(Player.CurrentPosition)" @oninput="OnSeekInput" />

    @* ── Next in queue ── *@
    @if (ScenarioItem.Type != DAScenarioItem.ItemType.Single && Player.NextAudioItem != null)
    {
        <div style="font-size:11px; color:#888; margin:3px 0;">
            Next: <b>@Player.NextAudioItem.Name</b>
        </div>
    }

    @* ── Sound effects ── *@
    @if (Player.ResolvedSounds.Count > 0)
    {
        <div style="font-size:11px; color:grey; margin-top:4px;">Sound effects</div>
        @for (int i = 0; i < Player.ResolvedSounds.Count; i++)
        {
            var idx = i;
            var sound = Player.ResolvedSounds[idx].Item;
            <div style="display:flex; align-items:center; gap:4px; background:#1a1a2e;
                        border-radius:6px; padding:3px 6px; margin:2px 0; font-size:12px;">
                @if (Player.IsSoundPlaying(idx))
                {
                    <div class="da-cmd-btn" style="width:30px;height:30px;"
                         @onclick="() => Player.StopSound(idx)" title="Stop">
                        <DaIcon Name="stop" Size="16" Class="da-stop" />
                    </div>
                }
                else
                {
                    <div class="da-cmd-btn" style="width:30px;height:30px;"
                         @onclick="() => Player.PlaySound(idx)" title="Play">
                        <DaIcon Name="play" Size="16" Class="da-play" />
                    </div>
                }
                <span>@sound.Name</span>
            </div>
        }
    }
}

@code {
    /// A double as the HTML a range input will actually accept. Razor renders
    /// a double in the CURRENT culture, so on a French locale value="0,37" is
    /// rejected and the thumb snaps elsewhere - while --pp, written invariantly,
    /// stays put. That disagreement is what made the thumb jitter and the fill
    /// stop matching it.
    static string Inv(double value) =>
        value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

    [Parameter] public DAScenarioItem ScenarioItem { get; set; } = default!;
    /// <summary>Owning scenario group — resolves group-local scenes.</summary>
    [Parameter] public DAScenarioGroup? Group { get; set; }
    [Parameter] public DAScenarioItemPlayer? Player { get; set; }
    /// <summary>Play was pressed and the handover fade towards this item is running.</summary>
    [Parameter] public bool IsStarting { get; set; }
    /// <summary>This item is fading to silence — stop pressed, or something took over.</summary>
    [Parameter] public bool IsFadingOut { get; set; }
    [Parameter] public Func<DAScenarioItem, Task>? OnRequestPlay { get; set; }
    /// <summary>Hands over to this item and starts its scene at a given cue.</summary>
    [Parameter] public Func<DAScenarioItem, int, Task>? OnRequestPlayAtCue { get; set; }

    private DAScenarioItemPlayer? _subscribedPlayer;

    /// <summary>
    /// Beyond this many characters a step name cannot fit the chip, so it scrolls
    /// instead of being cut off. Sized to the 88px label at 11px type.
    /// </summary>
    private const int StepNameScrollChars = 15;

    // All play requests route through the scenario player so the previously
    // active item is faded out first (Bug #1).
    async Task RequestPlay()
    {
        if (OnRequestPlay != null)
            await OnRequestPlay(ScenarioItem);
        else
            Player?.Play();
    }

    // Context buttons: when the item isn't active yet, route through the
    // coordinator first (fades out other items), then jump to the clicked
    // context — its transition supersedes the start-up fade cleanly.
    async Task EnterContextAsync(DASceneContext context)
    {
        if (Player == null) return;

        if (Player.State != DAScenarioItemPlayer.PlayState.Play && OnRequestPlay != null)
            await OnRequestPlay(ScenarioItem);

        await Player.EnterSceneContextAsync(context);
    }

    // Same routing for the linear step buttons: clicking a step on a stopped item
    // starts the item there rather than doing nothing.
    async Task GoToStepAsync(int stepIndex)
    {
        if (Player == null) return;

        // Idle item: hand over through the scenario so whatever else is playing
        // fades out, and let it start the scene directly on the clicked step —
        // starting at step 1 first would fire that step's cues on the way past.
        if (Player.State != DAScenarioItemPlayer.PlayState.Play && OnRequestPlayAtCue != null)
        {
            await OnRequestPlayAtCue(ScenarioItem, stepIndex);
            return;
        }

        await Player.GoToSceneCueAsync(stepIndex);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Probe the first track's length so the duration line isn't 00:00:00 before play.
        if (Player != null)
        {
            await Player.EnsureProbedDurationAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (Player != _subscribedPlayer)
        {
            if (_subscribedPlayer != null)
            {
                _subscribedPlayer.PlayStateChanged -= OnPlayStateChanged;
                _subscribedPlayer.PlayProgressionChanged -= OnProgressChanged;
            }
            _subscribedPlayer = Player;
            if (_subscribedPlayer != null)
            {
                _subscribedPlayer.PlayStateChanged += OnPlayStateChanged;
                _subscribedPlayer.PlayProgressionChanged += OnProgressChanged;
            }
        }
    }

    void OnPlayStateChanged(object? s, DAScenarioItemPlayer.PlayState _) => InvokeAsync(StateHasChanged);
    void OnProgressChanged(object? s, EventArgs e) => InvokeAsync(StateHasChanged);

    void SeekTo(double val) => Player?.Seek(val);

    /// MudSlider reported every move, so seeking stays bound to oninput rather
    /// than waiting for the drag to be released.
    void OnSeekInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(),
                            System.Globalization.NumberStyles.Float,
                            System.Globalization.CultureInfo.InvariantCulture,
                            out double seconds))
            SeekTo(seconds);
    }

    /// How much of the seek track is behind the thumb, as a CSS percentage.
    private string SeekPercent
    {
        get
        {
            double max = Math.Max(Player?.Duration ?? 1, 1);
            double done = Math.Clamp((Player?.CurrentPosition ?? 0) / max, 0, 1) * 100;
            return done.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
        }
    }

    public void Dispose()
    {
        if (_subscribedPlayer != null)
        {
            _subscribedPlayer.PlayStateChanged -= OnPlayStateChanged;
            _subscribedPlayer.PlayProgressionChanged -= OnProgressChanged;
        }
    }
}
