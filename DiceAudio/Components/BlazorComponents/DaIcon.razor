@*
    The app's icon vocabulary: one light stroked line, 24x24, drawn in
    currentColor so an icon always matches the text beside it.

    This replaces Material's filled glyphs everywhere EXCEPT the damage kinds,
    which keep MudIcon + DCHitPointsIcons.Resolve: those are data, the GM picks
    them per kind out of a fixed whitelist, and they are drawn on a coloured
    chip rather than next to text.

    Material's weight is the reason: a filled 24px glyph next to 12px text reads
    as the loudest thing in the row, which on a combat strip of twenty controls
    is exactly backwards. A 2px stroke at the text's own colour recedes.
*@

<svg class="da-i @Class"
     width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="@(IsSolid ? "currentColor" : "none")"
     stroke="@(IsSolid ? "none" : "currentColor")"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Attributes is null || !Attributes.ContainsKey("aria-label"))" focusable="false"
     @attributes="Attributes">@((MarkupString)Geometry)</svg>

@code {
    /// Name of the icon. Unknown names fall back to the question mark rather
    /// than rendering an empty box, so a typo is visible instead of invisible.
    [Parameter] public string Name { get; set; } = string.Empty;

    [Parameter] public int Size { get; set; } = 16;

    [Parameter] public double Stroke { get; set; } = 2;

    /// A few marks read better solid: a star that is "on", a recording dot.
    [Parameter] public bool Filled { get; set; } = false;

    [Parameter] public string? Class { get; set; }

    /// Anything else lands on the svg: a title, an aria-label, a style. Without
    /// this every caller that wanted a tooltip or a colour had to wrap the icon
    /// in a span. Note aria-hidden above steps aside when a label is supplied,
    /// so a labelled icon is announced instead of skipped.
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? Attributes { get; set; }

    /// Marks that are silhouettes rather than line drawings, so a caller never
    /// has to remember to pass Filled for them.
    private static readonly HashSet<string> AlwaysSolid =
        new(StringComparer.OrdinalIgnoreCase) { "github", "play", "pause", "stop" };

    private bool IsSolid => Filled || AlwaysSolid.Contains(Name ?? string.Empty);

    private string Geometry => Paths.TryGetValue(Name ?? string.Empty, out var p) ? p : Paths["help"];

