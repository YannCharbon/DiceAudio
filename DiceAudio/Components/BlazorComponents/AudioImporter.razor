@inject DiceAudioService DAService

@* ── Import existing audio files from disk into the library.
     Everything lands in the destination folder picked with the shared
     <FolderSelectField>; folder imports recreate their own structure as
     virtual subfolders of it. Optionally reads tags embedded in the files'
     Genre metadata (TRPG-Audio-Manager format). ── *@
@if (_visible)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.82); z-index:3000; overflow-y:auto;"
     @onclick="Hide">
    <div style="background:var(--s5); margin:4% auto; max-width:860px; border-radius:12px;
                padding:20px 24px; position:relative;"
         @onclick:stopPropagation="true">

        <h2 class="da-h2" style="margin-bottom:4px;">Import audio from disk</h2>
        <p class="da-sub" style="margin-bottom:14px;">
            Files are copied into the DiceAudio library — the originals are not touched.
        </p>

        @* ── Source pickers ── *@
        <div class="da-irow da-irow-wrap" style="gap:8px; margin-bottom:12px;">
            <button type="button" class="da-btn da-btn-fill" disabled="@_importing" @onclick="AddFiles">
                <DaIcon Name="audio-file" Size="18" />Add files…
            </button>
            @if (DAImportHelper.CanPickFolder)
            {
                <button type="button" class="da-btn da-btn-fill" disabled="@_importing" @onclick="AddFolder">
                    <DaIcon Name="folder-upload" Size="18" />Add folder (with subfolders)…
                </button>
            }
            @if (_entries.Count > 0)
            {
                <button type="button" class="da-btn da-btn-out" disabled="@_importing" @onclick="() => _entries.Clear()">
                    <DaIcon Name="delete" Size="18" />Clear list
                </button>
            }
        </div>

        @* ── Options ── *@
        <div style="background:var(--s4); border-radius:8px; padding:10px 14px; margin-bottom:12px;">
            <div class="da-irow da-irow-wrap" style="gap:16px;">
                <label class="da-chk">
                    <input type="checkbox" @bind="_importTags" />
                    Import tags from file metadata (Genre)
                </label>
                @* The native box takes `disabled` itself; the row around it is
                   left alone so the caption stays readable while it is off. *@
                <label class="da-chk">
                    <input type="checkbox" @bind="_detectKind" disabled="@(!_importTags)" />
                    Detect kind from tags (Music / Ambience / SFX)
                </label>
                <div class="da-field" style="max-width:170px;">
                    <span class="da-flabel">Default kind</span>
                    @* @bind on a select carries the enum both ways, which is what
                       MudSelect's two-way binding was doing. *@
                    <select class="da-inp" @bind="_kind">
                        <option value="@AudioKind.Music">Music</option>
                        <option value="@AudioKind.Ambiance">Ambiance</option>
                        <option value="@AudioKind.SoundEffect">Sound effect</option>
                    </select>
                </div>
            </div>
            <div style="margin-top:10px;">
                <FolderSelectField Label="Import into"
                                   Folder="@_targetFolder"
                                   FolderChanged="OnTargetFolderChanged"
                                   Hint="An imported folder recreates its own structure inside it."
                                   OnFolderCreated="OnFolderCreated" />
            </div>
        </div>

        @* ── Staged files ── *@
        @if (_entries.Count == 0)
        {
            <p style="color:var(--t3); padding:14px;">No files staged yet.</p>
        }
        else
        {
            <div style="max-height:320px; overflow-y:auto; border:1px solid var(--b1); border-radius:8px;">
                @foreach (var entry in _entries)
                {
                    var e = entry;
                    <div style="display:flex; align-items:center; gap:10px; padding:6px 12px;
                                border-bottom:1px solid var(--b1); font-size:13px;">
                        <DaIcon Name="audio-file" Size="16" style="color:var(--a2);" />
                        <span style="flex:1; word-break:break-all;">@e.Name</span>
                        <span style="color:var(--t3); font-size:12px;">@EntryFolderLabel(e)</span>
                        <button type="button" class="da-ib" title="Remove from the list"
                                aria-label="@($"Remove {e.Name} from the list")"
                                disabled="@_importing" @onclick="() => _entries.Remove(e)">
                            <DaIcon Name="close" Size="16" />
                        </button>
                    </div>
                }
            </div>
            <div class="da-meta">@_entries.Count file(s) staged</div>
        }

        @* ── Import ── *@
        <div class="da-irow da-irow-wrap" style="gap:12px; margin-top:14px;">
            <button type="button" class="da-btn da-btn-fill"
                    disabled="@(_importing || _entries.Count == 0)" @onclick="ImportAsync">
                <DaIcon Name="download" Size="18" />Import @(_entries.Count > 0 ? $"{_entries.Count} file(s)" : "")
            </button>
            @if (_importing)
            {
                @* The progress bar MudProgressLinear drew: a track and a fill,
                   its width written culture-invariantly so a comma decimal
                   separator cannot produce an invalid CSS length. *@
                <div style="flex:1; min-width:160px; height:6px; border-radius:3px;
                            background:var(--s2); overflow:hidden;">
                    <div style="height:100%; width:@ImportPercent; background:var(--a1);"></div>
                </div>
                <div class="da-meta">@_progress / @_progressTotal</div>
            }
            @if (!string.IsNullOrEmpty(_resultMessage))
            {
                <div style="color:var(--a2); font-size:13px;">@_resultMessage</div>
            }
            <div style="flex:1;"></div>
            <button type="button" class="da-btn da-btn-text" disabled="@_importing" @onclick="Hide">Close</button>
        </div>
    </div>
</div>
}

@code {
    [Parameter] public EventCallback OnImported { get; set; }

    private sealed class ImportEntry
    {
        public string FullPath = "";
        public string Name = "";
        public string[] FolderSegments = Array.Empty<string>();   // empty = straight into the destination
    }

    private bool _visible;
    private readonly List<ImportEntry> _entries = new();

    private bool _importTags = true;
    private bool _detectKind = true;
    private AudioKind _kind = AudioKind.Music;

    /// <summary>Destination folder - null means the root of the library.</summary>
    private DAVirtualAudioFolder? _targetFolder;

    private bool _importing;
    private int _progress;
    private int _progressTotal;
    private string _resultMessage = "";

    /// <summary>Progress-bar width, as a CSS length that never carries a comma.</summary>
    private string ImportPercent =>
        (_progressTotal <= 0 ? 0 : 100.0 * _progress / _progressTotal)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    public void Show()
    {
        _visible = true;
        _resultMessage = "";
        // Default to the folder past imports used, when it is still around;
        // otherwise the root - the field always says where files will land.
        _targetFolder ??= DAService.FindFolderByName("Imported");
        StateHasChanged();
    }

    async Task OnTargetFolderChanged(DAVirtualAudioFolder? folder)
    {
        _targetFolder = folder;
        await InvokeAsync(StateHasChanged);
    }

    async Task OnFolderCreated(DAVirtualAudioFolder folder) => await DAService.SaveAudioVirtualFoldersAsync();

    /// <summary>Where a staged entry will end up, destination folder included.</summary>
    string EntryFolderLabel(ImportEntry entry)
    {
        var destination = DAService.FolderDisplayPath(_targetFolder);
        if (entry.FolderSegments.Length == 0) return destination;
        var sub = string.Join(" / ", entry.FolderSegments);
        return _targetFolder == null ? sub : $"{destination} / {sub}";
    }

    async Task Hide()
    {
        if (_importing) return;
        _visible = false;
        StateHasChanged();
        await OnImported.InvokeAsync();
    }

    // ── Staging ─────────────────────────────────────────────────────────────

    async Task AddFiles()
    {
        var files = await DAImportHelper.PickFilesAsync();
        foreach (var path in files)
            Stage(path, Array.Empty<string>());
        StateHasChanged();
    }

    async Task AddFolder()
    {
        var root = await DAImportHelper.PickFolderAsync();
        if (root == null) return;

        var rootName = new DirectoryInfo(root).Name;
        foreach (var path in Directory.EnumerateFiles(root, "*", SearchOption.AllDirectories)
                                      .Where(DAImportHelper.IsAudioFile)
                                      .OrderBy(p => p))
        {
            var relativeDir = Path.GetRelativePath(root, Path.GetDirectoryName(path)!);
            var segments = relativeDir == "."
                ? new[] { rootName }
                : new[] { rootName }.Concat(relativeDir.Split(Path.DirectorySeparatorChar)).ToArray();
            Stage(path, segments);
        }
        StateHasChanged();
    }

    void Stage(string path, string[] segments)
    {
        if (_entries.Any(e => e.FullPath.Equals(path, StringComparison.OrdinalIgnoreCase))) return;
        _entries.Add(new ImportEntry
        {
            FullPath = path,
            Name = Path.GetFileName(path),
            FolderSegments = segments,
        });
    }

    // ── Import ──────────────────────────────────────────────────────────────

    async Task ImportAsync()
    {
        if (!DAService.CanWriteData)
        {
            _resultMessage = DiceAudio.Resources.Localization.Portability.DataFolderUnusable;
            return;
        }

        _importing = true;
        _progress = 0;
        _progressTotal = _entries.Count;
        _resultMessage = "";
        int imported = 0, skipped = 0, failed = 0;

        var audioDir = DAService.AudioDir;
        Directory.CreateDirectory(audioDir);

        foreach (var entry in _entries)
        {
            try
            {
                var itemName = Path.GetFileNameWithoutExtension(entry.Name);
                // A folder import recreates its own tree below the destination;
                // a single file goes straight into it.
                var folder = entry.FolderSegments.Length > 0
                    ? DAService.GetOrCreateFolderPath(entry.FolderSegments, _targetFolder)
                    : _targetFolder;
                var folderName = folder?.Name ?? DiceAudioService.RootFolderName;

                // Skip files already in the library (same name in the same folder).
                if (DAService.AudioItems.Any(a => a.Name == itemName && a.Folder.Name == folderName))
                {
                    skipped++;
                    continue;
                }

                var destName = DAImportHelper.GetUniqueLibraryFileName(audioDir, entry.Name);
                var sourcePath = entry.FullPath;
                await Task.Run(() => File.Copy(sourcePath, Path.Combine(audioDir, destName)));

                var tagNames = _importTags
                    ? DAImportHelper.ReadEmbeddedTagNames(sourcePath)
                    : new List<string>();

                var item = new DAAudioItem(itemName)
                {
                    LocalFileName = destName,
                    IsLocallyAvailable = true,
                    Kind = ResolveKind(tagNames),
                    Tags = tagNames.Select(t => new DAAudioTag(t)).ToList(),
                    Folder = folder ?? DiceAudioService.NewRootFolderMarker(),
                };
                DAService.AudioItems.Add(item);
                imported++;
            }
            catch
            {
                failed++;
            }

            _progress++;
            if (_progress % 5 == 0 || _progress == _progressTotal)
                await InvokeAsync(StateHasChanged);
        }

        await DAService.SaveAudioItemListAsync();
        await DAService.SaveAudioVirtualFoldersAsync();

        _entries.Clear();
        _importing = false;
        _resultMessage = $"Imported {imported} file(s)" +
                         (skipped > 0 ? $", skipped {skipped} duplicate(s)" : "") +
                         (failed > 0 ? $", {failed} failed" : "") + ".";
        await InvokeAsync(StateHasChanged);
    }

    // Tags written by the old TRPG-Audio-Manager include a "Type" category tag
    // (Music / Ambience / SFX) — use it to pick the right audio kind.
    AudioKind ResolveKind(List<string> tagNames)
    {
        if (!_importTags || !_detectKind) return _kind;
        if (tagNames.Any(t => t.Equals("SFX", StringComparison.OrdinalIgnoreCase))) return AudioKind.SoundEffect;
        if (tagNames.Any(t => t.Equals("Ambience", StringComparison.OrdinalIgnoreCase) ||
                              t.Equals("Ambiance", StringComparison.OrdinalIgnoreCase))) return AudioKind.Ambiance;
        if (tagNames.Any(t => t.Equals("Music", StringComparison.OrdinalIgnoreCase))) return AudioKind.Music;
        return _kind;
    }
}
