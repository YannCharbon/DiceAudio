@inject DiceAudioService DAService

@* ── Scene catalogue picker: browse by category, click to pick.
     Overlay z-index 5000: opens above the scenario item editor (3000). ── *@
@if (_visible)
{
<div style="position:fixed; top:0; left:0; width:100%; height:100%;
            background:rgba(0,0,0,0.82); z-index:5000; overflow-y:auto;"
     @onclick="Hide">
    <div style="background:#232338; margin:4% auto; max-width:860px; border-radius:12px;
                padding:20px 24px; position:relative;"
         @onclick:stopPropagation="true">

        <h4 style="margin-bottom:10px;">@_title</h4>

        @* The leading search mark and the clear button were MudTextField
           adornments; as a plain box they are absolutely placed inside it, which
           is how the rest of the app draws an adorned field. *@
        <div class="da-field" style="margin-bottom:12px;">
            <span style="position:relative; display:block;">
                <span style="position:absolute; left:9px; top:50%; transform:translateY(-50%);
                             color:var(--t3); pointer-events:none; display:inline-flex;">
                    <DaIcon Name="search" />
                </span>
                <input class="da-inp" type="text" spellcheck="false"
                       style="padding-left:32px; padding-right:32px;"
                       placeholder="Search by name or category…"
                       value="@_search"
                       @oninput="@(e => _search = e.Value?.ToString() ?? string.Empty)" />
                @if (_search.Length > 0)
                {
                    <button type="button" class="da-ib" title="Clear" aria-label="Clear"
                            style="position:absolute; right:2px; top:50%; transform:translateY(-50%);
                                   width:28px; height:28px;"
                            @onclick="() => _search = string.Empty">
                        <DaIcon Name="close" Size="14" />
                    </button>
                }
            </span>
        </div>

        @{ var groups = FilteredScenes()
               .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "(uncategorized)" : s.Category)
               .OrderBy(g => g.Key)
               .ToList(); }

        @if (!groups.Any())
        {
            <p style="padding:16px; color:grey;">@_emptyMessage</p>
        }

        <div style="max-height:520px; overflow-y:auto;">
            @foreach (var group in groups)
            {
                <div style="font-size:14px; font-weight:bold; color:#23a6ab;
                            border-bottom:1px solid #2a2a4a; padding:10px 4px 4px 4px;">
                    @group.Key
                </div>
                @foreach (var scene in group)
                {
                    var s = scene;
                    <div class="scp-row" @onclick="() => PickScene(s)">
                        <DaIcon Name="movie" Size="20" Class="da-i-accent" />
                        <div style="flex:1;">
                            <div style="font-weight:bold;">@s.Name</div>
                            <div style="font-size:12px; color:grey;">
                                @(s.Mode == DASceneMode.Contextual ? "Contextual" : "Linear") · @s.CueSummary
                            </div>
                        </div>
                        <DaIcon Name="chevron-right" Size="18" Class="da-i-muted" />
                    </div>
                }
            }
        </div>

        <div style="display:flex; justify-content:flex-end; margin-top:12px;">
            <button type="button" class="da-btn da-btn-text" @onclick="Hide">Cancel</button>
        </div>
    </div>
</div>
}

<style>
    .scp-row {
        display: flex; align-items: center; gap: 12px;
        background: #12121f; border: 1px solid #2a2a4a; border-radius: 8px;
        padding: 10px 14px; margin: 6px 0; cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
    }
    .scp-row:hover { background: #1a1a30; border-color: #5555aa; }
</style>

@code {
    [Parameter] public EventCallback<DAScene> OnPicked { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private bool _visible;
    private string _search = "";

    /// <summary>Scenes offered by the picker; null means the global catalogue.</summary>
    private IReadOnlyList<DAScene>? _source;
    private string _title = "";
    private string _emptyMessage = "";

    /// <summary>Opens the picker on the global scene catalogue.</summary>
    public void Show() => Show(null,
        "Pick a scene from the catalogue",
        "No scenes in the catalogue yet — create some on the Scenes page.");

    /// <summary>
    /// Opens the picker on an arbitrary set of scenes — used for the local scenes
    /// of a scenario group, which are browsed exactly like the catalogue.
    /// </summary>
    public void Show(IReadOnlyList<DAScene>? scenes, string title, string emptyMessage)
    {
        _source = scenes;
        _title = title;
        _emptyMessage = emptyMessage;
        _visible = true;
        _search = "";
        StateHasChanged();
    }

    async Task Hide()
    {
        _visible = false;
        StateHasChanged();
        await OnClosed.InvokeAsync();
    }

    IEnumerable<DAScene> FilteredScenes()
    {
        var scenes = (_source ?? DAService.Scenes).AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            scenes = scenes.Where(s =>
                s.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.Category.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
        return scenes;
    }

    async Task PickScene(DAScene scene)
    {
        await OnPicked.InvokeAsync(scene);
        await Hide();
    }
}
