@using Plugin.Maui.Audio
@inject IAudioManager AudioManager
@implements IDisposable

@* The host card draws the artwork, so the player is only the transport row:
   play/pause, stop, a seek track with a visible playhead, elapsed / total. *@

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="da-err" title="@_errorMessage">
        <MudIcon Icon="@Icons.Material.Filled.Warning"
                 Style="font-size:13px; vertical-align:-2px; margin-right:3px;" />@_errorMessage
    </div>
}

<div class="da-transport">
    <div class="da-transport-btns">
        @if (_isPlaying)
        {
            <button type="button" class="da-cmd-btn-sm da-pp" title="Pause" @onclick="PauseAudio">
                <MudIcon Icon="@Icons.Material.Filled.Pause" Class="da-pause" Style="font-size:21px;" />
            </button>
        }
        else
        {
            <button type="button" class="da-cmd-btn-sm da-pp" title="Play" @onclick="PlayAudio">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="da-play" Style="font-size:21px;" />
            </button>
        }
        <button type="button" class="da-cmd-btn-sm" title="Stop" @onclick="StopAudio">
            <MudIcon Icon="@Icons.Material.Filled.Stop" Class="da-stop" Style="font-size:19px;" />
        </button>
    </div>

    <div class="da-transport-seek">
        @* The bubble and the track fill both follow --pp, so the timestamp stays
           under the thumb while dragging. *@
        <div class="da-track" style="--pp:@ProgressPercent">
            <input type="range" class="da-range" min="0" max="@MaxPosition" step="1"
                   value="@_position" title="Drag to seek" aria-label="Seek"
                   @oninput="OnSeekInput" @onchange="OnSeekCommit" />
            <span class="da-bubble">@Format(_position)</span>
        </div>
        <span class="da-time"><b>@Format(_position)</b> / @Format((int)_duration)</span>
    </div>
</div>

@code {
    [Parameter] public DAAudioItem AudioItem { get; set; } = default!;

    /// <summary>
    /// Raised whenever playback starts or stops, so the host card can animate
    /// its hero while this item is playing.
    /// </summary>
    [Parameter] public EventCallback<bool> PlayingChanged { get; set; }

    private DAAudioPlayer? _player;
    private bool            _isPlaying;
    private double          _duration;
    private int             _position;
    private string          _errorMessage = string.Empty;

    // True while the user drags the thumb, so the ticker can't yank the
    // position back out from under them mid-drag.
    private bool            _seeking;

    private bool            _notifiedPlaying;
    private bool            _disposed;

    private int    MaxPosition     => (int)Math.Max(_duration, 1);
    private string ProgressPercent =>
        (_duration > 0 ? _position / _duration * 100.0 : 0.0)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Format(int seconds)
    {
        if (seconds < 0) seconds = 0;
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1 ? t.ToString(@"h\:mm\:ss") : t.ToString(@"m\:ss");
    }

    private readonly System.Timers.Timer _ticker = new(500);

    // Cache probed durations by file name so re-renders (and other cards showing
    // the same file) don't re-scan the mp3.
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, double> _durationCache = new();
    private DAAudioItem? _probedItem;

    protected override void OnInitialized()
    {
        _ticker.Elapsed += async (_, _) =>
        {
            if (_player?.IsPlaying == true && !_seeking)
            {
                _position = (int)_player.CurrentPosition;
                await InvokeAsync(StateHasChanged);
            }
        };
    }

    protected override void OnParametersSet()
    {
        // Show the real track length before the user presses play.
        if (!ReferenceEquals(AudioItem, _probedItem))
        {
            _probedItem = AudioItem;
            if (_player == null) _duration = 0;
            _ = ProbeDurationAsync();
        }
    }

    private async Task ProbeDurationAsync()
    {
        var item = AudioItem;
        if (item == null || !item.IsLocallyAvailable || string.IsNullOrEmpty(item.LocalFileName)) return;

        if (_durationCache.TryGetValue(item.LocalFileName, out var cached))
        {
            if (_player == null) { _duration = cached; await InvokeAsync(StateHasChanged); }
            return;
        }

        var probed = await Task.Run(() =>
        {
            var playablePath = DAScenarioItemPlayer.GetPlayablePath(item.LocalFileName);
            return playablePath == null ? 0 : DAAudioPlayer.ProbeDurationSeconds(playablePath, AudioManager);
        });

        if (probed > 0) _durationCache[item.LocalFileName] = probed;

        // Don't clobber a live player's duration, and only apply if we're still on the same item.
        if (_player == null && ReferenceEquals(item, AudioItem))
        {
            _duration = probed;
            await InvokeAsync(StateHasChanged);
        }
    }

    void PlayAudio()
    {
        _errorMessage = string.Empty;
        StopAudio();
        try
        {
            var playablePath = DAScenarioItemPlayer.GetPlayablePath(AudioItem.LocalFileName);
            if (playablePath == null) { _errorMessage = "File not found on disk"; return; }

            _player = DAAudioPlayer.Create(playablePath, AudioManager);
            _player.Volume = 1.0;
            _player.PlaybackEnded += OnPlaybackEnded;
            _duration = _player.Duration;
            _player.Play();
            _ticker.Start();
            _isPlaying = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.GetType().Name + ": " + ex.Message;
            _isPlaying = false;
        }
        NotifyPlaying();
    }

    void PauseAudio()
    {
        _player?.Pause();
        _ticker.Stop();
        _isPlaying = false;
        NotifyPlaying();
    }

    void StopAudio()
    {
        _ticker.Stop();
        if (_player != null)
        {
            _player.PlaybackEnded -= OnPlaybackEnded;
            _player.Stop();
            _player.Dispose();
            _player = null;
        }
        _isPlaying = false;
        _position = 0;
        NotifyPlaying();
    }

    // Only on an actual transition — PlayAudio stops first, so without this the
    // host card would see a redundant false/true pair on every play.
    void NotifyPlaying()
    {
        if (_disposed || _notifiedPlaying == _isPlaying) return;
        _notifiedPlaying = _isPlaying;
        if (PlayingChanged.HasDelegate) PlayingChanged.InvokeAsync(_isPlaying);
    }

    // While dragging, only the displayed position moves — seeking the player on
    // every input event would thrash it. The seek lands on release (change).
    void OnSeekInput(ChangeEventArgs e)
    {
        _seeking = true;
        if (int.TryParse(e.Value?.ToString(), out var v)) _position = v;
    }

    void OnSeekCommit(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) _position = v;
        _seeking = false;
        _player?.Seek(_position);
    }

    void OnPlaybackEnded(object? s, EventArgs e)
    {
        _ticker.Stop();
        _isPlaying = false;
        // Fires on the audio thread, so hop back to the renderer before
        // notifying the host card.
        InvokeAsync(() => { NotifyPlaying(); StateHasChanged(); });
    }

    public void Dispose()
    {
        _disposed = true;
        _ticker.Dispose();
        StopAudio();
    }
}
