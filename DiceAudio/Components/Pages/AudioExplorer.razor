    /// What an item without its file shows: its state, with Download and
    /// Pick file… when they apply, or the progress of its download.
    RenderFragment RenderFileStatus(DAAudioItem item) => __builder =>
    {
        var job = DownloadQueue.ActiveJobFor(item);
        var status = item.FileStatus();
        <div class="da-irow da-irow-wrap" style="gap:6px;">
            @if (job != null)
            {
                <span class="da-offline">
                    <DaIcon Name="cloud-download" Size="13" />
                    @(job.State == DADownloadState.Downloading ? string.Format(Portability.FileDownloading, item.SourceDownloadProgress) : Portability.FileWaiting)
                </span>
            }
            else
            {
                <span class="da-offline" style="white-space:nowrap;">
                    <DaIcon Name="@(status == DAFileStatus.NotDownloaded ? "cloud-download" : "folder-off")" Size="13" />
                    @(status switch
                    {
                        DAFileStatus.NotDownloaded => Portability.FileNotDownloaded,
                        DAFileStatus.NotFound => Portability.FileNotFound,
                        _ => Portability.FileNone,
                    })
                </span>
                @* The buttons stay together on one line; they move below the
                   state only as a pair, when the space is too narrow. *@
                <span class="da-irow" style="gap:4px; flex-wrap:nowrap;">
                    @if (item.CanDownload())
                    {
                        <button type="button" class="da-btn da-btn-out da-btn-sm" style="padding:0 8px; white-space:nowrap;" title="@Portability.DownloadHelp"
                                disabled="@(!DAService.CanWriteData)" @onclick="() => Download(new[] { item })">
                            <DaIcon Name="cloud-download" Size="14" />@Portability.DownloadBtn
                        </button>
                    }
                    @if (item.CanPickFile())
                    {
                        <button type="button" class="da-btn da-btn-out da-btn-sm" style="padding:0 8px; white-space:nowrap;" title="@Portability.PickFileHelp"
                                disabled="@(!DAService.CanWriteData)" @onclick="() => PickFile(item)">
                            <DaIcon Name="folder-open" Size="14" />@Portability.PickFileBtn
                        </button>
                    }
                </span>
            }
        </div>
    };

    /// Waiting for its first download, and not already in the download list.
    bool CanQueue(DAAudioItem item) => item.FileStatus() == DAFileStatus.NotDownloaded && DownloadQueue.ActiveJobFor(item) == null;

    void Download(IEnumerable<DAAudioItem> items)
    {
        if (!DAService.CanWriteData) return;
        DownloadQueue.EnqueueLibraryItems(items.ToList());
        StateHasChanged();
    }

    async Task PickFile(DAAudioItem item)
    {
        try
        {
            if (await Imports.PickFileForAsync(item)) StateHasChanged();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Debug.WriteLine($"Copying the picked file failed: {ex.Message}");
            Notifications.Show(Portability.PickFileBtn, ex.Message, PopupNotificationService.Type.FAILURE, 6000);
        }
    }

