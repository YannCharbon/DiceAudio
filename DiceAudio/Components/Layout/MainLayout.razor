@inherits LayoutComponentBase

@inject DiceAudioService AudioService
@inject DAStorageNotices Notices
@implements IDisposable

@using DiceAudio.Resources.Localization

<PopupNotification></PopupNotification>

<BundleExportDialog />

<ImportWizard />

@* A data file that could not be read at startup, a save that failed, or
   how a restore ended: the user must see it and acknowledge it, so it is a
   dialog rather than a toast that fades away. The messages live in
   DAStorageNotices, so they survive the rebuild of the pages after a restore. Drawn like DaConfirm, with a single button and
   no title, as in DiceCombats: there is nothing to decide, only something
   to know. *@
@if (_storageNotices.Count > 0)
{
    <div class="da-confirm-scrim">
        <div class="da-confirm" role="alertdialog" aria-modal="true">
            @foreach (var line in _storageNotices)
            {
                <p class="da-confirm-msg">@line</p>
            }
            <div class="da-confirm-foot">
                <button type="button" class="da-btn da-btn-fill" @onclick="CloseStorageNotice">
                    <DaIcon Name="check" />
                    @Portability.AlertCloseBtn
                </button>
            </div>
        </div>
    </div>
}

<div class="page">
    <!--<div class="sidebar">
        <NavMenu />
    </div>-->
    <DCNavMenu />


    @* On Windows the web page includes the 32px title strip above the 50px
       bar (WebTitleBar extends the webview to the window top), so the scroll
       area starts 82px down; elsewhere the bar alone is 50px. *@
    <main id="mainscroll" style="@(OperatingSystem.IsWindows() ? "margin-top:82px;height:calc(100vh - 82px);" : "")">
        <MudThemeProvider IsDarkMode="true" Theme="DCTheme" />
        <MudPopoverProvider />
        <MudDialogProvider />
        <MudSnackbarProvider />

        @* main already sits 50px below the top (under the fixed app bar); keep
           only the 20px breathing space here. *@
        <article class="content px-4" style="padding-top:20px;" id="mainpagebody">
            @Body
        </article>
    </main>
</div>

@code {
    MudTheme DCTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
            {
                Primary = "#e73c7e",
                Secondary = "#23a6ab",
            },
    };

    /// The messages waiting to be read, oldest first. Each one names its own
    /// file or says what happened, so they can be shown together without a
    /// title that would fit only some.
    private IReadOnlyList<string> _storageNotices = Array.Empty<string>();

    protected override void OnInitialized()
    {
        Notices.Changed += OnNoticesChanged;
        _storageNotices = Notices.Pending;
    }

    // Raised on whatever thread added the message.
    private void OnNoticesChanged() => _ = InvokeAsync(() =>
    {
        _storageNotices = Notices.Pending;
        StateHasChanged();
    });

    private void CloseStorageNotice() => Notices.DismissAll();

    public void Dispose()
    {
        Notices.Changed -= OnNoticesChanged;
    }
}
