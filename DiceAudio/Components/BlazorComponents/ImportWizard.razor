@*
    The import, in a dialog (spec §3.2 and §7.2). It sits in the main layout
    and opens when a page asks DAImportService for an import:
    the file → its audio files (when they are not next to it) → the choices
    (only when something conflicts; otherwise a summary and one button) →
    the import → the report and the audio files still to find.
*@

@using System.Diagnostics
@using DiceAudio.Portability
@using DiceAudio.Resources.Localization
@implements IDisposable
@inject DAImportService Import
@inject DiceAudioService AudioService

<style>
    .imp-dialog { width: min(560px, 100%); max-height: calc(100vh - 48px); display: flex; flex-direction: column; }
    .imp-wide { width: min(880px, 100%); }
    .imp-scroll { overflow-y: auto; min-height: 0; flex: 1 1 auto; padding-right: 4px; }
    .imp-foot { margin-top: 14px; }
    .imp-kind { font-size: 14px; font-weight: 700; color: var(--a3); border-bottom: 1px solid var(--b1); padding: 12px 2px 4px; margin: 4px 0 8px; }
    .imp-item { margin-bottom: 8px; }
    .imp-child { margin: 8px 0 0 18px; }
    .imp-name { font-weight: 600; color: var(--t1); overflow-wrap: anywhere; }
    .imp-status-warn { color: var(--warn); border-color: var(--warn); }
    .imp-help { font-size: 12.5px; color: var(--t3); margin-top: 4px; line-height: 1.5; }
    .imp-warn { font-size: 13px; color: var(--warn); margin-top: 6px; }
    .imp-note { margin-bottom: 10px; }
    .imp-note-warn { border-left-color: var(--warn); }
    .imp-list { margin: 0 0 12px; padding-left: 20px; font-size: 13.5px; line-height: 1.6; color: var(--t2); }
</style>

@if (_stage != Stage.Hidden)
{
    <div class="da-confirm-scrim">
        <div class="da-confirm imp-dialog @(IsWide ? "imp-wide" : "")" role="dialog" aria-modal="true" aria-labelledby="imp-title">
            @switch (_stage)
            {
                case Stage.Error:
                    <h3 id="imp-title" class="da-confirm-title">@Portability.WizardTitle</h3>
                    <div class="imp-scroll">
                        <p class="da-confirm-msg" style="color:var(--danger);">@_error</p>
                    </div>
                    <div class="da-confirm-foot imp-foot">
                        <button type="button" class="da-btn da-btn-fill" @onclick="Close"><DaIcon Name="check" /> @Portability.AlertCloseBtn</button>
                    </div>
                    break;

                case Stage.AskPack:
                    <h3 id="imp-title" class="da-confirm-title">@Portability.WizardTitle</h3>
                    <div class="imp-scroll">
                        <p class="da-confirm-msg">@Portability.MediaPackAsk</p>
                        @if (!string.IsNullOrEmpty(_session?.PackProblem))
                        {
                            <p class="imp-warn">@_session.PackProblem</p>
                        }
                    </div>
                    <div class="da-confirm-foot imp-foot">
                        <button type="button" class="da-btn" @onclick="Close">@Portability.WizardCancelBtn</button>
                        <button type="button" class="da-btn da-btn-out" @onclick="ContinueWithoutPack">@Portability.MediaPackSkipBtn</button>
                        <button type="button" class="da-btn da-btn-fill" @onclick="PickPack"><DaIcon Name="folder-open" /> @Portability.MediaPackOpenBtn</button>
                    </div>
                    break;

                case Stage.Review:
                    @RenderReview()
                    break;

                case Stage.Working:
                    <h3 id="imp-title" class="da-confirm-title">@Portability.WizardTitle</h3>
                    <p class="da-confirm-msg">@Portability.ImportWorking</p>
                    break;

                case Stage.Report:
                    @RenderReport()
                    break;
            }
        </div>
    </div>
}

@code {
    private enum Stage { Hidden, Error, AskPack, Review, Working, Report }

    private Stage _stage = Stage.Hidden;
    private string _error = "";
    private DAImportSession? _session;
    private DAImportResult? _result;
    private DAFollowUpReport? _followUp;
    private bool _imported;

    private static readonly DAAssetKind[] KindOrder =
    {
        DAAssetKind.ScenarioGroup, DAAssetKind.Scenario, DAAssetKind.ScenarioItem, DAAssetKind.LocalScene,
        DAAssetKind.Scene, DAAssetKind.Preset, DAAssetKind.AudioItem, DAAssetKind.Folder, DAAssetKind.Tag,
    };

    /// <summary>A merge with another data folder: the texts speak of "this folder", not "this file".</summary>
    private bool IsFolder => _session?.MergeAudioDir != null;

    /// <summary>The choices and a report with files to find need room; the other steps are short messages.</summary>
    private bool IsWide => (_stage == Stage.Review && _session?.Plan?.HasConflicts == true)
                           || (_stage == Stage.Report && _followUp?.Missing.Count > 0);

    /// <summary>The file holds nothing of what the page it was opened from is about.</summary>
    private string? _originWarning;

    /// <summary>Opened from the local scenes of a group: where the scenes of the file go.</summary>
    private string? _intoGroupNote;

    /// <summary>Set when the wizard was opened on a bundle by a merge; completed when it closes.</summary>
    private TaskCompletionSource<bool>? _completion;

    protected override void OnInitialized()
    {
        Import.Requested += OnRequested;
        Import.BundleRequested += OnBundleRequested;
    }

    public void Dispose()
    {
        Import.Requested -= OnRequested;
        Import.BundleRequested -= OnBundleRequested;
        _completion?.TrySetResult(false);
        _session?.Dispose();
    }

    private void OnBundleRequested(DAImportSession session, TaskCompletionSource<bool> completion) => _ = InvokeAsync(() =>
    {
        if (_stage is Stage.Working) { completion.TrySetResult(false); return; }
        _completion?.TrySetResult(false);
        _session?.Dispose();
        _session = session;
        _completion = completion;
        _result = null;
        _followUp = null;
        _imported = false;
        _originWarning = null;
        _intoGroupNote = null;
        Analyse();
        StateHasChanged();
    });

    private void OnRequested(DAImportRequest request) => _ = InvokeAsync(() => StartAsync(request));

    private async Task StartAsync(DAImportRequest request)
    {
        if (_stage is Stage.Working) return;
        _completion?.TrySetResult(false);
        _completion = null;
        _session?.Dispose();
        _session = null;
        _result = null;
        _followUp = null;
        _imported = false;
        _originWarning = null;
        _intoGroupNote = null;

        var (session, error, cancelled) = await Import.PickAndReadAsync();
        if (cancelled) return;
        if (session == null)
        {
            _error = error ?? Portability.ErrorUnreadableFile;
            _stage = Stage.Error;
            StateHasChanged();
            return;
        }

        _session = session;
        ApplyOrigin(request, session.Bundle);
        if (session.Bundle.MediaPack != null && session.Pack == null) _stage = Stage.AskPack;
        else Analyse();
        StateHasChanged();
    }

    /// The page the import was opened from: a warning when the file holds
    /// none of what that page is about, and from the local scenes of a group,
    /// the scenes of the file made local scenes of that group.
    private void ApplyOrigin(DAImportRequest request, DABundle bundle)
    {
        var group = request.GroupId is Guid id ? AudioService.ScenarioGroups.FirstOrDefault(g => g.Id == id) : null;
        if (!DAImportScope.HasExpectedContent(bundle, request.Origin))
        {
            _originWarning = request.Origin switch
            {
                DAImportOrigin.Explorer => Portability.ImportOriginNoAudio,
                DAImportOrigin.Scenes => Portability.ImportOriginNoScene,
                DAImportOrigin.Scenarios => Portability.ImportOriginNoScenario,
                DAImportOrigin.LocalScenes => string.Format(Portability.ImportOriginNoLocalScene, group?.Name ?? request.GroupName),
                _ => null,
            };
        }
        else if (request.Origin == DAImportOrigin.LocalScenes && group != null
                 && DAImportScope.ScenesIntoGroup(bundle, group.Id, group.Name) > 0)
        {
            _intoGroupNote = string.Format(Portability.ImportIntoGroupNote, group.Name);
        }
    }

    private async Task PickPack()
    {
        if (_session == null) return;
        if (await Import.PickPackAsync(_session) || _session.PackProblem == null) Analyse();
        // A pack that cannot be used: the question stays, with the reason.
    }

    private void ContinueWithoutPack()
    {
        if (_session == null) return;
        _session.PackProblem = null;
        Analyse();
    }

    private void Analyse()
    {
        Import.Analyse(_session!);
        _stage = Stage.Review;
    }

    // ── The review: the wizard, or a summary when nothing conflicts ─────

    private RenderFragment RenderReview() => __builder =>
    {
        var plan = _session!.Plan!;
        var planner = _session.Planner!;
        bool conflicts = plan.HasConflicts;
        bool nothing = plan.AllItems.All(i => i.Choice == ImportChoice.Nothing);

        <h3 id="imp-title" class="da-confirm-title">@(conflicts || nothing ? Portability.WizardTitle : Portability.ImportSummaryTitle)</h3>
        <div class="imp-scroll">
            @RenderNotes()

            @if (conflicts)
            {
                <p class="da-confirm-msg" style="margin-bottom:12px;">@(IsFolder ? Portability.WizardIntroFolder : Portability.WizardIntro)</p>

                @if (plan.AllItems.Any(i => i.NeedsNewName))
                {
                    <div class="da-msec" style="margin-bottom:6px;">
                        <div class="da-irow da-irow-wrap" style="gap:8px;">
                            <span style="font-weight:600; color:var(--t1);">@Portability.WizardNamesLabel</span>
                            <input class="da-inp" type="text" style="width:150px;" value="@planner.NamePrefix"
                                   aria-label="@Portability.WizardNamesBefore" title="@Portability.WizardNamesBefore"
                                   @oninput="@((ChangeEventArgs e) => planner.SetNameAffixes(plan, e.Value?.ToString(), planner.NameSuffix))" />
                            <span class="da-meta">@Portability.WizardNamesWord</span>
                            <input class="da-inp" type="text" style="width:150px;" value="@planner.NameSuffix"
                                   aria-label="@Portability.WizardNamesAfter" title="@Portability.WizardNamesAfter"
                                   @oninput="@((ChangeEventArgs e) => planner.SetNameAffixes(plan, planner.NamePrefix, e.Value?.ToString()))" />
                        </div>
                        <div class="imp-help">@Portability.WizardNamesHelp</div>
                    </div>
                }

                @foreach (var kind in KindOrder)
                {
                    var items = plan.Items.Where(i => i.Kind == kind).ToList();
                    if (items.Count == 0) continue;
                    var shown = items.Where(i => i.Status != ImportStatus.UpToDate || i.Children.Count > 0).ToList();
                    int upToDate = items.Count - shown.Count;

                    <div class="imp-kind">@KindLabel(kind)</div>
                    @foreach (var item in shown)
                    {
                        @RenderItem(item, false)
                    }
                    @if (upToDate > 0)
                    {
                        <div class="da-meta" style="margin:0 0 8px 2px;">@string.Format(Portability.ReportUpToDate, upToDate)</div>
                    }
                }
            }
            else if (nothing)
            {
                <p class="da-confirm-msg">@(IsFolder ? Portability.ImportNothingToDoFolder : Portability.ImportNothingToDo)</p>
            }
            else
            {
                <p class="da-confirm-msg" style="margin-bottom:4px;">@(IsFolder ? Portability.ImportSummaryTextFolder : Portability.ImportSummaryText)</p>
                <ul class="imp-list">
                    @foreach (var kind in KindOrder)
                    {
                        int count = plan.Items.Count(i => i.Kind == kind && i.Inserts);
                        if (count > 0)
                        {
                            <li>@KindLabel(kind): @count</li>
                        }
                    }
                </ul>
            }

            @if (!nothing)
            {
                <p class="da-meta" style="margin:12px 0 0;">@Portability.ImportBackupNote</p>
            }
        </div>

        <div class="da-confirm-foot imp-foot">
            <button type="button" class="da-btn" @onclick="Close">@(nothing ? Portability.AlertCloseBtn : Portability.WizardCancelBtn)</button>
            @if (!nothing)
            {
                <button type="button" class="da-btn da-btn-fill" disabled="@(!NamesValid())" @onclick="ApplyAsync">
                    <DaIcon Name="check" /> @Portability.WizardConfirmBtn
                </button>
            }
        </div>
    };

    /// What the user should know before choosing: the page the import came
    /// from, references to things not in the file, an unusable audio file pack.
    private RenderFragment RenderNotes() => __builder =>
    {
        @if (_originWarning != null)
        {
            <div class="da-note imp-note imp-note-warn">@_originWarning</div>
        }
        @if (_intoGroupNote != null)
        {
            <div class="da-note imp-note">@_intoGroupNote</div>
        }
        @if (_session!.BrokenReferences > 0)
        {
            <div class="da-note imp-note imp-note-warn">@string.Format(IsFolder ? Portability.WarningBrokenReferencesFolder : Portability.WarningBrokenReferences, _session.BrokenReferences)</div>
        }
        @if (!string.IsNullOrEmpty(_session.PackProblem))
        {
            <div class="da-note imp-note imp-note-warn">@_session.PackProblem</div>
        }
    };

    private RenderFragment RenderItem(DAImportItem item, bool child) => __builder =>
    {
        var plan = _session!.Plan!;
        var planner = _session.Planner!;
        bool conflict = item.Status is ImportStatus.Differs or ImportStatus.NameUsed;
        <div class="da-msec imp-item @(child ? "imp-child" : "")">
            <div class="da-irow da-irow-wrap" style="gap:8px;">
                <span class="imp-name">@item.IncomingName</span>
                <span class="da-tag @(conflict ? "imp-status-warn" : "")">@StatusLabel(item.Status)</span>
            </div>
            @if (conflict && LocalName(item) is { } localName)
            {
                <div class="da-meta" style="margin-top:4px;">@Portability.WizardInLibrary: @localName</div>
            }

            @if (item.NeedsTarget && !planner.Follows(item, out _))
            {
                @RenderTarget(item)
            }

            @if (item.AllowedChoices.Count > 1)
            {
                int same = ConflictPlanner.SameKindAndStatus(plan, item).Count;
                <div class="da-irow da-irow-wrap" style="gap:8px; margin-top:8px;">
                    <select class="da-inp" style="flex:0 1 300px; width:auto; min-width:220px;" value="@item.Choice"
                            aria-label="@item.IncomingName"
                            @onchange="@((ChangeEventArgs e) => Choose(item, e.Value))">
                        @foreach (var choice in item.AllowedChoices)
                        {
                            <option value="@choice">@ChoiceLabel(choice)</option>
                        }
                    </select>
                    @if (same > 1)
                    {
                        <button type="button" class="da-btn da-btn-out da-btn-sm"
                                @onclick="() => planner.ApplyToAllOfKind(plan, item.Kind, item.Status, item.Choice)">
                            @string.Format(Portability.ChoiceSameForAll, same, KindLabel(item.Kind).ToLowerInvariant(), StatusLabel(item.Status))
                        </button>
                    }
                </div>
                <div class="imp-help">@ChoiceHelp(item.Choice)</div>
            }

            @if (item.NeedsNewName)
            {
                <div class="da-field" style="margin-top:8px; max-width:420px;">
                    <span class="da-flabel">@Portability.WizardNewName</span>
                    <input class="da-inp" type="text" value="@item.NewName"
                           @oninput="@((ChangeEventArgs e) => planner.SetNewName(item, e.Value?.ToString()))" />
                    @if (NameProblem(item) is { } problem)
                    {
                        <span class="imp-warn">@problem</span>
                    }
                </div>
            }

            @if (item.Choice == ImportChoice.Skip && planner.DependentsOf(plan, item) is { Count: > 0 } users)
            {
                <div class="imp-warn">
                    <b>@Portability.WizardSkipWarningTitle.</b>
                    @string.Format(Portability.WizardSkipWarning, item.IncomingName, string.Join(", ", users.Select(u => u.IncomingName)))
                </div>
            }

            @foreach (var c in item.Children)
            {
                @RenderItem(c, true)
            }
        </div>
    };

    private void Choose(DAImportItem item, object? value)
    {
        if (Enum.TryParse<ImportChoice>(value?.ToString(), out var choice))
            _session!.Planner!.SetChoice(_session.Plan!, item, choice);
    }

    /// The container a group part goes into: a local group, or a new one (scenario items: a scenario).
    private RenderFragment RenderTarget(DAImportItem item) => __builder =>
    {
        bool scenarioTarget = item.Kind == DAAssetKind.ScenarioItem;
        string current = item.TargetContainerId is Guid t && t != Guid.Empty ? t.ToString() : "new";
        string newLabel = scenarioTarget
            ? string.Format(Portability.TargetNewScenario, item.TargetContainerNewName ?? NewScenarioName(item))
            : string.Format(Portability.TargetNewGroup, item.TargetContainerNewName ?? NewGroupName(item));

        <div class="da-field" style="margin-top:8px; max-width:520px;">
            <span class="da-flabel">@(scenarioTarget ? Portability.TargetScenarioLabel : Portability.TargetGroupLabel)</span>
            <select class="da-inp" value="@current"
                    @onchange="@((ChangeEventArgs e) => SetTarget(item, e.Value?.ToString()))">
                @if (scenarioTarget)
                {
                    @foreach (var g in AudioService.ScenarioGroups)
                    {
                        @foreach (var s in g.Scenarios)
                        {
                            <option value="@s.Id">@g.Name / @s.Name</option>
                        }
                    }
                }
                else
                {
                    @foreach (var g in AudioService.ScenarioGroups)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                }
                <option value="new">@newLabel</option>
            </select>
        </div>
    };

    private void SetTarget(DAImportItem item, string? value)
    {
        var plan = _session!.Plan!;
        if (Guid.TryParse(value, out var id)) _session.Planner!.SetTarget(plan, item, id, null);
        else _session.Planner!.SetTarget(plan, item, Guid.Empty, null);
    }

    private string NewGroupName(DAImportItem item) => item.Incoming switch
    {
        DALocalSceneRecord r => _session!.Planner!.NewGroupName(_session.Plan!, r.SourceGroupName),
        DAScenarioRecord r => _session!.Planner!.NewGroupName(_session.Plan!, r.SourceGroupName),
        _ => "",
    };

    private static string NewScenarioName(DAImportItem item) => item.Incoming is DAScenarioItemRecord r ? r.SourceScenarioName : "";

    private string? NameProblem(DAImportItem item)
    {
        if (string.IsNullOrWhiteSpace(item.NewName)) return Portability.WizardNameEmpty;
        return _session!.Planner!.IsNameAvailable(_session.Plan!, item, item.NewName!) ? null : Portability.WizardNameTaken;
    }

    private bool NamesValid() => _session?.Plan?.AllItems.Where(i => i.NeedsNewName).All(i => NameProblem(i) == null) ?? false;

    private static string? LocalName(DAImportItem item) => item.Local switch
    {
        DAAudioItem a => a.Name,
        DAScene s => s.Name,
        DAPreset p => p.Name,
        DAScenarioGroup g => g.Name,
        DAScenario s => s.Name,
        DAScenarioItem i => i.Name,
        DAVirtualAudioFolder f => f.Name,
        _ => null,
    };

    // ── Apply, then the report ─────────────────────────────────────────

    private async Task ApplyAsync()
    {
        if (_session?.Plan == null) return;
        // A name may have been made invalid since the button was drawn: stay on the choices.
        if (!NamesValid())
        {
            _stage = Stage.Review;
            return;
        }
        _stage = Stage.Working;
        StateHasChanged();
        try
        {
            _result = await Import.ApplyAsync(_session);
            _imported = true;
            _followUp = await Import.FollowUpAsync(_session, _result);
            _stage = Stage.Report;
        }
        catch (DAImportBlockedException ex)
        {
            // Nothing was changed: a file that could not be read is never saved over.
            _error = string.Format(Portability.ErrorLoadFailed, ex.FileName);
            _stage = Stage.Error;
        }
        catch (DAImportRollbackFailedException ex)
        {
            Debug.WriteLine($"Import and rollback failed: {ex}");
            _error = string.Format(Portability.ImportRollbackFailed, ex.BackupFileName ?? "");
            _stage = Stage.Error;
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Import failed: {ex}");
            _error = string.Format(Portability.ImportFailed, ex is DAImportFailedException f ? f.Message : ex.Message);
            _stage = Stage.Error;
        }
    }

    private RenderFragment RenderReport() => __builder =>
    {
        var r = _result!.Report;
        <h3 id="imp-title" class="da-confirm-title">@Portability.ImportReportTitle</h3>
        <div class="imp-scroll">
            <ul class="imp-list">
                @if (r.Added > 0) { <li>@string.Format(Portability.ReportAdded, r.Added)</li> }
                @if (r.Replaced > 0) { <li>@string.Format(Portability.ReportReplaced, r.Replaced)</li> }
                @if (r.KeptLocal > 0) { <li>@string.Format(Portability.ReportKeptLocal, r.KeptLocal)</li> }
                @if (r.Merged > 0) { <li>@string.Format(Portability.ReportMerged, r.Merged)</li> }
                @if (r.Skipped > 0) { <li>@string.Format(Portability.ReportSkipped, r.Skipped)</li> }
                @if (r.UpToDate > 0) { <li>@string.Format(Portability.ReportUpToDate, r.UpToDate)</li> }
            </ul>
            @foreach (var problem in r.Problems)
            {
                <p class="imp-warn">@problem</p>
            }

            @if (_followUp is { } f && (f.FromPack + f.Matched + f.Queued + f.Missing.Count + f.Rejected.Count > 0 || f.NotEnoughSpace != null))
            {
                <div class="imp-kind">@Portability.FollowUpTitle</div>
                <ul class="imp-list">
                    @if (f.FromPack > 0) { <li>@string.Format(Portability.FollowUpFromPack, f.FromPack)</li> }
                    @if (f.Matched > 0) { <li>@string.Format(Portability.FollowUpMatched, f.Matched)</li> }
                    @if (f.Queued > 0) { <li>@string.Format(Portability.FollowUpQueued, f.Queued)</li> }
                </ul>
                @if (f.NotEnoughSpace is { } space)
                {
                    <p class="imp-warn">@string.Format(Portability.MoveErrorNoSpace, DABundleExportService.FormatSize(space.Needed), DABundleExportService.FormatSize(space.Available))</p>
                }
                @foreach (var name in f.Rejected)
                {
                    <p class="imp-warn">@string.Format(Portability.MediaPackFileRejected, name)</p>
                }

                @if (f.Missing.Count > 0)
                {
                    <div style="font-weight:700; margin:10px 0 4px; color:var(--t1);">@Portability.FollowUpMissingTitle</div>
                    <p class="imp-help" style="margin-bottom:8px;">@Portability.FollowUpMissingHelp</p>
                    @foreach (var item in f.Missing)
                    {
                        var it = item;
                        <div class="da-msec imp-item da-irow" style="gap:10px; padding:8px 12px;">
                            <span class="imp-name" style="flex:1;">@it.Name</span>
                            @if (it.IsLocallyAvailable)
                            {
                                <DaIcon Name="check-circle" Size="20" style="color:var(--ok);" />
                            }
                            else
                            {
                                <button type="button" class="da-btn da-btn-out da-btn-sm" title="@Portability.PickFileHelp" @onclick="() => PickFile(it)">
                                    <DaIcon Name="folder-open" Size="16" /> @Portability.PickFileBtn
                                </button>
                            }
                        </div>
                    }
                }
            }
        </div>

        <div class="da-confirm-foot imp-foot">
            <button type="button" class="da-btn da-btn-fill" @onclick="Close"><DaIcon Name="check" /> @Portability.AlertCloseBtn</button>
        </div>
    };

    private async Task PickFile(DAAudioItem item)
    {
        try
        {
            await Import.PickFileForAsync(item);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Debug.WriteLine($"Copying the picked file failed: {ex.Message}");
        }
    }

    private void Close()
    {
        _session?.Dispose();
        _session = null;
        _stage = Stage.Hidden;

        // A merge goes on with the move, then the app restarts: the pages are
        // not rebuilt here, which would end the page that waits for this.
        if (_completion != null)
        {
            var completion = _completion;
            _completion = null;
            completion.TrySetResult(_imported);
            return;
        }

        // Every page held its view of the library from before the import.
        if (_imported) (Application.Current as App)?.ReloadPages();
    }

    // ── Labels (spec §8) ───────────────────────────────────────────────

    private static string KindLabel(DAAssetKind kind) => kind switch
    {
        DAAssetKind.Tag => Portability.KindTag,
        DAAssetKind.Folder => Portability.KindFolder,
        DAAssetKind.AudioItem => Portability.KindAudioItem,
        DAAssetKind.Scene => Portability.KindScene,
        DAAssetKind.LocalScene => Portability.KindLocalScene,
        DAAssetKind.ScenarioItem => Portability.KindScenarioItem,
        DAAssetKind.Scenario => Portability.KindScenario,
        DAAssetKind.ScenarioGroup => Portability.KindScenarioGroup,
        _ => Portability.KindPreset,
    };

    private static string StatusLabel(ImportStatus status) => status switch
    {
        ImportStatus.New => Portability.StatusNew,
        ImportStatus.UpToDate => Portability.StatusUpToDate,
        ImportStatus.Differs => Portability.StatusDiffers,
        _ => Portability.StatusNameUsed,
    };

    private static string ChoiceLabel(ImportChoice choice) => choice switch
    {
        ImportChoice.Nothing => Portability.ChoiceNothing,
        ImportChoice.Import => Portability.ChoiceImport,
        ImportChoice.Skip => Portability.ChoiceSkip,
        ImportChoice.ImportAsCopy => Portability.ChoiceImportAsCopy,
        ImportChoice.ReplaceLocal => Portability.ChoiceReplaceLocal,
        ImportChoice.KeepLocal => Portability.ChoiceKeepLocal,
        ImportChoice.Merge => Portability.ChoiceMerge,
        ImportChoice.ImportWithNewName => Portability.ChoiceImportWithNewName,
        ImportChoice.KeepBothSameName => Portability.ChoiceKeepBothSameName,
        _ => Portability.ChoiceUseLocal,
    };

    private static string ChoiceHelp(ImportChoice choice) => choice switch
    {
        ImportChoice.Import => Portability.ChoiceImportHelp,
        ImportChoice.Skip => Portability.ChoiceSkipHelp,
        ImportChoice.ImportAsCopy => Portability.ChoiceImportAsCopyHelp,
        ImportChoice.ReplaceLocal => Portability.ChoiceReplaceLocalHelp,
        ImportChoice.KeepLocal => Portability.ChoiceKeepLocalHelp,
        ImportChoice.Merge => Portability.ChoiceMergeHelp,
        ImportChoice.ImportWithNewName => Portability.ChoiceImportWithNewNameHelp,
        ImportChoice.KeepBothSameName => Portability.ChoiceKeepBothSameNameHelp,
        ImportChoice.UseLocal => Portability.ChoiceUseLocalHelp,
        _ => "",
    };
}
