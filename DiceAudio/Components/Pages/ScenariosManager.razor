@page "/scenarios/{groupId}"
@inject DiceAudioService DAService
@inject DAPlaybackCoordinator Coordinator
@inject PopupNotificationService Notifications
@inject NavigationManager NavManager
@inject DABundleExportService Exports

<style>
    .scm-header {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    /* Save and Settings stay anchored to the right edge of the row, where the
       full-width name field used to push them before the title replaced it. */
    .scm-header-actions {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Group-level tab strip */
    .scm-tabs {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--b1);
        margin-bottom: 14px;
    }
    .scm-tab {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 14px;
        color: #9a9ab5;
        border: 1px solid transparent;
        border-bottom: none;
        border-radius: 8px 8px 0 0;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s, color 0.15s;
    }
    .scm-tab:hover { background: #1a1a30; color: #d0d0e5; }
    .scm-tab-active {
        background: #12121f;
        border-color: #2a2a4a;
        color: #23a6d5;
        font-weight: bold;
        margin-bottom: -1px;
    }

    /* Local scene cards — same responsive grid as the Scenes catalogue page */
    .gls-card {
        border-radius: 12px;
        background: #12121f;
        border: 1px solid var(--b1);
        padding: 16px 18px;
        margin: 10px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: box-shadow 0.2s, border-color 0.2s;
    }
    .gls-card:hover {
        box-shadow: 0 4px 16px rgba(255,255,255,0.08);
        border-color: #444470;
    }
    .gls-cat-header {
        font-size: 15px; font-weight: bold; color: var(--a3);
        border-bottom: 1px solid var(--b1);
        padding: 14px 4px 4px 4px; margin: 4px 8px;
    }
</style>

@if (_group == null)
{
    <p style="padding:20px; color:grey;">Scenario group not found.</p>
    <button type="button" class="da-btn da-btn-text"
            @onclick='() => NavManager.NavigateTo("scenarios")'>
        <DaIcon Name="arrow-back" Size="16" />
        Back to scenarios
    </button>
}
else
{
    <div class="scm-header">
        <button type="button" class="da-btn da-btn-text"
                @onclick='() => NavManager.NavigateTo("scenarios")'>
            <DaIcon Name="arrow-back" Size="16" />
            Back
        </button>

        @* The name reads as the title of the page; the text field only appears
           once the pencil is pressed, since renaming is the rare operation. *@
        @if (_renamingGroup)
        {
            @* The sized wrapper stays: a .da-inp is width:100% too, so as a bare
               flex item it would eat the row and shove the confirm/cancel right. *@
            <div style="width:380px;">
                <label class="da-field">
                    <span class="da-flabel">Group name</span>
                    <input class="da-inp" type="text" spellcheck="false"
                           @bind="_nameEdit" @bind:event="oninput" />
                </label>
            </div>
            <button type="button" class="da-ib" title="Rename this scenario group"
                    aria-label="Rename this scenario group" @onclick="ConfirmRename">
                <DaIcon Name="check" Size="18" />
            </button>
            <button type="button" class="da-ib" title="Cancel" aria-label="Cancel"
                    @onclick="() => _renamingGroup = false">
                <DaIcon Name="close" Size="18" />
            </button>
        }
        else
        {
            <span style="font-size:24px; font-weight:bold;">@_group.Name</span>
            <button type="button" class="da-ib" title="Rename this scenario group"
                    aria-label="Rename this scenario group" @onclick="StartRename">
                <DaIcon Name="edit" Size="18" />
            </button>
        }

        @* Status chips and the two buttons share the right-hand group, so the
           header reads name on the left, state and actions on the right. *@
        <div class="scm-header-actions">
            @if (!string.IsNullOrWhiteSpace(_group.Collection))
            {
                @* Which collection the group is filed under — changed from Settings. *@
                <span class="da-tag" title="Collection this scenario group is filed under">
                    <DaIcon Name="folder-open" Size="13" />
                    @_group.Collection
                </span>
            }

            @if (!_group.StopOtherScenariosOnPlay)
            {
                @* Color.Info was the selection blue, which is the --a2 token. *@
                <span class="da-tag" style="color:var(--a2); border-color:var(--a2);"
                      title="The scenarios of this group play on top of each other instead of stopping each other">
                    <DaIcon Name="layers" Size="13" />
                    Scenarios layer
                </span>
            }

            <button type="button" class="da-btn da-btn-out" @onclick="() => Exports.ExportGroup(_group)">
                <DaIcon Name="upload" Size="16" />
                @DiceAudio.Resources.Localization.Portability.ExportGroupBtn
            </button>

            <button type="button" class="da-btn da-btn-fill" @onclick="() => _groupSettings?.Show()">
                <DaIcon Name="settings" Size="16" />
                Settings
            </button>
        </div>
    </div>

    <div class="scm-tabs">
        <div class="scm-tab @(_tab == GroupTab.Scenarios ? "scm-tab-active" : "")"
             @onclick="() => _tab = GroupTab.Scenarios">
            <DaIcon Name="playlist" Size="18" />
            Scenarios (@_group.Scenarios.Count)
        </div>
        <div class="scm-tab @(_tab == GroupTab.LocalScenes ? "scm-tab-active" : "")"
             @onclick="() => _tab = GroupTab.LocalScenes">
            <DaIcon Name="movie" Size="18" />
            Local scenes (@_group.LocalScenes.Count)
        </div>
    </div>

    @* Kept mounted while the other tab shows, so the playback transports and the
       drag-to-reorder JS of every scenario survive tab switches. *@
    <div style="@(_tab == GroupTab.Scenarios ? "" : "display:none;")">
        @foreach (var scenario in _group.Scenarios)
        {
            <ScenarioCreator Scenario="scenario"
                             Group="_group"
                             DAService="DAService"
                             MoveScenario="MoveScenario"
                             DeleteScenario="DeleteScenario" />
        }

        <div style="padding:10px;">
            <button type="button" class="da-btn da-btn-fill" @onclick="AddScenario">
                <DaIcon Name="add" Size="16" />
                Add scenario
            </button>
        </div>
    </div>

    @* Local scenes: the private scene catalogue of this scenario group *@
    @if (_tab == GroupTab.LocalScenes)
    {
        <p class="da-sub" style="margin-bottom:12px;">
            Scenes that belong to this scenario group only. They behave exactly like
            catalogue scenes and can be picked by any item of any scenario in the group —
            several items may share one, so editing it here updates all of them.
        </p>

        <div class="da-irow da-irow-wrap" style="gap:8px; margin-bottom:12px;">
            <button type="button" class="da-btn da-btn-fill" @onclick="CreateLocalScene">
                <DaIcon Name="add" Size="16" />
                New local scene
            </button>

            @if (_group.LocalScenes.Count > 0)
            {
                <button type="button" class="da-btn da-btn-out" @onclick="() => Exports.ExportGroupScenes(_group)">
                    <DaIcon Name="upload" Size="16" />
                    @DiceAudio.Resources.Localization.Portability.ExportGroupScenesBtn
                </button>
            }

            @if (DAService.Scenes.Count > 0)
            {
                @* An open book for the catalogue: the set has no stack-of-books
                   mark and this is the one it uses for a body of material. *@
                <button type="button" class="da-btn da-btn-out" @onclick="() => _scenePicker?.Show()">
                    <DaIcon Name="auto-stories" Size="16" />
                    Copy from catalogue…
                </button>
            }

            @{ var scenePresets = DAService.Presets.Where(p => p.Kind == DAPresetKind.Scene).ToList(); }
            @if (scenePresets.Count > 0)
            {
                @* The house set has no menu widget, so the preset list is a button
                   that reveals a .da-pop. The fixed sheet behind it keeps MudMenu's
                   click-anywhere-to-dismiss, which a bare popover would lose. *@
                <div style="position:relative;">
                    <button type="button" class="da-btn da-btn-out"
                            @onclick="() => _presetMenuOpen = !_presetMenuOpen">
                        <DaIcon Name="bookmark" Size="16" />
                        From preset
                        <DaIcon Name="chevron-down" Size="16" />
                    </button>
                    @if (_presetMenuOpen)
                    {
                        <div style="position:fixed; inset:0; z-index:59;"
                             @onclick="() => _presetMenuOpen = false"></div>
                        <div class="da-pop">
                            @foreach (var preset in scenePresets)
                            {
                                var p = preset;
                                <button type="button" class="da-btn da-btn-text"
                                        style="width:100%; justify-content:flex-start;"
                                        @onclick="() => InsertScenePreset(p)">
                                    @(string.IsNullOrEmpty(p.Category) ? p.Name : $"{p.Category} / {p.Name}")
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (_group.LocalScenes.Count == 0)
        {
            <p style="color:grey; padding:12px 4px;">
                No local scene yet. Create one here, or build a scene inside a scenario item
                and press “Move to local scenes” in its editor.
            </p>
        }

        @foreach (var category in _group.LocalScenes
            .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "(uncategorized)" : s.Category)
            .OrderBy(g => g.Key))
        {
            <div class="gls-cat-header">@category.Key</div>
            <div class="row">
                @foreach (var localScene in category)
                {
                    var sc = localScene;
                    var users = _group.ItemsUsingLocalScene(sc).Count();
                    <div class="col col-md-5 gls-card">
                        <div class="da-icon"><DaIcon Name="movie" Size="24" /></div>
                        <div style="flex:1; min-width:0;">
                            <div class="da-strip-name">@sc.Name</div>
                            <div class="da-meta">
                                @(sc.Mode == DASceneMode.Contextual ? "Contextual" : "Linear") · @sc.CueSummary
                            </div>
                            <div class="da-meta">
                                @(users == 0 ? "unused" : $"used by {users} item(s)")
                            </div>
                        </div>
                        <button type="button" class="da-ib" title="Edit scene" aria-label="Edit scene"
                                @onclick="() => EditLocalScene(sc)">
                            <DaIcon Name="edit" Size="18" />
                        </button>
                        <button type="button" class="da-ib" title="Duplicate" aria-label="Duplicate"
                                @onclick="() => DuplicateLocalScene(sc)">
                            <DaIcon Name="copy" Size="18" />
                        </button>
                        <button type="button" class="da-ib" title="Export" aria-label="Export"
                                @onclick="() => Exports.ExportLocalScene(_group, sc)">
                            <DaIcon Name="upload" Size="18" />
                        </button>
                        <button type="button" class="da-ib"
                                title="Make global — copy this scene into the scene catalogue so every scenario group can use it"
                                aria-label="Make global"
                                @onclick="() => MakeLocalSceneGlobalAsync(sc)">
                            <DaIcon Name="public" Size="18" Class="da-i-info" />
                        </button>
                        <button type="button" class="da-ib da-danger" title="Delete" aria-label="Delete"
                                @onclick="() => DeleteLocalScene(sc)">
                            <DaIcon Name="delete" Size="18" />
                        </button>
                    </div>
                }
            </div>
        }
    }

    <ScenarioGroupSettings @ref="_groupSettings" Group="_group"
                           OnDelete="DeleteGroup" OnClosed="StateHasChanged" />

    <SceneEditor @ref="_sceneEditor" OnClose="OnLocalSceneEditorClosed" />
    <ScenePicker @ref="_scenePicker" OnPicked="CopySceneFromCatalogue" OnClosed="StateHasChanged" />
}

@code {
    [Parameter] public string GroupId { get; set; } = "";

    private DAScenarioGroup? _group;

    private enum GroupTab { Scenarios, LocalScenes }
    private GroupTab _tab = GroupTab.Scenarios;

    private bool _renamingGroup;
    private string _nameEdit = string.Empty;

    /// Whether the "From preset" popover of the local-scenes tab is showing.
    private bool _presetMenuOpen;

    private ScenarioGroupSettings? _groupSettings;
    private SceneEditor? _sceneEditor;
    private ScenePicker? _scenePicker;

    protected override void OnInitialized()
    {
        if (Guid.TryParse(GroupId, out var id))
            _group = DAService.ScenarioGroups.FirstOrDefault(g => g.Id == id);
    }

    void StartRename()
    {
        _nameEdit = _group?.Name ?? string.Empty;
        _renamingGroup = true;
    }

    /// Applied to a scratch field so cancelling really leaves the name alone.
    void ConfirmRename()
    {
        _renamingGroup = false;

        string newName = _nameEdit.Trim();
        if (_group == null || newName.Length == 0 || newName == _group.Name) return;

        _group.Name = newName;
        DAService.RequestScenarioGroupsSave();
    }

    void AddScenario()
    {
        _group?.Scenarios.Add(new DAScenario());
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void MoveScenario(DAScenario scenario, bool upNotDown)
    {
        if (_group == null) return;
        int idx = _group.Scenarios.IndexOf(scenario);
        if (idx < 0) return;
        if (upNotDown && idx > 0)
        {
            _group.Scenarios.RemoveAt(idx);
            _group.Scenarios.Insert(idx - 1, scenario);
        }
        else if (!upNotDown && idx < _group.Scenarios.Count - 1)
        {
            _group.Scenarios.RemoveAt(idx);
            _group.Scenarios.Insert(idx + 1, scenario);
        }
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void DeleteScenario(DAScenario scenario)
    {
        Coordinator.RemoveScenarioPlayer(scenario);   // stop + dispose its audio
        _group?.Scenarios.Remove(scenario);
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    async Task DeleteGroup()
    {
        if (_group != null)
        {
            foreach (var scenario in _group.Scenarios)
                Coordinator.RemoveScenarioPlayer(scenario);
            DAService.ScenarioGroups.Remove(_group);
        }
        // Awaited rather than queued: the page is about to go away, and the
        // deletion must not sit in a pending auto-save.
        await DAService.SaveScenarioGroupsAsync();
        NavManager.NavigateTo("scenarios");
    }

    // ── Local scenes ────────────────────────────────────────────────────────

    void CreateLocalScene()
    {
        if (_group == null) return;
        var scene = new DAScene { Name = "New local scene" };
        _group.LocalScenes.Add(scene);
        DAService.RequestScenarioGroupsSave();
        _sceneEditor?.Show(scene);
    }

    void EditLocalScene(DAScene scene) => _sceneEditor?.Show(scene);

    void InsertScenePreset(DAPreset preset)
    {
        _presetMenuOpen = false;
        var scene = preset.ToScene();   // independent deep copy, fresh ids
        if (scene == null || _group == null) return;
        _group.LocalScenes.Add(scene);
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void CopySceneFromCatalogue(DAScene source)
    {
        // Deep copy with fresh ids: the local scene is independent from the
        // catalogue one, so editing it never touches the global scene.
        var copy = DAPreset.FromScene(source).ToScene();
        if (copy == null || _group == null) return;
        _group.LocalScenes.Add(copy);
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    void DuplicateLocalScene(DAScene scene)
    {
        var copy = DAPreset.FromScene(scene).ToScene();
        if (copy == null || _group == null) return;
        copy.Name = scene.Name + " (copy)";
        _group.LocalScenes.Add(copy);
        DAService.RequestScenarioGroupsSave();
        StateHasChanged();
    }

    /// <summary>
    /// Publishes a copy of the local scene to the global catalogue, so it becomes
    /// usable from every scenario group. The local scene and the items referencing
    /// it are left untouched — the two copies then evolve independently.
    /// </summary>
    async Task MakeLocalSceneGlobalAsync(DAScene scene)
    {
        var copy = DAPreset.FromScene(scene).ToScene();
        if (copy == null) return;
        DAService.Scenes.Add(copy);
        await DAService.SaveScenesAsync();
        Notifications.Show("Scene made global",
                           $"\"{copy.Name}\" was copied to the scene catalogue.",
                           PopupNotificationService.Type.SUCCESS, 3000);
        StateHasChanged();
    }

    /// <summary>
    /// Removes a local scene. Items still referencing it keep playing the same
    /// content: each gets its own embedded copy, exactly as if the scene had been
    /// built inside the item.
    /// </summary>
    void DeleteLocalScene(DAScene scene)
    {
        if (_group == null) return;

        foreach (var item in _group.ItemsUsingLocalScene(scene).ToList())
        {
            item.Scene = DAPreset.FromScene(scene).ToScene();
            item.LocalSceneId = null;
        }
        _group.LocalScenes.Remove(scene);
        DAService.RequestScenarioGroupsSave();
        RefreshPlayers();
        StateHasChanged();
    }

    void OnLocalSceneEditorClosed()
    {
        // The editor writes straight into the local scene, which belongs to the
        // group, so closing it is a change of the group like any other.
        DAService.RequestScenarioGroupsSave();
        RefreshPlayers();
        StateHasChanged();
    }

    /// <summary>
    /// Reconciles every scenario player of the group after a local scene changed,
    /// so items pick the edit up on their next play without interrupting playback.
    /// </summary>
    void RefreshPlayers()
    {
        if (_group == null) return;
        foreach (var scenario in _group.Scenarios)
            Coordinator.GetOrCreateScenarioPlayer(scenario).Initialize();
    }
}
