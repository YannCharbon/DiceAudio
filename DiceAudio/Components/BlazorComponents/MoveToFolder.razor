@using DiceAudio
@inject DiceAudioService DAService

@* ── Moves one item, or a whole selection, to another virtual folder. The
     browsing itself is the shared <FolderBrowser>; this component only names
     what is moving and applies the move to the folder that comes back. ── *@

<style>
    .mtf-chip { background:#2a2a4a; border-radius:4px; padding:2px 7px;
                font-size:12px; color:#cfd3dc; }
</style>

<h3 style="margin-bottom:4px;">Move to folder</h3>

@if (_targets.Count > 0)
{
    <FolderBrowser ActionLabel="Move"
                   ActionIcon="@Icons.Material.Filled.DriveFileMove"
                   InitialFolder="@_initialFolder"
                   IsCurrent="AllTargetsIn"
                   AllowRoot="true"
                   OnFolderChosen="MoveTo"
                   OnFolderCreated="OnFolderCreated">
        <HeaderContent>
            <MudText Typo="Typo.body2" Style="color:grey; margin-bottom:12px;">
                <b>@TargetsLabel</b> — currently in <b>@CurrentFolderLabel</b>
            </MudText>

            @* In bulk mode, name what is about to move so the choice is never blind. *@
            @if (_targets.Count > 1)
            {
                <div style="display:flex; flex-wrap:wrap; gap:4px; margin:-6px 0 12px 0;">
                    @foreach (var target in _targets.Take(MaxNamesShown))
                    {
                        <span class="mtf-chip">@target.Name</span>
                    }
                    @if (_targets.Count > MaxNamesShown)
                    {
                        <span class="mtf-chip">+@(_targets.Count - MaxNamesShown) more</span>
                    }
                </div>
            }
        </HeaderContent>
        <FooterContent>
            @if (_moved)
            {
                <MudText Style="color:#4caf50; margin-top:12px;" Typo="Typo.body2">
                    Moved @(_movedCount == 1 ? "1 item" : $"{_movedCount} items") to <b>@CurrentFolderLabel</b> ✓
                </MudText>
            }
        </FooterContent>
    </FolderBrowser>
}

@code {
    /// <summary>Single-item mode — used when <see cref="AudioItems"/> is empty.</summary>
    [Parameter] public DAAudioItem? AudioItem { get; set; }

    /// <summary>
    /// Bulk mode: every item of the list is moved together. Takes precedence
    /// over <see cref="AudioItem"/> as soon as it carries anything.
    /// </summary>
    [Parameter] public IReadOnlyList<DAAudioItem>? AudioItems { get; set; }

    /// <summary>
    /// Raised right after a move so the caller can persist and, in bulk mode,
    /// drop its selection. The move itself happens on the "Move here" click, not
    /// when the dialog is closed.
    /// </summary>
    [Parameter] public EventCallback OnMoved { get; set; }

    private const int MaxNamesShown = 12;

    private List<DAAudioItem> _targets = new();
    private DAVirtualAudioFolder? _initialFolder;
    private bool _moved;
    private int _movedCount;

    protected override void OnParametersSet()
    {
        var targets = AudioItems is { Count: > 0 }
            ? AudioItems.ToList()
            : AudioItem is null ? new List<DAAudioItem>() : new List<DAAudioItem> { AudioItem };

        // Re-initialise whenever the caller points the dialog at another set:
        // start inside the items' current folder so their neighbours (and the
        // "current" marker) are visible.
        if (!targets.SequenceEqual(_targets))
        {
            _targets = targets;
            _moved = false;
            _movedCount = 0;
            _initialFolder = InitialViewFolder();
        }
    }

    private DAVirtualAudioFolder? InitialViewFolder()
    {
        // With a mixed selection the first item is as good a starting point as any.
        var itemFolder = DAService.CanonicalFolderOf(_targets.FirstOrDefault()?.Folder);
        if (itemFolder == null) return null;
        // Browse the item folder's parent so the item folder itself is one of the rows.
        return DAService.FindFolder(itemFolder.ParentFolderId);
    }

    private string TargetsLabel =>
        _targets.Count == 1 ? _targets[0].Name : $"{_targets.Count} items";

    /// <summary>Where the items live now — or how many folders they are spread over.</summary>
    private string CurrentFolderLabel
    {
        get
        {
            var folders = _targets
                .Select(t => DiceAudioService.IsRootFolder(t.Folder) ? "Root" : t.Folder.Name)
                .Distinct()
                .ToList();
            return folders.Count switch
            {
                0 => "Root",
                1 => folders[0],
                _ => $"{folders.Count} different folders",
            };
        }
    }

    private bool AllTargetsIn(DAVirtualAudioFolder? folder) =>
        _targets.Count > 0 && _targets.All(t =>
            folder == null
                ? DiceAudioService.IsRootFolder(t.Folder)
                : t.Folder?.Id == folder.Id);

    private async Task MoveTo(DAVirtualAudioFolder? folder)
    {
        if (_targets.Count == 0) return;
        foreach (var target in _targets)
            // Moving back to the root gives every item its own "." marker; any
            // other destination is the canonical folder object from the service.
            target.Folder = folder ?? DiceAudioService.NewRootFolderMarker();
        _movedCount = _targets.Count;
        _moved = true;
        await OnMoved.InvokeAsync();
    }

    private async Task OnFolderCreated(DAVirtualAudioFolder folder)
    {
        // The folder exists in the tree now even if nothing is moved into it.
        await DAService.SaveAudioVirtualFoldersAsync();
    }
}
