@page "/scenes"
@inject DiceAudioService DAService
@inject DABundleExportService Exports
@inject DAImportService Imports

<style>
    /* The card itself is .da-strip and the tile .da-icon, both from app.css:
       a scene, a scenario group and a pinned group on the home page are the
       same object in three places and now share one shape. What is left here
       is only this page's grid. */
    .scn-cat-header {
        font-size: 15px; font-weight: bold; color: var(--a3);
        border-bottom: 1px solid var(--b1);
        padding: 14px 4px 4px 4px; margin: 4px 8px;
    }
</style>

<h3>Scenes</h3>
<p class="da-sub" style="margin-bottom:14px;">
    Layered soundscapes — ambiences, music and sound effects driven by steps you trigger live.
    Scenes from this catalogue can be copied into scenarios.
</p>

<div class="da-irow da-irow-wrap" style="gap:10px; margin-bottom:10px;">
    <button type="button" class="da-btn da-btn-fill" @onclick="CreateScene">
        <DaIcon Name="add" Size="16" />
        New scene
    </button>

    @if (DAService.Scenes.Count > 0)
    {
        <button type="button" class="da-btn da-btn-out" @onclick="Exports.ExportAllScenes">
            <DaIcon Name="upload" Size="16" />
            @DiceAudio.Resources.Localization.Portability.ExportAllScenesBtn
        </button>
    }

    <button type="button" class="da-btn da-btn-out" @onclick="() => Imports.RequestImport(DiceAudio.Portability.DAImportOrigin.Scenes)">
        <DaIcon Name="upload-file" Size="16" />
        @DiceAudio.Resources.Localization.Portability.ImportFromFileBtn
    </button>

    @{ var scenePresets = DAService.Presets.Where(p => p.Kind == DAPresetKind.Scene).ToList(); }
    @if (scenePresets.Count > 0)
    {
        @* The house set has no menu widget, so the preset list is a button that
           reveals a .da-pop. The fixed sheet behind it keeps MudMenu's
           click-anywhere-to-dismiss, which a bare popover would lose. *@
        <div style="position:relative;">
            <button type="button" class="da-btn da-btn-out"
                    @onclick="() => _presetMenuOpen = !_presetMenuOpen">
                <DaIcon Name="bookmark" Size="16" />
                From preset
                <DaIcon Name="chevron-down" Size="16" />
            </button>
            @if (_presetMenuOpen)
            {
                <div style="position:fixed; inset:0; z-index:59;"
                     @onclick="() => _presetMenuOpen = false"></div>
                <div class="da-pop">
                    @foreach (var preset in scenePresets)
                    {
                        var p = preset;
                        <button type="button" class="da-btn da-btn-text"
                                style="width:100%; justify-content:flex-start;"
                                @onclick="() => InsertPreset(p)">
                            @(string.IsNullOrEmpty(p.Category) ? p.Name : $"{p.Category} / {p.Name}")
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@if (DAService.Scenes.Count == 0)
{
    <p style="color:grey; padding:20px;">No scenes yet. Create one to get started.</p>
}

@foreach (var group in DAService.Scenes
    .GroupBy(s => string.IsNullOrWhiteSpace(s.Category) ? "(uncategorized)" : s.Category)
    .OrderBy(g => g.Key))
{
    <div class="scn-cat-header">@group.Key</div>
    <div class="row">
        @foreach (var scene in group)
        {
            var s = scene;
            <div class="col col-md-5 da-strip" style="margin:10px;">
                <div class="da-icon">
                    <DaIcon Name="movie" Size="24" />
                </div>
                <div class="da-strip-body">
                    <div class="da-strip-name">@s.Name</div>
                    <div class="da-meta">@(s.Mode == DASceneMode.Contextual ? "Contextual" : "Linear") · @s.CueSummary</div>
                </div>
                <button type="button" class="da-ib" title="Edit scene" aria-label="Edit scene"
                        @onclick="() => EditScene(s)">
                    <DaIcon Name="edit" Size="18" />
                </button>
                <button type="button" class="da-ib" title="Duplicate" aria-label="Duplicate"
                        @onclick="() => DuplicateScene(s)">
                    <DaIcon Name="copy" Size="18" />
                </button>
                <button type="button" class="da-ib" title="Export" aria-label="Export"
                        @onclick="() => Exports.ExportScene(s)">
                    <DaIcon Name="upload" Size="18" />
                </button>
                <button type="button" class="da-ib da-danger" title="Delete" aria-label="Delete"
                        @onclick="() => DeleteScene(s)">
                    <DaIcon Name="delete" Size="18" />
                </button>
            </div>
        }
    </div>
}

<SceneEditor @ref="_editor" OnClose="OnEditorClosed" />

@code {
    private SceneEditor? _editor;

    /// Lets the home page start a scene rather than merely point at this
    /// page: /scenes?new=true opens the editor on a new scene as soon as the
    /// page is up. Guarded so a re-render cannot create a second one.
    [SupplyParameterFromQuery(Name = "new")] public bool StartNew { get; set; }

    private bool _startNewHandled;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || !StartNew || _startNewHandled) return;
        _startNewHandled = true;
        CreateScene();
        StateHasChanged();
    }

    /// Whether the "From preset" popover is showing.
    private bool _presetMenuOpen;

    void CreateScene()
    {
        var scene = new DAScene();
        DAService.Scenes.Add(scene);
        _editor?.Show(scene);
    }

    void EditScene(DAScene scene) => _editor?.Show(scene);

    async Task InsertPreset(DAPreset preset)
    {
        _presetMenuOpen = false;
        var scene = preset.ToScene();   // independent deep copy, fresh ids
        if (scene == null) return;
        DAService.Scenes.Add(scene);
        await DAService.SaveScenesAsync();
        StateHasChanged();
    }

    void DuplicateScene(DAScene scene)
    {
        // JSON round-trip via the preset payload gives a deep copy with fresh ids.
        var copy = DAPreset.FromScene(scene).ToScene();
        if (copy == null) return;
        copy.Name = scene.Name + " (copy)";
        DAService.Scenes.Add(copy);
        _ = DAService.SaveScenesAsync();
    }

    async Task DeleteScene(DAScene scene)
    {
        DAService.Scenes.Remove(scene);
        await DAService.SaveScenesAsync();
    }

    async Task OnEditorClosed()
    {
        await DAService.SaveScenesAsync();
        StateHasChanged();
    }
}
