@page "/audioexplorer"
@inject DiceAudioService DAService
@inject IDialogService DialogService
@inject PopupNotificationService Notifications

<style>
  /*  cards ---------------------------------------------------------- */
  .audio-item-top    { background-repeat:no-repeat; background-size:100%;
                       border-top-left-radius:10px;  border-top-right-radius:10px;
                       padding:10px; height:100px; margin:10px 10px 0 10px; }
  .audio-item-bottom { font-size:small; color:white; background:#040020;
                       border-bottom-left-radius:10px; border-bottom-right-radius:10px;
                       padding:10px; margin:0 10px 10px 10px; }
  .audio-item-tag    { color:black; background:#e73c7e; border:3px solid #040020;
                       border-radius:3px; padding:3px; margin-right:4px; }

  /*  breadcrumbs + nav buttons ------------------------------------ */
  .nav-bar     { display:flex; align-items:center; gap:8px; margin:14px 0; flex-wrap:wrap; }
  .crumb-link  { cursor:pointer; color:#90caf9; }
  .crumb-link:hover { text-decoration:underline; }
  .crumb-sep   { color:#888; }

  /*  tag filter ---------------------------------------------------- */
  .filter-bar  { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
                 background:#1b1b2b; border:1px solid #363660; border-radius:8px;
                 padding:6px 10px; margin-bottom:10px; }
  .filter-expr { color:#e2b6ff; font-weight:600; }
  /*  multi-selection ---------------------------------------------- */
  .audio-card-selected .audio-item-top,
  .audio-card-selected .audio-item-bottom { box-shadow: inset 0 0 0 3px #23a6d5; }
  .select-badge { position:absolute; top:6px; left:6px; background:rgba(0,0,0,0.5);
                  border-radius:50%; line-height:0; }
  .selection-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap;
                   background:#12233a; border:1px solid #23a6d5; border-radius:8px;
                   padding:6px 10px; margin-bottom:10px; }
  .selection-count { color:#8fd3ff; font-weight:600; }

  /*  folder an item was hoisted from while filtering across subfolders  */
  .hoisted-folder { display:inline-flex; align-items:center; gap:3px;
                    color:#8fa3b8; font-size:x-small; margin-top:2px; }
</style>

<!-- ─────────────────────  MODALS  ───────────────────── -->
<GenericModal TContent="AudioDownloader"  @ref="AudioDownloaderModalRef"  OnClose="HandleAudioDownloaderModalClose"><AudioDownloader /></GenericModal>
<GenericModal TContent="AudioTagsPicker"  @ref="AudioTagsPickerModalRef"  OnClose="HandleAudioTagsPickerModalClose"><AudioTagsPicker AudioItem="_currentAudioItemForTagsPicker" /></GenericModal>
<GenericModal TContent="MoveToFolder"     @ref="MoveToFolderModalRef"     OnClose="HandleMoveToFolderModalClose"><MoveToFolder AudioItem="_currentAudioItemForMoveToFolder" /></GenericModal>
<GenericModal TContent="AudioTagsEditor"  @ref="AudioTagsEditorModalRef"  OnClose="HandleAudioTagsEditorModalClose"><AudioTagsEditor /></GenericModal>
<GenericModal TContent="AudioFilterEditor" @ref="AudioFilterModalRef"    OnClose="HandleAudioFilterModalClose"><AudioFilterEditor Filter="_filter" MatchCount="CountFilterMatches" UpdateParent="StateHasChanged" /></GenericModal>
<GenericModal TContent="MoveToFolder"     @ref="MoveManyToFolderModalRef" OnClose="HandleMoveToFolderModalClose"><MoveToFolder AudioItems="_selectedItemsForMove" OnMoved="OnSelectionMoved" /></GenericModal>
<GenericModal TContent="MoveFolder"       @ref="MoveFolderModalRef"      OnClose="HandleMoveFolderModalClose"><MoveFolder Folder="_currentFolderForMove" /></GenericModal>
<AudioImporter @ref="_audioImporterRef" OnImported="OnImportFinished" />

<!-- ─────────────────────  TOOLBAR  ───────────────────── -->
<h3>Explorer</h3>
<MudStack Row="true" Style="gap:8px; flex-wrap:wrap; margin-bottom:10px;">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
               OnClick="@(() => AudioDownloaderModalRef.Show())">Audio downloader</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DriveFolderUpload"
               OnClick="@(() => _audioImporterRef?.Show())">Import from disk</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Label"
               OnClick="@(() => AudioTagsEditorModalRef.Show())">Add/Remove tags</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreateNewFolder"
               title="Create a subfolder of the folder you are in"
               OnClick="StartNewFolder">New folder</MudButton>
    <MudButton Variant="@(_filter.IsActive ? Variant.Filled : Variant.Outlined)"
               Color="@(_filter.IsActive ? Color.Secondary : Color.Primary)"
               StartIcon="@Icons.Material.Filled.FilterAlt"
               OnClick="@(() => AudioFilterModalRef?.Show())">Filter by tags</MudButton>
    <MudButton Variant="@(_selectionMode ? Variant.Filled : Variant.Outlined)"
               Color="@(_selectionMode ? Color.Info : Color.Primary)"
               StartIcon="@(_selectionMode ? Icons.Material.Filled.Close : Icons.Material.Filled.SelectAll)"
               title="Show a checkbox on every card and start with all of them selected, so you only have to untick what should stay behind"
               OnClick="ToggleSelectionMode">@(_selectionMode ? "Exit selection" : "Select multiple items")</MudButton>
</MudStack>

<!-- ─────────────────────  NEW FOLDER  ───────────────────── -->
@if (_creatingFolder)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Style="gap:8px; flex-wrap:wrap; margin-bottom:10px;">
        @* Immediate: Enter is handled here, and OnKeyUp fires before a
           blur-bound value would have reached _newFolderName. *@
        <MudTextField @bind-Value="_newFolderName" Variant="Variant.Filled" Margin="Margin.Dense"
                      Label="@($"New folder in {(IsRoot ? "Root" : _currentFolder.Name)}")"
                      Style="max-width:280px;" Immediate="true" OnKeyUp="OnNewFolderKeyUp" />
        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="ConfirmNewFolder">Create</MudButton>
        <MudButton Variant="Variant.Text" OnClick="CancelNewFolder">Cancel</MudButton>
        @if (_newFolderExists)
        {
            <MudText Color="Color.Error" Typo="Typo.caption">A folder with that name already exists.</MudText>
        }
    </MudStack>
}

<!-- ─────────────────────  SEARCH  ───────────────────── -->
<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged"
              Placeholder="Search all audio items by name…" Variant="Variant.Outlined" Margin="Margin.Dense"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true" DebounceInterval="300" Clearable="true" Style="max-width:420px; margin-bottom:10px;" />

<!-- ─────────────────────  KIND FILTER  ───────────────────── -->
<MudStack Row="true" Style="gap:6px; margin-bottom:10px;">
    <MudButton Variant="@(_kindFilter == null ? Variant.Filled : Variant.Outlined)"
               Color="Color.Default" Size="Size.Small"
               OnClick="() => _kindFilter = null">All</MudButton>
    @foreach (var kind in new[] { AudioKind.Music, AudioKind.Ambiance, AudioKind.SoundEffect })
    {
        var k = kind;
        <MudButton Variant="@(_kindFilter == k ? Variant.Filled : Variant.Outlined)"
                   Color="@k.Color()" Size="Size.Small"
                   StartIcon="@k.Icon()"
                   OnClick="() => _kindFilter = k">@k.Label()</MudButton>
    }
</MudStack>

<!-- ─────────────────────  SELECTION  ───────────────────── -->
@{ var shownItems = GetFilteredItems().ToList(); }
@if (_selectionMode)
{
    <div class="selection-bar">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="color:#23a6d5;" />
        <span class="selection-count">@_selectedIds.Count selected</span>
        @{ var offScreen = _selectedIds.Count - shownItems.Count(i => _selectedIds.Contains(i.Id)); }
        @if (offScreen > 0)
        {
            <span style="color:grey; font-size:13px;">(@offScreen not shown here)</span>
        }
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DriveFileMove"
                   Disabled="@(_selectedIds.Count == 0)"
                   OnClick="OpenBulkMove">Move to folder…</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Deselect"
                   OnClick="ClearSelection">Clear selection</MudButton>
    </div>
}

<!-- ─────────────────────  ACTIVE TAG FILTER  ───────────────────── -->
@if (_filter.IsActive)
{
    <div class="filter-bar">
        <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Style="color:#e2b6ff;" />
        <span style="color:grey;">Showing items matching</span>
        <span class="filter-expr">@_filter.Describe()</span>
        <span style="color:grey;">
            @(!string.IsNullOrWhiteSpace(_search)
                ? "across all folders (search is on)"
                : _filter.IncludeSubfolders ? "in this folder and its subfolders" : "in this folder only")
        </span>
        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="@(() => AudioFilterModalRef?.Show())">Edit</MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Close" OnClick="ClearFilter">Clear</MudButton>
    </div>
}

<!-- ────────────────────  NAV + BREADCRUMBS ─────────────────── -->
@if (!string.IsNullOrWhiteSpace(_search))
{
    <div class="nav-bar">
        <MudIcon Icon="@Icons.Material.Filled.Search" Style="color:#90caf9;" />
        <span style="color:#90caf9;">Search results for "<b>@_search</b>" across all folders</span>
    </div>
}
else if (_breadcrumb.Any())
{
    <div class="nav-bar">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                        Color="Color.Primary"
                        Disabled="!CanGoBack"
                        OnClick="GoBack" Size="Size.Medium" />
        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                        Color="Color.Primary"
                        Disabled="!CanGoForward"
                        OnClick="GoForward" Size="Size.Medium" />

        @for (var i = 0; i < _breadcrumb.Count; i++)
        {
            var crumb = _breadcrumb[i];
            bool isLast   = i == _breadcrumb.Count - 1;

            if (!isLast)
            {
                <span class="crumb-link" @onclick="@(() => NavigateToFolder(crumb))">
                    @(crumb == _rootFolder ? "Root" : crumb.Name)
                </span>
                <span class="crumb-sep">/</span>
            }
            else
            {
                <span>@(crumb == _rootFolder ? "Root" : crumb.Name)</span>
            }
        }
    </div>
}


<!-- ─────────────────────  MAIN GRID  ───────────────────── -->
<div class="row">
    @if (string.IsNullOrWhiteSpace(_search))
    {
        @foreach (var folder in (IsRoot ? _folderTree : _currentFolder.VirtualAudioSubFolders))
        {
            @RenderFolderCard(folder)
        }
    }

    @{
        var matches = shownItems;
        var shown = matches.Count > MaxRenderedItems ? matches.Take(MaxRenderedItems).ToList() : matches;
    }
    @foreach (var item in shown)
    {
        <div class="col col-md-3 @(_selectionMode && IsSelected(item) ? "audio-card-selected" : "")">
            <div class="audio-item-top"
                    @onclick="@(() => { if (_selectionMode) ToggleSelected(item); })"
                    title="@(_selectionMode ? "Click to select this item" : null)"
                    style="background-image:linear-gradient(-45deg,rgba(238,119,82,.2),rgba(231,60,126,.6),
                                                        rgba(35,166,213,.9),rgba(35,166,171,1));
                           position:relative; @(_selectionMode ? "cursor:pointer;" : "")">
                @* Selection box top-left, only while selecting — the header toggles it too *@
                @if (_selectionMode)
                {
                    <div class="select-badge" title="Select this item"
                         @onclick="@(() => { })" @onclick:stopPropagation="true">
                        <MudCheckBox T="bool" Value="@IsSelected(item)"
                                     ValueChanged="@((bool v) => SetSelected(item, v))"
                                     Color="Color.Info" Size="Size.Small" Dense="true" />
                    </div>
                }
                @* Kind badge top-right — click cycles Music → Ambiance → SFX *@
                <div style="position:absolute; top:6px; right:6px;"
                     @onclick="@(() => { })" @onclick:stopPropagation="true">
                    <MudIconButton Icon="@item.Kind.Icon()"
                                   Color="@item.Kind.Color()"
                                   Size="Size.Small"
                                   Title="@($"{item.Kind.Label()} — click to change kind")"
                                   OnClick="@(() => ToggleKind(item))"
                                   Style="background:rgba(0,0,0,0.5); border-radius:50%;" />
                </div>
            </div>
            <div class="audio-item-bottom">
                <b>@item.Name</b>
                @if (ShowsHoistedItems && item.Folder.Name != _currentFolder.Name)
                {
                    <div class="hoisted-folder">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />@item.Folder.Name
                    </div>
                }
                <MudStack Row="true" Style="padding:5px; flex-wrap:wrap;">
                    @foreach (var tag in item.Tags)
                    { <MudItem><span class="audio-item-tag">@tag.Name</span></MudItem> }
                </MudStack>
                <MudStack Row="true" Style="flex-wrap:wrap;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tag"
                                OnClick="@(() => OpenAudioTagsPicker(item))">Edit tags</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Folder"
                                OnClick="@(() => OpenMoveToFolderPicker(item))">Move</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                OnClick="@(() => DeleteAudioItem(item))">Delete</MudButton>
                </MudStack>
                @if (item.IsLocallyAvailable)
                {
                    <MusicPlayer AudioItem="@item"></MusicPlayer>
                }
                else
                {
                    <div style="color:grey; font-size:x-small; padding:4px 0;">Not downloaded yet</div>
                }
            </div>
        </div>
    }
</div>

@if (matches.Count > shown.Count)
{
    <MudText Typo="Typo.body2" Style="color:#f0a03c; margin:8px 2px;">
        Showing the first @shown.Count of @matches.Count items — narrow down with the search box, the kind filter or the tag filter to see the rest.
    </MudText>
}

@code {
    // modal refs
    private GenericModal<AudioDownloader>? AudioDownloaderModalRef;
    private GenericModal<AudioTagsPicker>?  AudioTagsPickerModalRef;
    private GenericModal<AudioTagsEditor>?  AudioTagsEditorModalRef;
    private GenericModal<MoveToFolder>?     MoveToFolderModalRef;
    private GenericModal<AudioFilterEditor>? AudioFilterModalRef;
    private GenericModal<MoveToFolder>?     MoveManyToFolderModalRef;
    private GenericModal<MoveFolder>?       MoveFolderModalRef;

    // tree + navigation state
    private readonly DAVirtualAudioFolder _rootFolder = new() { Name = "." };
    private DAVirtualAudioFolder _currentFolder = default!;
    private List<DAVirtualAudioFolder> _folderTree = new();
    private List<DAVirtualAudioFolder> _breadcrumb = new();

    private List<DAVirtualAudioFolder> _history = new();
    private int _historyIndex = -1;

    private bool IsRoot => _currentFolder == _rootFolder || _currentFolder.Name == ".";

    private bool CanGoBack    => _historyIndex > 0;
    private bool CanGoForward => _historyIndex < _history.Count - 1;

    protected override void OnInitialized()
    {
        BuildFolderTree();
        // initialize navigation at root
        _currentFolder = _rootFolder;
        _history.Clear();
        _historyIndex = -1;
        NavigateToFolder(_rootFolder);
    }

    void BuildFolderTree()
    {
        // Derive missing virtual folders from item metadata (handles empty audioVirtualFolders.json).
        // Always create a NEW object so the canonical folder in AudioVirtualFolders is never
        // aliased with an item's embedded Folder property (which would cause mutations via
        // MoveToFolder to corrupt the canonical folder name).
        foreach (var item in DAService.AudioItems)
        {
            if (item.Folder != null && item.Folder.Name != "." &&
                DAService.AudioVirtualFolders.FindIndex(x => x.Name == item.Folder.Name) == -1)
            {
                DAService.AudioVirtualFolders.Add(new DAVirtualAudioFolder(item.Folder.Name)
                {
                    ParentFolderId = item.Folder.ParentFolderId
                });
            }
        }

        // Deduplicate by name then by ID — heals corrupted data that has same name or same ID
        // appearing multiple times (e.g. from a previous broken run).
        var seenNames = new HashSet<string>();
        var seenIds   = new HashSet<Guid>();
        var deduped = DAService.AudioVirtualFolders
            .Where(f => seenNames.Add(f.Name) && seenIds.Add(f.Id))
            .ToList();
        DAService.AudioVirtualFolders.Clear();
        DAService.AudioVirtualFolders.AddRange(deduped);

        var map = DAService.AudioVirtualFolders.ToDictionary(f => f.Id);
        _folderTree.Clear();

        foreach (var f in map.Values)
        {
            f.VirtualAudioSubFolders.Clear();
            if (f.ParentFolderId != Guid.Empty && map.TryGetValue(f.ParentFolderId, out var p))
                p.VirtualAudioSubFolders.Add(f);
            else
                _folderTree.Add(f);
        }
    }

    void NavigateToFolder(DAVirtualAudioFolder folder)
    {
        // manage history
        if (_historyIndex < 0 || _history[_historyIndex] != folder)
        {
            // drop forward entries
            if (_historyIndex < _history.Count - 1)
                _history.RemoveRange(_historyIndex + 1, _history.Count - _historyIndex - 1);

            _history.Add(folder);
            _historyIndex = _history.Count - 1;
        }

        _currentFolder = folder;
        UpdateBreadcrumb();
    }

    void GoBack()
    {
        if (!CanGoBack) return;
        _historyIndex--;
        _currentFolder = _history[_historyIndex];
        UpdateBreadcrumb();
    }

    void GoForward()
    {
        if (!CanGoForward) return;
        _historyIndex++;
        _currentFolder = _history[_historyIndex];
        UpdateBreadcrumb();
    }

    void UpdateBreadcrumb()
    {
        _breadcrumb.Clear();
        var ptr = _currentFolder;
        while (ptr != null)
        {
            _breadcrumb.Insert(0, ptr);
            if (ptr == _rootFolder) break;
            ptr = ptr.ParentFolderId == Guid.Empty
                  ? _rootFolder
                  : DAService.AudioVirtualFolders.FirstOrDefault(f => f.Id == ptr.ParentFolderId);
        }
    }

    RenderFragment RenderFolderCard(DAVirtualAudioFolder folder) => __builder =>
    {
        <div class="col col-md-3" style="cursor:pointer;">
            <div class="audio-item-top" @onclick="@(() => NavigateToFolder(folder))"
                 style="background-image:linear-gradient(-45deg,rgba(238,119,82,.2),rgba(231,60,126,.6),
                                                        rgba(35,166,213,.9),rgba(35,166,171,1));">
                <div style="font-size:60px; text-align:center;">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" />
                </div>
            </div>
            <div class="audio-item-bottom">
                @if (_renamingFolder == folder)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudTextField Value="@_renameValue"
                                      ValueChanged="@((string v) => _renameValue = v)"
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"
                                      Style="flex:1;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Check"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="ConfirmRename" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="CancelRename" />
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <b style="flex:1; cursor:pointer;" @onclick="@(() => NavigateToFolder(folder))">@folder.Name</b>
                        <MudIconButton Icon="@Icons.Material.Filled.DriveFileMove"
                                       Size="Size.Small"
                                       Title="Move folder"
                                       OnClick="@(() => OpenMoveFolder(folder))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Title="Rename folder"
                                       OnClick="@(() => StartRename(folder))" />
                    </MudStack>
                }
            </div>
        </div>;
    };

    // modal helpers
    void OpenAudioTagsPicker(DAAudioItem item) { _currentAudioItemForTagsPicker = item;  AudioTagsPickerModalRef?.Show(); }
    void OpenMoveToFolderPicker(DAAudioItem item){ _currentAudioItemForMoveToFolder = item; MoveToFolderModalRef?.Show(); }
    void OpenMoveFolder(DAVirtualAudioFolder folder){ _currentFolderForMove = folder; MoveFolderModalRef?.Show(); }

    private DAVirtualAudioFolder? _currentFolderForMove;

    // modal callbacks
    private AudioImporter? _audioImporterRef;

    void OnImportFinished()
    {
        BuildFolderTree();       // imported folders must appear in the tree
        StateHasChanged();
    }

    async Task HandleAudioDownloaderModalClose(bool _)
    {
        // A download may have added items and created a folder; make the tree
        // reflect them (the downloader already persisted the changes).
        BuildFolderTree();
        await InvokeAsync(StateHasChanged);
    }

    void HandleAudioTagsPickerModalClose(bool _) { }

    async Task HandleMoveToFolderModalClose(bool _)
    {
        // Persist the new folder assignment (and any folder created in the
        // picker) so a move survives an app restart.
        await DAService.SaveAudioItemListAsync();
        await DAService.SaveAudioVirtualFoldersAsync();
        BuildFolderTree();
        await InvokeAsync(StateHasChanged);
    }
    async Task HandleMoveFolderModalClose(bool _)
    {
        // Both the tree and the items' own copy of their folder changed.
        await DAService.SaveAudioVirtualFoldersAsync();
        await DAService.SaveAudioItemListAsync();
        BuildFolderTree();
        await InvokeAsync(StateHasChanged);
    }

    void HandleAudioTagsEditorModalClose(bool saved) { if (saved) DAAudioTagsProvider.Instance.SaveTags(); }

    void HandleAudioFilterModalClose(bool _) => StateHasChanged();   // view state only, nothing to persist

    // ── folder creation (in the folder currently open) ─────────────
    private bool _creatingFolder;
    private string _newFolderName = string.Empty;
    private bool _newFolderExists;

    void StartNewFolder()
    {
        _creatingFolder = true;
        _newFolderName = string.Empty;
        _newFolderExists = false;
    }

    void CancelNewFolder()
    {
        _creatingFolder = false;
        _newFolderName = string.Empty;
        _newFolderExists = false;
    }

    async Task OnNewFolderKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmNewFolder();
    }

    async Task ConfirmNewFolder()
    {
        var created = DAService.CreateFolder(_newFolderName, IsRoot ? null : _currentFolder);
        if (created == null)
        {
            // Empty names are simply ignored; a clash is worth saying out loud.
            _newFolderExists = !string.IsNullOrWhiteSpace(_newFolderName);
            return;
        }

        CancelNewFolder();
        await DAService.SaveAudioVirtualFoldersAsync();
        BuildFolderTree();
        StateHasChanged();
    }

    // folder rename state
    private DAVirtualAudioFolder? _renamingFolder = null;
    private string _renameValue = string.Empty;

    void StartRename(DAVirtualAudioFolder folder)
    {
        _renamingFolder = folder;
        _renameValue = folder.Name;
    }

    void ConfirmRename()
    {
        if (_renamingFolder == null) { CancelRename(); return; }
        var newName = _renameValue.Trim();
        if (string.IsNullOrWhiteSpace(newName) || newName == _renamingFolder.Name) { CancelRename(); return; }
        var oldName = _renamingFolder.Name;
        _renamingFolder.Name = newName;
        // also update the embedded Folder.Name on items loaded from JSON (which have their own Folder copy)
        foreach (var item in DAService.AudioItems.Where(i => i.Folder.Name == oldName))
            item.Folder.Name = newName;
        _renamingFolder = null;
        _renameValue = string.Empty;
        BuildFolderTree();
    }

    void CancelRename()
    {
        _renamingFolder = null;
        _renameValue = string.Empty;
    }

    // kind filter + text search
    private AudioKind? _kindFilter = null;
    private string _search = "";

    // Cap how many cards are rendered at once. Each card mounts a MusicPlayer, so
    // rendering an unbounded result set froze the UI on large libraries.
    private const int MaxRenderedItems = 200;

    void OnSearchChanged(string value)
    {
        _search = value ?? "";
        StateHasChanged();
    }

    // ── multi-selection ─────────────────────────────────────────────
    // Selection is kept by id and survives navigation and filtering on purpose:
    // it lets you gather items from several folders and move them in one go.
    private readonly HashSet<Guid> _selectedIds = new();
    private List<DAAudioItem> _selectedItemsForMove = new();

    // Checkboxes only exist while selecting, so a card stays a card the rest of
    // the time.
    private bool _selectionMode;

    bool IsSelected(DAAudioItem item) => _selectedIds.Contains(item.Id);

    void SetSelected(DAAudioItem item, bool selected)
    {
        if (selected) _selectedIds.Add(item.Id);
        else _selectedIds.Remove(item.Id);
    }

    void ToggleSelected(DAAudioItem item) => SetSelected(item, !IsSelected(item));

    void ToggleSelectionMode()
    {
        if (_selectionMode) { ExitSelectionMode(); return; }

        // Entering selects everything the folder, search, kind and tag filters
        // currently leave: narrowing first, then unticking a few, beats ticking
        // items one by one. (This covers matches past the render cap as well.)
        _selectionMode = true;
        _selectedIds.Clear();
        foreach (var item in GetFilteredItems()) _selectedIds.Add(item.Id);
        StateHasChanged();
    }

    void ExitSelectionMode()
    {
        _selectionMode = false;
        _selectedIds.Clear();
        StateHasChanged();
    }

    /// <summary>Unticks everything but stays in the mode, to pick a few by hand.</summary>
    void ClearSelection()
    {
        _selectedIds.Clear();
        StateHasChanged();
    }

    void OpenBulkMove()
    {
        _selectedItemsForMove = DAService.AudioItems.Where(i => _selectedIds.Contains(i.Id)).ToList();
        if (_selectedItemsForMove.Count == 0) return;
        MoveManyToFolderModalRef?.Show();
    }

    /// <summary>The bulk dialog moved the items: the selection has served its purpose.</summary>
    void OnSelectionMoved()
    {
        _selectionMode = false;
        _selectedIds.Clear();
        StateHasChanged();
    }

    // tag filter (view state, not persisted)
    private readonly DAAudioFilter _filter = new();

    /// <summary>
    /// True while matches from the sub-folders are shown next to the current
    /// folder's own items: the filter is on, set to reach into sub-folders, and
    /// the global search is not already flattening everything.
    /// </summary>
    private bool ShowsHoistedItems =>
        _filter.IsActive && _filter.IncludeSubfolders && string.IsNullOrWhiteSpace(_search);

    void ClearFilter()
    {
        _filter.Criterias.Clear();
        StateHasChanged();
    }

    /// <summary>The current folder plus, when the filter asks for it, every folder below it.</summary>
    HashSet<string> CurrentScopeFolderNames()
    {
        var names = new HashSet<string> { _currentFolder.Name };
        if (!_filter.IncludeSubfolders) return names;

        // At the root the whole tree is below us; deeper, only the current branch.
        foreach (var folder in IsRoot ? _folderTree : _currentFolder.VirtualAudioSubFolders)
            AddBranch(folder, names);
        return names;

        static void AddBranch(DAVirtualAudioFolder folder, HashSet<string> acc)
        {
            acc.Add(folder.Name);
            foreach (var sub in folder.VirtualAudioSubFolders) AddBranch(sub, acc);
        }
    }

    /// <summary>Live match count for the filter modal, over the scope it targets.</summary>
    int CountFilterMatches()
    {
        var scope = CurrentScopeFolderNames();
        return _filter.Apply(DAService.AudioItems.Where(ai => scope.Contains(ai.Folder.Name))).Count();
    }

    IEnumerable<DAAudioItem> GetFilteredItems()
    {
        IEnumerable<DAAudioItem> items = DAService.AudioItems;

        if (!string.IsNullOrWhiteSpace(_search))
            // Search is global across every folder; folder view is bypassed.
            items = items.Where(ai => ai.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        else if (ShowsHoistedItems)
        {
            // Filtering across sub-folders: every match below the current folder
            // is temporarily hoisted to this level (each card says where it lives).
            var scope = CurrentScopeFolderNames();
            items = items.Where(ai => scope.Contains(ai.Folder.Name));
        }
        else
            items = items.Where(ai => ai.Folder.Name == _currentFolder.Name);

        if (_kindFilter is AudioKind k) items = items.Where(ai => ai.Kind == k);
        if (_filter.IsActive) items = _filter.Apply(items);
        return items;
    }

    async Task DeleteAudioItem(DAAudioItem item)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Delete audio item",
            $"Delete \"{item.Name}\" from the library? The downloaded file is also removed from disk.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirm != true) return;

        DAService.AudioItems.Remove(item);
        _selectedIds.Remove(item.Id);

        // Remove the underlying file only if no other item still references it.
        if (!string.IsNullOrEmpty(item.LocalFileName) &&
            !DAService.AudioItems.Any(a => string.Equals(a.LocalFileName, item.LocalFileName, StringComparison.OrdinalIgnoreCase)))
        {
            if (!TryDeleteAudioFile(item.LocalFileName))
                Notifications.Show(
                    "File not deleted",
                    $"\"{item.Name}\" was removed from the library, but \"{item.LocalFileName}\" " +
                    "could not be deleted from disk. It is still taking up space.",
                    PopupNotificationService.Type.FAILURE, 6000);
        }

        await DAService.SaveAudioItemListAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Deletes the file backing a removed library item. Any player still reading
    /// it is torn down first: a loaded file is locked, so the delete would
    /// otherwise throw and leave the file orphaned on disk with nothing in the
    /// library referencing it. Returns false if the file survived.
    /// </summary>
    static bool TryDeleteAudioFile(string localFileName)
    {
        var path = Path.Combine(FileSystem.AppDataDirectory, "Audio", localFileName);

        DAAudioPlayer.DisposePlayersFor(path);

        try
        {
            if (File.Exists(path)) File.Delete(path);
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Delete audio file failed: {ex.Message}");
            return false;
        }

        // Leftover from the builds that played from a copy under CacheDirectory.
        // Kept so existing installs shed those duplicates as items are deleted.
        try
        {
            var legacyCopy = Path.Combine(FileSystem.CacheDirectory, localFileName);
            if (File.Exists(legacyCopy)) File.Delete(legacyCopy);
        }
        catch (Exception ex) { Debug.WriteLine($"Legacy cache cleanup failed: {ex.Message}"); }

        return true;
    }

    void ToggleKind(DAAudioItem item)
    {
        // Cycle Music → Ambiance → SoundEffect → Music
        item.Kind = item.Kind switch
        {
            AudioKind.Music => AudioKind.Ambiance,
            AudioKind.Ambiance => AudioKind.SoundEffect,
            _ => AudioKind.Music,
        };
    }

    // misc
    private DAAudioItem _currentAudioItemForTagsPicker = default!;
    private DAAudioItem _currentAudioItemForMoveToFolder = default!;
}
